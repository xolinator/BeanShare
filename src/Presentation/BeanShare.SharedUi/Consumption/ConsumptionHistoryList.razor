@using BeanShare.Application.Features.Consumption.Dtos

<div class="consumption-history">
    @if (History == null)
    {
        <div class="text-center p-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!History.Items.Any())
    {
        <div class="text-center p-5">
            <i class="bi bi-cup-hot fs-1 text-muted"></i>
            <h4 class="mt-3">No consumption history</h4>
            <p class="text-muted">Start logging your coffee consumption to see your history here.</p>
        </div>
    }
    else
    {
        <div class="history-timeline">
            @{
                var groupedByDate = History.Items
                    .GroupBy(i => i.ConsumedAt.Date)
                    .OrderByDescending(g => g.Key);
            }

            @foreach (var dateGroup in groupedByDate)
            {
                <div class="date-group">
                    <div class="date-header">
                        <span class="date-label">
                            @if (dateGroup.Key.Date == DateTime.Today)
                            {
                                <text>Today</text>
                            }
                            else if (dateGroup.Key.Date == DateTime.Today.AddDays(-1))
                            {
                                <text>Yesterday</text>
                            }
                            else
                            {
                                @dateGroup.Key.ToString("dddd, MMMM d")
                            }
                        </span>
                        <span class="date-count">@dateGroup.Count() @(dateGroup.Count() == 1 ? "cup" : "cups")</span>
                    </div>

                    <div class="timeline-items">
                        @foreach (var item in dateGroup.OrderByDescending(i => i.ConsumedAt))
                        {
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <div class="item-header">
                                        <span class="item-time">@item.ConsumedAt.ToString("HH:mm")</span>
                                        <span class="item-space badge bg-secondary">@item.SpaceName</span>
                                    </div>
                                    <div class="item-details">
                                        <strong>@item.ProductName</strong>
                                        <span class="text-muted">by @item.ProductBrand</span>
                                    </div>
                                    <div class="item-metrics">
                                        <span class="metric">
                                            <i class="bi bi-droplet-half"></i> @item.QuantityGrams.ToString("F0")g
                                        </span>
                                        <span class="metric">
                                            <span class="badge bg-info">@item.ProductType</span>
                                        </span>
                                        @if (item.EstimatedCost.HasValue)
                                        {
                                            <span class="metric text-success">
                                                <i class="bi bi-cash"></i> @item.Currency @item.EstimatedCost.Value.ToString("F2")
                                            </span>
                                        }
                                    </div>
                                    @if (item.BillingPeriodId.HasValue)
                                    {
                                        <div class="item-billing">
                                            <small class="text-muted">
                                                <i class="bi bi-calendar-check"></i>
                                                @(item.BillingPeriodName ?? "Billing Period")
                                            </small>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (History.TotalCount > History.PageSize)
        {
            <nav aria-label="History pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(History.PageNumber == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => OnPageChange.InvokeAsync(History.PageNumber - 1)"
                                disabled="@(History.PageNumber == 1)">
                            Previous
                        </button>
                    </li>

                    @{
                        var totalPages = (int)Math.Ceiling(History.TotalCount / (double)History.PageSize);
                        for (int i = 1; i <= Math.Min(totalPages, 5); i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(History.PageNumber == pageNum ? "active" : "")">
                                <button class="page-link" @onclick="() => OnPageChange.InvokeAsync(pageNum)">
                                    @pageNum
                                </button>
                            </li>
                        }
                    }

                    <li class="page-item @(History.PageNumber * History.PageSize >= History.TotalCount ? "disabled" : "")">
                        <button class="page-link" @onclick="() => OnPageChange.InvokeAsync(History.PageNumber + 1)"
                                disabled="@(History.PageNumber * History.PageSize >= History.TotalCount)">
                            Next
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@code {
    [Parameter] public ConsumptionHistoryDto? History { get; set; }
    [Parameter] public EventCallback<int> OnPageChange { get; set; }
}