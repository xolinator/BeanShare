<div class="bs-flex bs-items-center bs-justify-center" style="padding: 2rem;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    @if (!string.IsNullOrEmpty(Message))
    {
        <span style="margin-left: 0.75rem; color: var(--bs-text-subtle);">@Message</span>
    }
</div>

@code {
    [Parameter]
    public string? Message { get; set; }
}
