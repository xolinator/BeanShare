@if (IsVisible)
{
    <div class="bs-modal-backdrop" @onclick="OnCancel">
        <div class="bs-modal" @onclick:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">@Title</h3>
            </div>
            <div>
                <p>@Message</p>
            </div>
            <div class="bs-modal-footer">
                <button class="bs-btn bs-btn-secondary bs-flex-1" @onclick="OnCancel">
                    Cancel
                </button>
                <button class="bs-btn @(IsDestructive ? "bs-btn-error" : "bs-btn-primary") bs-flex-1"
                        @onclick="OnConfirmClick"
                        disabled="@IsProcessing">
                    @(IsProcessing ? "Processing..." : ConfirmText)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirm Action";

    [Parameter]
    public string Message { get; set; } = "Are you sure?";

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    [Parameter]
    public bool IsDestructive { get; set; }

    [Parameter]
    public bool IsProcessing { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task OnConfirmClick()
    {
        await OnConfirm.InvokeAsync();
    }
}
