<div class="bs-empty-state">
    <div class="bs-empty-state-icon">
        <span class="material-symbols-outlined" style="font-size: inherit;">@Icon</span>
    </div>
    <h3 class="bs-empty-state-title">@Title</h3>
    <p class="bs-empty-state-text">@Message</p>
    @if (!string.IsNullOrEmpty(ActionText))
    {
        <button class="bs-btn bs-btn-primary bs-mt-4" @onclick="OnAction">
            <span class="material-symbols-outlined">@ActionIcon</span>
            @ActionText
        </button>
    }
</div>

@code {
    [Parameter]
    public string Icon { get; set; } = "inbox";

    [Parameter]
    public string Title { get; set; } = "No items";

    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public string ActionText { get; set; } = "";

    [Parameter]
    public string ActionIcon { get; set; } = "add";

    [Parameter]
    public EventCallback OnAction { get; set; }
}
