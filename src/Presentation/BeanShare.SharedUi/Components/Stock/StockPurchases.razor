<div>
    <div class="stock-stats-grid">
        <div class="bs-card">
            <p class="bs-text-subtle stock-stat-label">Total Purchases</p>
            <p class="bs-font-bold stock-stat-value">@TotalPurchases</p>
        </div>
        <div class="bs-card">
            <p class="bs-text-subtle stock-stat-label">Total Grams</p>
            <p class="bs-font-bold stock-stat-value">@TotalGrams g</p>
        </div>
        <div class="bs-card">
            <p class="bs-text-subtle stock-stat-label">Total Cost</p>
            <p class="bs-font-bold stock-stat-value">@FormatCurrency(TotalCost)</p>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="bs-flex bs-flex-col bs-gap-4">
            @for (int i = 0; i < 3; i++)
            {
                <div class="bs-card">
                    <div class="bs-skeleton" style="height: 1.25rem; width: 60%; margin-bottom: 0.5rem;"></div>
                    <div class="bs-skeleton" style="height: 0.875rem; width: 30%;"></div>
                </div>
            }
        </div>
    }
    else if (Purchases == null || !Purchases.Any())
    {
        <EmptyState Icon="shopping_bag"
                    Title="No purchases yet"
                    Message="Add your first coffee stock purchase to start tracking." />
    }
    else
    {
        <div class="bs-flex bs-items-center bs-justify-between bs-mb-4">
            <h2 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Purchases</h2>
            @if (TotalPurchaseCount > 0)
            {
                <span class="bs-text-subtle" style="font-size: 0.875rem;">Showing @Purchases.Count() of @TotalPurchaseCount</span>
            }
        </div>
        <div class="bs-flex bs-flex-col bs-gap-4">
            @foreach (var purchase in Purchases)
            {
                <PurchaseRow PurchaseId="@purchase.Id"
                            ProductName="@purchase.ProductName"
                            ProductBrand="@purchase.ProductBrand"
                            TotalCost="@purchase.TotalCost"
                            CurrencyCode="@purchase.CostCurrency"
                            QuantityGrams="@((int)purchase.QuantityGrams)"
                            CoffeeType="@purchase.CoffeeType"
                            PurchasedAt="@purchase.PurchasedAt"
                            PurchasedByName="@purchase.PurchasedByName"
                            OnEdit="OnEditPurchase"
                            OnDelete="OnDeletePurchase"
                            OnClone="OnClonePurchase" />
            }
        </div>
        @if (HasMorePurchases)
        {
            <div style="text-align: center; margin-top: 1rem;">
                <button class="bs-btn bs-btn-secondary" @onclick="HandleLoadMore" disabled="@IsLoadingMore">
                    @if (IsLoadingMore)
                    {
                        <span>Loading...</span>
                    }
                    else
                    {
                        <span>Load more</span>
                    }
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public IEnumerable<StockPurchaseDto>? Purchases { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string CurrencyCode { get; set; } = "USD";

    [Parameter]
    public EventCallback<PurchaseRow.PurchaseEditModel> OnEditPurchase { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDeletePurchase { get; set; }

    [Parameter]
    public EventCallback<PurchaseRow.PurchaseCloneModel> OnClonePurchase { get; set; }

    [Parameter]
    public int TotalPurchaseCount { get; set; }

    [Parameter]
    public decimal TotalStockGrams { get; set; }

    [Parameter]
    public decimal TotalInvestmentAmount { get; set; }

    [Parameter]
    public bool IsLoadingMore { get; set; }

    [Parameter]
    public EventCallback OnLoadMore { get; set; }

    private bool HasMorePurchases => Purchases != null && TotalPurchaseCount > Purchases.Count();

    private async Task HandleLoadMore()
    {
        await OnLoadMore.InvokeAsync();
    }

    private int TotalPurchases => TotalPurchaseCount;
    private int TotalGrams => (int)TotalStockGrams;
    private decimal TotalCost => TotalInvestmentAmount;

    private string FormatCurrency(decimal amount)
    {
        try
        {
            var currency = BeanShare.Domain.ValueObjects.Currency.Create(CurrencyCode);
            return currency.FormatAmount(amount);
        }
        catch
        {
            return $"{amount:N2}";
        }
    }
}
