<div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
        <div class="bs-card">
            <p class="bs-text-subtle" style="margin: 0; font-size: 0.875rem; font-weight: 500;">Total Purchases</p>
            <p class="bs-font-bold" style="margin: 0.25rem 0 0 0; font-size: 1.5rem;">@TotalPurchases</p>
        </div>
        <div class="bs-card">
            <p class="bs-text-subtle" style="margin: 0; font-size: 0.875rem; font-weight: 500;">Total Grams</p>
            <p class="bs-font-bold" style="margin: 0.25rem 0 0 0; font-size: 1.5rem;">@TotalGrams g</p>
        </div>
        <div class="bs-card">
            <p class="bs-text-subtle" style="margin: 0; font-size: 0.875rem; font-weight: 500;">Total Cost</p>
            <p class="bs-font-bold" style="margin: 0.25rem 0 0 0; font-size: 1.5rem;">@TotalCost.ToString("C")</p>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="bs-flex bs-flex-col bs-gap-4">
            @for (int i = 0; i < 3; i++)
            {
                <div class="bs-card">
                    <div class="bs-skeleton" style="height: 1.25rem; width: 60%; margin-bottom: 0.5rem;"></div>
                    <div class="bs-skeleton" style="height: 0.875rem; width: 30%;"></div>
                </div>
            }
        </div>
    }
    else if (Purchases == null || !Purchases.Any())
    {
        <EmptyState Icon="shopping_bag"
                    Title="No purchases yet"
                    Message="Add your first coffee stock purchase to start tracking." />
    }
    else
    {
        <div class="bs-flex bs-items-center bs-justify-between bs-mb-4">
            <h2 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Purchases</h2>
        </div>
        <div class="bs-flex bs-flex-col bs-gap-4">
            @foreach (var purchase in Purchases)
            {
                <PurchaseRow ProductName="@purchase.ProductName"
                            TotalCost="@purchase.TotalCost"
                            QuantityGrams="@((int)purchase.QuantityGrams)"
                            CoffeeType="@purchase.CoffeeType"
                            PurchasedAt="@purchase.PurchasedAt"
                            PurchasedByName="@purchase.PurchasedByName" />
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<StockPurchaseDto>? Purchases { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    private int TotalPurchases => Purchases?.Count() ?? 0;
    private int TotalGrams => (int)(Purchases?.Sum(p => p.QuantityGrams) ?? 0);
    private decimal TotalCost => Purchases?.Sum(p => p.TotalCost) ?? 0m;
}
