@if (IsVisible)
{
    <div class="bs-modal-backdrop" @onclick="HandleBackdropClick">
        <div class="bs-modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="bs-modal-header">
                <h3 class="bs-modal-title">Add Stock Purchase</h3>
            </div>
            @if (showDiscardConfirm)
            {
                <div style="padding: 1rem;">
                    <p style="margin: 0 0 1rem 0;">Discard unsaved changes?</p>
                    <div class="bs-modal-footer">
                        <button type="button" class="bs-btn bs-btn-secondary bs-flex-1" @onclick="@(() => showDiscardConfirm = false)">
                            Keep Editing
                        </button>
                        <button type="button" class="bs-btn bs-btn-error bs-flex-1" @onclick="DiscardChanges">
                            Discard
                        </button>
                    </div>
                </div>
            }
            else
            {
            <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="bs-form-group">
                    <label class="bs-label" for="productBrand">Brand</label>
                    <InputText id="productBrand"
                              class="bs-input"
                              @bind-Value="model.ProductBrand"
                              placeholder="e.g., Starbucks, Lavazza" />
                    <ValidationMessage For="@(() => model.ProductBrand)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="productName">Product Name</label>
                    <InputText id="productName"
                              class="bs-input"
                              @bind-Value="model.ProductName"
                              placeholder="e.g., Pike Place, Super Crema" />
                    <ValidationMessage For="@(() => model.ProductName)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="quantity">Quantity (grams)</label>
                    <InputNumber id="quantity"
                                class="bs-input"
                                @bind-Value="model.QuantityGrams"
                                placeholder="250" />
                    <ValidationMessage For="@(() => model.QuantityGrams)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="totalCost">Total Cost</label>
                    <InputNumber id="totalCost"
                                class="bs-input"
                                @bind-Value="model.TotalCost"
                                placeholder="15.99" />
                    <ValidationMessage For="@(() => model.TotalCost)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="coffeeType">Coffee Type</label>
                    <InputSelect id="coffeeType" class="bs-input" @bind-Value="model.CoffeeType">
                        <option value="Espresso">Espresso</option>
                        <option value="Filter">Filter</option>
                        <option value="Instant">Instant</option>
                        <option value="Decaf">Decaf</option>
                        <option value="Specialty">Specialty</option>
                    </InputSelect>
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="purchaseDate">Purchase Date</label>
                    <InputDate id="purchaseDate"
                              class="bs-input"
                              @bind-Value="model.PurchasedAt" />
                    <ValidationMessage For="@(() => model.PurchasedAt)" class="bs-validation-message" />
                </div>

                <div class="bs-modal-footer">
                    <button type="button" class="bs-btn bs-btn-secondary bs-flex-1" @onclick="Cancel">
                        Cancel
                    </button>
                    <button type="submit" class="bs-btn bs-btn-primary bs-flex-1" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Adding...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined">add</span>
                            <span>Add Purchase</span>
                        }
                    </button>
                </div>
            </EditForm>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<AddPurchaseModel> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Parameter]
    public string CurrencyCode { get; set; } = "USD";

    private AddPurchaseModel model = new();
    private bool isSubmitting;
    private bool showDiscardConfirm;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(CurrencyCode))
            model.Currency = CurrencyCode;
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            await OnSubmit.InvokeAsync(model);
            model = new AddPurchaseModel { Currency = CurrencyCode };
            showDiscardConfirm = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool IsDirty =>
        !string.IsNullOrEmpty(model.ProductBrand) ||
        !string.IsNullOrEmpty(model.ProductName) ||
        model.QuantityGrams != 0 ||
        model.TotalCost != 0;

    private void HandleBackdropClick()
    {
        if (IsDirty)
            showDiscardConfirm = true;
        else
            DiscardChanges();
    }

    private void Cancel()
    {
        if (IsDirty)
            showDiscardConfirm = true;
        else
            DiscardChanges();
    }

    private async void DiscardChanges()
    {
        model = new AddPurchaseModel { Currency = CurrencyCode };
        showDiscardConfirm = false;
        await OnCancel.InvokeAsync();
    }

    public class AddPurchaseModel
    {
        [Required(ErrorMessage = "Brand is required")]
        [StringLength(200, MinimumLength = 1, ErrorMessage = "Brand must be between 1 and 200 characters")]
        public string ProductBrand { get; set; } = "";

        [Required(ErrorMessage = "Product name is required")]
        [StringLength(200, MinimumLength = 2, ErrorMessage = "Product name must be between 2 and 200 characters")]
        public string ProductName { get; set; } = "";

        [Required(ErrorMessage = "Quantity is required")]
        [Range(1, 10000, ErrorMessage = "Quantity must be between 1 and 10000 grams")]
        public int QuantityGrams { get; set; }

        [Required(ErrorMessage = "Total cost is required")]
        [Range(0.01, 100000, ErrorMessage = "Total cost must be greater than 0")]
        public decimal TotalCost { get; set; }

        [Required]
        public string CoffeeType { get; set; } = "Espresso";

        [Required(ErrorMessage = "Purchase date is required")]
        public DateTime PurchasedAt { get; set; } = DateTime.UtcNow;

        public string Currency { get; set; } = "USD";
    }
}
