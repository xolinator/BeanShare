@using BeanShare.Application.Features.Analytics.Queries.GetSpaceAnalytics

<div class="bs-analytics">
    @if (IsLoading)
    {
        <div class="bs-flex bs-flex-col bs-gap-4">
            @for (int i = 0; i < 3; i++)
            {
                <div class="bs-card">
                    <div class="bs-skeleton" style="height: 8rem; width: 100%;"></div>
                </div>
            }
        </div>
    }
    else if (Analytics != null)
    {
        <!-- Key Metrics Cards -->
        <div class="bs-grid bs-grid-cols-1 md:bs-grid-cols-3 bs-gap-4 bs-mb-6">
            <div class="bs-card">
                <div class="bs-flex bs-items-center bs-justify-between">
                    <div>
                        <p class="bs-text-subtle bs-mb-1" style="font-size: 0.75rem;">Total Members</p>
                        <p class="bs-font-bold" style="font-size: 2rem;">@Analytics.TotalMembers</p>
                    </div>
                    <span class="material-symbols-outlined" style="color: var(--bs-primary); font-size: 2.5rem;">group</span>
                </div>
            </div>

            <div class="bs-card">
                <div class="bs-flex bs-items-center bs-justify-between">
                    <div>
                        <p class="bs-text-subtle bs-mb-1" style="font-size: 0.75rem;">Cups This Month</p>
                        <p class="bs-font-bold" style="font-size: 2rem;">@Analytics.TotalConsumptionsThisMonth</p>
                    </div>
                    <span class="material-symbols-outlined" style="color: var(--bs-primary); font-size: 2.5rem;">coffee</span>
                </div>
            </div>

            <div class="bs-card">
                <div class="bs-flex bs-items-center bs-justify-between">
                    <div>
                        <p class="bs-text-subtle bs-mb-1" style="font-size: 0.75rem;">Stock Value</p>
                        <p class="bs-font-bold" style="font-size: 2rem;">
                            @if (Analytics.CurrentStockValue != null)
                            {
                                <span>@Analytics.CurrentStockValue.Currency @Analytics.CurrentStockValue.Amount.ToString("F2")</span>
                            }
                            else
                            {
                                <span>N/A</span>
                            }
                        </p>
                    </div>
                    <span class="material-symbols-outlined" style="color: var(--bs-primary); font-size: 2.5rem;">inventory_2</span>
                </div>
            </div>
        </div>

        <!-- All Consumers -->
        <div class="bs-card bs-mb-6">
            <div class="bs-flex bs-items-center bs-justify-between bs-mb-4" style="flex-wrap: wrap; gap: 0.5rem;">
                <h3 class="bs-font-bold" style="margin: 0;">Coffee Consumers</h3>
                <input type="search" style="padding: 0.375rem 0.625rem; border: 1px solid var(--bs-border); border-radius: 0.375rem; font-size: 0.875rem; max-width: 200px; background: var(--bs-background); color: var(--bs-text);"
                       placeholder="Search by name…"
                       @bind="consumersSearch" @bind:event="oninput" @bind:after="ResetConsumersPage" />
            </div>
            @{
                var filteredConsumers = GetFilteredSortedConsumers();
                var consumersPageCount = (int)Math.Ceiling((double)filteredConsumers.Count / ConsumersPageSize);
                var pagedConsumers = filteredConsumers.Skip((consumersPage - 1) * ConsumersPageSize).Take(ConsumersPageSize).ToList();
            }
            @if (filteredConsumers.Any())
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
                        <thead>
                            <tr style="border-bottom: 2px solid var(--bs-border);">
                                <th style="padding: 0.5rem 0.75rem; text-align: left; font-weight: 600; white-space: nowrap; cursor: pointer; user-select: none;"
                                    @onclick='() => SortConsumers("name")'>
                                    Name @SortIndicator("name")
                                </th>
                                <th style="padding: 0.5rem 0.75rem; text-align: right; font-weight: 600; white-space: nowrap; cursor: pointer; user-select: none;"
                                    @onclick='() => SortConsumers("cups")'>
                                    Cups @SortIndicator("cups")
                                </th>
                                <th style="padding: 0.5rem 0.75rem; text-align: right; font-weight: 600; white-space: nowrap; cursor: pointer; user-select: none;"
                                    @onclick='() => SortConsumers("cost")'>
                                    Estimated Cost @SortIndicator("cost")
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var consumer in pagedConsumers)
                            {
                                <tr style="border-bottom: 1px solid var(--bs-border);">
                                    <td style="padding: 0.5rem 0.75rem;">
                                        <div class="bs-flex bs-items-center bs-gap-3">
                                            <div class="bs-avatar">
                                                <span>@consumer.UserName.GetInitials()</span>
                                            </div>
                                            <span class="bs-font-medium">@consumer.UserName</span>
                                        </div>
                                    </td>
                                    <td style="padding: 0.5rem 0.75rem; text-align: right;">@consumer.CupCount</td>
                                    <td style="padding: 0.5rem 0.75rem; text-align: right;">
                                        @if (consumer.TotalCost != null)
                                        {
                                            @($"{consumer.TotalCost.Currency} {consumer.TotalCost.Amount:F2}")
                                        }
                                        else
                                        {
                                            <span class="bs-text-subtle">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (consumersPageCount > 1)
                {
                    <div class="bs-flex bs-items-center bs-justify-between" style="margin-top: 0.75rem; font-size: 0.8125rem;">
                        <span class="bs-text-subtle">
                            @((consumersPage - 1) * ConsumersPageSize + 1)–@(Math.Min(consumersPage * ConsumersPageSize, filteredConsumers.Count)) of @filteredConsumers.Count
                        </span>
                        <div class="bs-flex bs-gap-2">
                            <button style="padding: 0.25rem 0.625rem; border: 1px solid var(--bs-border); border-radius: 0.25rem; background: var(--bs-background); cursor: pointer; font-size: 0.8125rem;"
                                    disabled="@(consumersPage <= 1)"
                                    @onclick="() => consumersPage--">‹ Prev</button>
                            @for (int p = 1; p <= consumersPageCount; p++)
                            {
                                var pageNum = p;
                                <button style="padding: 0.25rem 0.625rem; border: 1px solid var(--bs-border); border-radius: 0.25rem; font-size: 0.8125rem; cursor: pointer; @(consumersPage == pageNum ? "background: var(--bs-primary); color: #fff; border-color: var(--bs-primary);" : "background: var(--bs-background);")"
                                        @onclick="() => consumersPage = pageNum">@pageNum</button>
                            }
                            <button style="padding: 0.25rem 0.625rem; border: 1px solid var(--bs-border); border-radius: 0.25rem; background: var(--bs-background); cursor: pointer; font-size: 0.8125rem;"
                                    disabled="@(consumersPage >= consumersPageCount)"
                                    @onclick="() => consumersPage++">Next ›</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="bs-text-subtle">@(Analytics.TopConsumers.Any() ? "No consumers match the search." : "No consumption data yet")</p>
            }
        </div>

        <!-- Popular Coffee Types -->
        <div class="bs-card bs-mb-6">
            <h3 class="bs-font-bold bs-mb-4">Popular Coffee Types</h3>
            @if (Analytics.PopularCoffeeTypes.Any())
            {
                <div class="bs-flex bs-flex-col bs-gap-3">
                    @foreach (var coffee in Analytics.PopularCoffeeTypes.Take(5))
                    {
                        <div>
                            <div class="bs-flex bs-items-center bs-justify-between bs-mb-1">
                                <span class="bs-font-medium">@coffee.CoffeeName</span>
                                <span class="bs-text-subtle">@coffee.Percentage.ToString("F0")%</span>
                            </div>
                            <div style="background: var(--bs-gray-200); height: 8px; border-radius: 4px; overflow: hidden;">
                                <div style="background: var(--bs-primary); height: 100%; width: @coffee.Percentage%; transition: width 0.3s;"></div>
                            </div>
                            <p class="bs-text-subtle bs-mt-1" style="font-size: 0.75rem;">@coffee.ConsumptionCount servings (@coffee.TotalGrams.ToString("F0")g)</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="bs-text-subtle">No coffee type data available</p>
            }
        </div>

        <!-- Daily Consumption Trend -->
        @if (Analytics.DailyConsumptionTrend.Any())
        {
            <div class="bs-card bs-mb-6">
                <h3 class="bs-font-bold bs-mb-4">Daily Consumption Trend</h3>
                <div style="height: 200px; position: relative;">
                    @{
                        var maxConsumption = Analytics.DailyConsumptionTrend.Values.DefaultIfEmpty(0).Max();
                        var chartHeight = 180;
                    }
                    <div class="bs-flex bs-items-end bs-justify-around" style="height: @(chartHeight)px;">
                        @foreach (var day in Analytics.DailyConsumptionTrend.OrderBy(d => d.Key).TakeLast(7))
                        {
                            var barHeight = maxConsumption > 0 ? (day.Value / (double)maxConsumption) * chartHeight : 0;
                            <div class="bs-flex bs-flex-col bs-items-center" style="flex: 1;">
                                <div style="background: var(--bs-primary); width: 80%; height: @(barHeight)px; border-radius: 4px 4px 0 0; transition: height 0.3s;"></div>
                                <span class="bs-text-subtle" style="font-size: 0.75rem; margin-top: 0.5rem;">@day.Key.ToString("MM/dd")</span>
                                <span class="bs-text-subtle" style="font-size: 0.75rem;">@day.Value</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Summary Stats -->
        <div class="bs-grid bs-grid-cols-1 md:bs-grid-cols-2 bs-gap-4">
            <div class="bs-card">
                <h3 class="bs-font-bold bs-mb-3">Stock Information</h3>
                <div class="bs-flex bs-flex-col bs-gap-2">
                    <div class="bs-flex bs-justify-between">
                        <span class="bs-text-subtle">Current Stock</span>
                        <span class="bs-font-medium">@Analytics.CurrentStockGrams.ToString("F0")g</span>
                    </div>
                    @if (Analytics.CurrentStockValue != null)
                    {
                        <div class="bs-flex bs-justify-between">
                            <span class="bs-text-subtle">Stock Value</span>
                            <span class="bs-font-medium">@Analytics.CurrentStockValue.Currency @Analytics.CurrentStockValue.Amount.ToString("F2")</span>
                        </div>
                    }
                </div>
            </div>

            <div class="bs-card">
                <h3 class="bs-font-bold bs-mb-3">Monthly Summary</h3>
                <div class="bs-flex bs-flex-col bs-gap-2">
                    <div class="bs-flex bs-justify-between">
                        <span class="bs-text-subtle">Total Cups</span>
                        <span class="bs-font-medium">@Analytics.TotalConsumptionsThisMonth</span>
                    </div>
                    @if (Analytics.TotalCostThisMonth != null)
                    {
                        <div class="bs-flex bs-justify-between">
                            <span class="bs-text-subtle">Total Cost</span>
                            <span class="bs-font-medium">@Analytics.TotalCostThisMonth.Currency @Analytics.TotalCostThisMonth.Amount.ToString("F2")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="bs-card">
            <p class="bs-text-subtle">No analytics data available</p>
        </div>
    }
</div>

@code {
    [Parameter]
    public SpaceAnalyticsDto? Analytics { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    private const int ConsumersPageSize = 10;
    private int consumersPage = 1;
    private string consumersSearch = "";
    private string consumersSortField = "cups";
    private bool consumersSortDesc = true;

    private void ResetConsumersPage() => consumersPage = 1;

    private List<TopConsumerDto> GetFilteredSortedConsumers()
    {
        if (Analytics == null) return new List<TopConsumerDto>();

        IEnumerable<TopConsumerDto> result = Analytics.TopConsumers;

        if (!string.IsNullOrWhiteSpace(consumersSearch))
            result = result.Where(c => c.UserName.Contains(consumersSearch, StringComparison.OrdinalIgnoreCase));

        result = consumersSortField switch
        {
            "name" => consumersSortDesc ? result.OrderByDescending(c => c.UserName) : result.OrderBy(c => c.UserName),
            "cost" => consumersSortDesc ? result.OrderByDescending(c => c.TotalCost?.Amount ?? 0) : result.OrderBy(c => c.TotalCost?.Amount ?? 0),
            _ => consumersSortDesc ? result.OrderByDescending(c => c.CupCount) : result.OrderBy(c => c.CupCount),
        };

        return result.ToList();
    }

    private void SortConsumers(string field)
    {
        if (consumersSortField == field)
            consumersSortDesc = !consumersSortDesc;
        else
        {
            consumersSortField = field;
            consumersSortDesc = field != "name";
        }
        consumersPage = 1;
    }

    private MarkupString SortIndicator(string field)
    {
        if (consumersSortField != field) return new MarkupString("<span style='opacity:0.3'>⇅</span>");
        return new MarkupString(consumersSortDesc ? "↓" : "↑");
    }
}