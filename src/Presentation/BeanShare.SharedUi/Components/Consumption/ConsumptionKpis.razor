<div class="bs-flex" style="gap: 0.5rem; flex-wrap: wrap;">
    <KpiChip Label="My Cups Today" Value="@MyCupsToday.ToString()" />
    <KpiChip Label="My Total" Value="@FormatCurrency(MyTotalCost)" />
    <div class="bs-kpi-chip" style="position: relative;">
        <span class="bs-font-medium">Total Stock</span>
        <span class="bs-kpi-value">@FormatStock(RemainingStockGrams)</span>
        @if (RemainingStockGrams < 200)
        {
            <span style="position: absolute; top: -0.25rem; right: -0.25rem; width: 0.75rem; height: 0.75rem; background: var(--bs-warning); border-radius: 9999px; animation: pulse 2s infinite;"></span>
        }
    </div>
</div>

@code {
    [Parameter]
    public int MyCupsToday { get; set; }

    [Parameter]
    public decimal MyTotalCost { get; set; }

    [Parameter]
    public int RemainingStockGrams { get; set; }

    [Parameter]
    public string CurrencyCode { get; set; } = "USD";

    private string FormatStock(int grams)
    {
        if (grams >= 1000)
            return $"{grams / 1000.0:F1} kg";
        return $"{grams} g";
    }

    private string FormatCurrency(decimal amount)
    {
        try
        {
            var currency = BeanShare.Domain.ValueObjects.Currency.Create(CurrencyCode);
            return currency.FormatAmount(amount);
        }
        catch
        {
            return $"{amount:N2}";
        }
    }
}
