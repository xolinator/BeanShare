@using BeanShare.SharedUi.Services
@using Microsoft.JSInterop
@inject IQrCodeService QrCodeService
@inject IQrScannerService QrScannerService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (IsVisible)
{
    <div class="bs-modal-backdrop" @onclick="HandleClose">
        <div class="bs-modal" role="dialog" aria-label="Scan QR code" aria-modal="true" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true" style="max-width: 28rem;">
            <div class="bs-modal-header bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
                <h3 class="bs-modal-title" style="margin: 0;">Scan QR Code</h3>
                <button class="bs-btn-icon" aria-label="Close" @onclick="HandleClose" style="background: transparent; border: none; cursor: pointer;">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div style="background: var(--bs-danger-light, #fee2e2); border: 1px solid var(--bs-danger, #ef4444); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 1rem;">
                    <p style="margin: 0; font-size: 0.875rem; color: var(--bs-danger-dark, #991b1b);">@errorMessage</p>
                </div>
            }

            @if (scannerActive)
            {
                <div style="text-align: center;">
                    <div id="qr-reader" style="width: 100%;"></div>
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin-top: 0.75rem;">
                        Point your camera at a BeanShare QR code
                    </p>
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 2rem 0;">
                    <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--bs-primary); margin-bottom: 1rem; display: block;">qr_code_scanner</span>
                    <p style="margin: 0 0 1.5rem 0; font-size: 0.875rem; color: var(--bs-text-subtle);">
                        Use your camera to scan a QR code, or upload an image.
                    </p>
                    <div class="bs-flex bs-flex-col bs-gap-3" style="align-items: center;">
                        <button class="bs-btn bs-btn-primary" @onclick="StartCamera" style="gap: 0.5rem;">
                            <span class="material-symbols-outlined" style="font-size: 1.25rem;">photo_camera</span>
                            Open Camera
                        </button>
                        <label class="bs-btn bs-btn-secondary" style="gap: 0.5rem; cursor: pointer;">
                            <span class="material-symbols-outlined" style="font-size: 1.25rem;">upload</span>
                            Upload Image
                            <input type="file" accept="image/*" aria-label="Upload QR code image" @onchange="HandleFileUpload" style="display: none;" id="qr-file-input" />
                        </label>
                    </div>
                </div>
            }

            @if (scannerActive)
            {
                <div class="bs-modal-footer" style="display: flex; justify-content: center; margin-top: 1rem;">
                    <button class="bs-btn bs-btn-secondary" @onclick="StopCamera">
                        Cancel Scan
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<QrConsumptionPayload> OnScanned { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool scannerActive;
    private string errorMessage = "";
    private DotNetObjectReference<QrScannerModal>? dotNetRef;
    private bool wasVisible;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsVisible && wasVisible)
        {
            await StopCamera();
            errorMessage = "";
        }
        wasVisible = IsVisible;
    }

    private async Task StartCamera()
    {
        errorMessage = "";

        var hasPermission = await QrScannerService.RequestCameraPermissionAsync();
        if (!hasPermission)
        {
            errorMessage = "Camera permission is required to scan QR codes.";
            return;
        }

        scannerActive = true;
        StateHasChanged();

        await Task.Delay(100); // let the DOM render #qr-reader

        dotNetRef ??= DotNetObjectReference.Create(this);
        var started = await JSRuntime.InvokeAsync<bool>("beanshareQrScanner.start", "qr-reader", dotNetRef);
        if (!started)
        {
            errorMessage = "Could not access camera. Please ensure camera permissions are granted.";
            scannerActive = false;
        }
    }

    private async Task StopCamera()
    {
        if (scannerActive)
        {
            await JSRuntime.InvokeVoidAsync("beanshareQrScanner.stop");
            scannerActive = false;
        }
    }

    private async Task HandleFileUpload(ChangeEventArgs e)
    {
        errorMessage = "";
        dotNetRef ??= DotNetObjectReference.Create(this);

        await JSRuntime.InvokeVoidAsync("beanshareQrScanner.scanFile", "qr-file-input", dotNetRef);
    }

    [JSInvokable]
    public async Task OnQrCodeScanned(string decodedText)
    {
        await StopCamera();

        var payload = QrCodeService.ParseQrPayload(decodedText);
        if (payload == null)
        {
            errorMessage = "Invalid QR code. This doesn't appear to be a BeanShare QR code.";
            StateHasChanged();
            return;
        }

        await OnScanned.InvokeAsync(payload);
    }

    [JSInvokable]
    public void OnQrScanError(string error)
    {
        errorMessage = error;
        StateHasChanged();
    }

    private async Task HandleClose()
    {
        await StopCamera();
        errorMessage = "";
        await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await StopCamera();
        dotNetRef?.Dispose();
    }
}
