@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.Application.Features.Presets.Queries
@using BeanShare.Application.Features.Spaces.Dtos
@using BeanShare.SharedUi.Components.Consumption.Models

<div class="bs-card">
    <EditForm Model="@model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        @if (StockProducts == null || !StockProducts.Any())
        {
            <div style="padding: 1rem; background: var(--bs-warning-light); border-radius: 0.5rem; margin-bottom: 1rem;">
                <p style="margin: 0; color: var(--bs-warning-dark); font-size: 0.875rem;">
                    No coffee products in stock. Please add coffee to stock first.
                </p>
            </div>
        }
        else
        {
            <div class="bs-form-group">
                <label class="bs-label" for="productSelect">Coffee Product</label>
                <select id="productSelect"
                        class="bs-input"
                        @onchange="OnProductSelected"
                        value="@selectedProductId">
                    <option value="">-- Select a coffee product --</option>
                    @foreach (var product in StockProducts)
                    {
                        <option value="@product.Id">
                            @product.ProductDisplayName (@product.ProductType, @product.CurrentStockGrams g available)
                        </option>
                    }
                </select>
                @if (!string.IsNullOrEmpty(productSelectionError))
                {
                    <div style="color: var(--bs-danger); font-size: 0.875rem; margin-top: 0.5rem;">
                        @productSelectionError
                    </div>
                }
            </div>

            @if (SpaceMembers != null && SpaceMembers.Count > 1)
            {
                <div class="bs-form-group">
                    <label class="bs-label">Log for</label>
                    <div role="group" aria-label="Select members to log coffee for" style="display: flex; flex-direction: column; gap: 0.5rem; padding: 0.75rem; background: var(--bs-gray-50); border-radius: 0.5rem; max-height: 10rem; overflow-y: auto;">
                        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem;">
                            <input type="checkbox" checked="@logForMyself" @onchange="ToggleMyself" aria-label="Log for myself" />
                            <span style="font-weight: 500;">Myself</span>
                        </label>
                        @foreach (var member in SpaceMembers.Where(m => !CurrentUserId.HasValue || m.UserId != CurrentUserId.Value))
                        {
                            var memberId = member.UserId;
                            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.875rem;">
                                <input type="checkbox" checked="@selectedMemberIds.Contains(memberId)" @onchange="() => ToggleMember(memberId)" />
                                <span>@member.UserName</span>
                                <span style="color: var(--bs-text-subtle); font-size: 0.75rem;">@member.Email</span>
                            </label>
                        }
                    </div>
                    <p style="margin: 0.25rem 0 0 0; font-size: 0.75rem; color: var(--bs-text-subtle);">
                        Select one or more members to log coffee for simultaneously.
                    </p>
                </div>
            }

            <div class="bs-form-group">
                <label class="bs-label">Quick Presets</label>
                @if (QuickPresets == null || !QuickPresets.Any())
                {
                    <div style="padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem; font-size: 0.875rem; color: var(--bs-text-subtle);">
                        Loading presets...
                    </div>
                }
                else
                {
                    var favorites = QuickPresets.Where(p => p.IsFavorite).ToList();
                    var nonFavorites = QuickPresets.Where(p => !p.IsFavorite).ToList();

                    @if (favorites.Any())
                    {
                        <div style="margin-bottom: 0.5rem;">
                            <span style="font-size: 0.75rem; color: var(--bs-text-subtle); font-weight: 600;">FAVORITES</span>
                        </div>
                        <div class="bs-flex bs-gap-2" style="flex-wrap: wrap; margin-bottom: 1rem;">
                            @foreach (var preset in favorites)
                            {
                                <button type="button"
                                        class="bs-btn bs-btn-sm @(IsPresetSelected(preset) ? "bs-btn-primary" : "bs-btn-secondary")"
                                        style="position: relative;"
                                        @onclick="() => SelectPreset(preset)">
                                    <span class="material-symbols-outlined" style="font-size: 0.875rem; margin-right: 0.25rem; vertical-align: middle;">star</span>
                                    @preset.Name · @preset.Grams g
                                </button>
                            }
                        </div>
                    }

                    @if (nonFavorites.Any())
                    {
                        @if (favorites.Any())
                        {
                            <div style="margin-bottom: 0.5rem;">
                                <span style="font-size: 0.75rem; color: var(--bs-text-subtle); font-weight: 600;">ALL PRESETS</span>
                            </div>
                        }
                        <div class="bs-flex bs-gap-2" style="flex-wrap: wrap;">
                            @foreach (var preset in nonFavorites)
                            {
                                <button type="button"
                                        class="bs-btn bs-btn-sm @(IsPresetSelected(preset) ? "bs-btn-primary" : "bs-btn-secondary")"
                                        @onclick="() => SelectPreset(preset)">
                                    @preset.Name · @preset.Grams g
                                </button>
                            }
                            <button type="button"
                                    class="bs-btn bs-btn-sm @(isCustomMode ? "bs-btn-primary" : "bs-btn-secondary")"
                                    @onclick="SelectCustom">
                                Custom
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="bs-flex bs-gap-2" style="flex-wrap: wrap;">
                            <button type="button"
                                    class="bs-btn bs-btn-sm @(isCustomMode ? "bs-btn-primary" : "bs-btn-secondary")"
                                    @onclick="SelectCustom">
                                Custom
                            </button>
                        </div>
                    }
                }
            </div>

            @if (isCustomMode)
            {
                <div class="bs-form-group">
                    <label class="bs-label" for="gramsInput">Coffee (grams)</label>
                    <div style="position: relative;">
                        <InputNumber id="gramsInput"
                                    class="bs-input"
                                    @bind-Value="model.Grams"
                                    placeholder="12" />
                        <span style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--bs-text-subtle); font-size: 0.875rem;">
                            g
                        </span>
                    </div>
                    <ValidationMessage For="@(() => model.Grams)" class="bs-validation-message" />
                </div>
            }

            <div class="bs-form-group">
                <label class="bs-label" for="dateTimeInput">Date & Time</label>
                <InputDate Type="InputDateType.DateTimeLocal"
                          id="dateTimeInput"
                          class="bs-input"
                          @bind-Value="model.ConsumedAt" />
                <p style="margin: 0.25rem 0 0 0; font-size: 0.75rem; color: var(--bs-text-subtle);">
                    Defaults to now.
                </p>
            </div>

            <div class="bs-flex bs-gap-3 bs-mt-4">
                <button type="submit" class="bs-btn bs-btn-primary bs-flex-1" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Logging...</span>
                    }
                    else
                    {
                        <span>Log Coffee</span>
                    }
                </button>
                <button type="button" class="bs-btn bs-btn-secondary bs-flex-1" @onclick="Reset">
                    Cancel
                </button>
            </div>
        }
    </EditForm>
</div>

@code {
    [Parameter]
    public EventCallback<ConsumptionFormModel> OnSubmit { get; set; }

    [Parameter]
    public List<StockLevelDto> StockProducts { get; set; } = new();

    [Parameter]
    public PresetDto? PresetData { get; set; }

    [Parameter]
    public List<PresetOption>? QuickPresets { get; set; }

    [Parameter]
    public EventCallback<(PresetOption Preset, bool IsFavorite)> OnToggleFavorite { get; set; }

    [Parameter]
    public List<MembershipDto>? SpaceMembers { get; set; }

    [Parameter]
    public Guid? CurrentUserId { get; set; }

    private ConsumptionFormModel model = new() { ConsumedAt = DateTime.Now };
    private bool isSubmitting;
    private bool isCustomMode = false;
    private PresetOption? selectedPresetOption;
    private StockLevelDto? selectedProduct;
    private string selectedProductId = "";
    private string productSelectionError = "";
    private HashSet<Guid> selectedMemberIds = new();
    private bool logForMyself = true;

    protected override void OnParametersSet()
    {
        if (PresetData != null)
        {
            model.Grams = (int)PresetData.DefaultGrams;
            model.PresetId = PresetData.Id;
            model.PresetName = PresetData.Name;

            isCustomMode = true;
            selectedPresetOption = null;
        }
        else if (model.Grams == 0 && !isCustomMode && selectedPresetOption == null)
        {
            // Select first favorite or first preset by default
            var defaultPreset = QuickPresets?.FirstOrDefault(p => p.IsFavorite) ?? QuickPresets?.FirstOrDefault();
            if (defaultPreset != null)
            {
                SelectPreset(defaultPreset);
            }
            else
            {
                model.Grams = 8; // Fallback default
            }
        }
    }

    private bool IsPresetSelected(PresetOption preset)
    {
        if (selectedPresetOption == null) return false;

        if (preset.GlobalPresetId.HasValue && selectedPresetOption.GlobalPresetId.HasValue)
            return preset.GlobalPresetId == selectedPresetOption.GlobalPresetId;

        if (preset.SpacePresetId.HasValue && selectedPresetOption.SpacePresetId.HasValue)
            return preset.SpacePresetId == selectedPresetOption.SpacePresetId;

        return preset.Name == selectedPresetOption.Name && preset.Grams == selectedPresetOption.Grams;
    }

    private void OnProductSelected(ChangeEventArgs e)
    {
        selectedProductId = e.Value?.ToString() ?? "";

        if (string.IsNullOrEmpty(selectedProductId))
        {
            selectedProduct = null;
            model.ProductName = "";
            model.ProductBrand = "";
            model.ProductType = "";
        }
        else
        {
            selectedProduct = StockProducts.FirstOrDefault(p => p.Id.ToString() == selectedProductId);
            if (selectedProduct != null)
            {
                model.ProductName = selectedProduct.ProductName;
                model.ProductBrand = selectedProduct.ProductBrand;
                model.ProductType = selectedProduct.ProductType;
                productSelectionError = "";
            }
        }
    }

    private void ToggleMyself()
    {
        logForMyself = !logForMyself;
    }

    private void ToggleMember(Guid memberId)
    {
        if (selectedMemberIds.Contains(memberId))
            selectedMemberIds.Remove(memberId);
        else
            selectedMemberIds.Add(memberId);
    }

    private void SelectPreset(PresetOption preset)
    {
        isCustomMode = false;
        selectedPresetOption = preset;
        model.Grams = preset.Grams;
        model.PresetName = preset.Name;

        model.GlobalPresetId = preset.GlobalPresetId;
        model.SpacePresetId = preset.SpacePresetId;
    }

    private void SelectCustom()
    {
        isCustomMode = true;
        selectedPresetOption = null;
        model.PresetName = null;
        model.GlobalPresetId = null;
        model.SpacePresetId = null;
        model.Grams = 0;
    }

    private async Task HandleSubmit()
    {
        if (selectedProduct == null)
        {
            productSelectionError = "Please select a coffee product";
            return;
        }

        if (model.Grams <= 0)
        {
            return;
        }

        // Validate that at least one person is selected
        if (!logForMyself && !selectedMemberIds.Any())
        {
            productSelectionError = "Please select at least one member to log consumption for.";
            return;
        }

        // Build target user list: allow both "Myself" and other members simultaneously
        if (logForMyself && selectedMemberIds.Any())
        {
            // Both myself and others selected
            var allIds = new List<Guid>();
            if (CurrentUserId.HasValue)
                allIds.Add(CurrentUserId.Value);
            allIds.AddRange(selectedMemberIds);
            model.ForUserIds = allIds;
            model.ForUserId = null;
        }
        else if (!logForMyself && selectedMemberIds.Any())
        {
            // Only others selected
            model.ForUserIds = selectedMemberIds.ToList();
            model.ForUserId = null;
        }
        else
        {
            // Just myself (default)
            model.ForUserIds = null;
            model.ForUserId = null;
        }

        isSubmitting = true;
        try
        {
            await OnSubmit.InvokeAsync(model);
            Reset();
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Reset()
    {
        var defaultPreset = QuickPresets?.FirstOrDefault(p => p.IsFavorite) ?? QuickPresets?.FirstOrDefault();

        model = new ConsumptionFormModel
        {
            ConsumedAt = DateTime.Now,
            Grams = defaultPreset?.Grams ?? 8
        };

        isCustomMode = false;
        selectedPresetOption = defaultPreset;

        if (defaultPreset != null)
        {
            model.PresetName = defaultPreset.Name;
            model.GlobalPresetId = defaultPreset.GlobalPresetId;
            model.SpacePresetId = defaultPreset.SpacePresetId;
        }

        selectedProduct = null;
        selectedProductId = "";
        productSelectionError = "";
        selectedMemberIds.Clear();
        logForMyself = true;
    }
}
