@inherits LayoutComponentBase
@implements IDisposable
@using BeanShare.BlazorWeb.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<AuthorizeView>
    <Authorized>
        <SemiAuthQrBootstrapper />
        <div class="app-container">
            <Sidebar OnCreateSpace="ShowCreateSpace" OnJoinSpace="ShowJoinSpace" />
            <div class="sidebar-backdrop"></div>

            <div class="main-content">
                <Header Breadcrumbs="@breadcrumbs" />

                <div class="page-content">
                    @Body
                </div>
            </div>
        </div>

        @if (showCreateSpaceModal)
        {
            <BeanShare.SharedUi.Components.Spaces.CreateSpaceModal OnClose="CloseCreateSpaceModal" OnSpaceCreated="OnSpaceCreated" />
        }

        @if (showJoinSpaceModal)
        {
            <BeanShare.SharedUi.Components.Spaces.JoinSpaceModal OnClose="CloseJoinSpaceModal" OnSpaceJoined="OnSpaceJoined" />
        }
    </Authorized>
    <NotAuthorized>
        <div class="minimal-layout">
            @Body
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" style="display: none; position: fixed; bottom: 1rem; right: 1rem; background: var(--bs-error, #dc2626); color: white; padding: 1rem; border-radius: 0.5rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); z-index: 1000;">
    An unhandled error has occurred.
    <a href="." class="reload" style="color: white; text-decoration: underline; margin-left: 1rem;">Reload</a>
    <button class="dismiss" style="background: transparent; border: none; color: white; cursor: pointer; margin-left: 0.5rem; font-size: 1.25rem;">×</button>
</div>


@code {
    private bool showCreateSpaceModal = false;
    private bool showJoinSpaceModal = false;
    private List<Header.BreadcrumbItem> breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        UpdateBreadcrumbs();
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateBreadcrumbs();
        StateHasChanged();
    }

    private void UpdateBreadcrumbs()
    {
        breadcrumbs.Clear();
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);

        if (string.IsNullOrEmpty(path) || path == "/")
        {
            breadcrumbs.Add(new Header.BreadcrumbItem { Text = "Home" });
        }
        else
        {
            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            breadcrumbs.Add(new Header.BreadcrumbItem { Text = "Home", Link = "/" });

            for (int i = 0; i < segments.Length; i++)
            {
                var segment = segments[i];
                var isLast = i == segments.Length - 1;
                var link = isLast ? null : "/" + string.Join("/", segments.Take(i + 1));

                var text = segment switch
                {
                    "spaces" => "Spaces",
                    "stock" => "Stock",
                    "consumption" => "Consumption",
                    "profile" => "Profile",
                    "settings" => "Settings",
                    _ when Guid.TryParse(segment, out _) => "Space Details",
                    _ => segment
                };

                breadcrumbs.Add(new Header.BreadcrumbItem { Text = text, Link = link });
            }
        }
    }

    private void ShowCreateSpace()
    {
        showCreateSpaceModal = true;
    }

    private void CloseCreateSpaceModal()
    {
        showCreateSpaceModal = false;
    }

    private void OnSpaceCreated(Guid spaceId)
    {
        showCreateSpaceModal = false;
        Navigation.NavigateTo($"/spaces/{spaceId}");
    }

    private void ShowJoinSpace()
    {
        showJoinSpaceModal = true;
    }

    private void CloseJoinSpaceModal()
    {
        showJoinSpaceModal = false;
    }

    private void OnSpaceJoined(Guid spaceId)
    {
        showJoinSpaceModal = false;
        Navigation.NavigateTo($"/spaces/{spaceId}");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
