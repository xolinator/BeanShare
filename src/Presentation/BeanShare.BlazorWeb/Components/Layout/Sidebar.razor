@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<aside class="@GetSidebarClasses()">
    <div class="sidebar-header">
        <div class="sidebar-logo" @onclick="NavigateHome">
            <img src="_content/BeanShare.SharedUi/images/logo.svg" alt="BeanShare" class="sidebar-logo-img" />
            <span class="sidebar-brand">BeanShare</span>
        </div>
        <button class="sidebar-toggle" @onclick="ToggleSidebar">
            <span class="material-symbols-outlined">@(isCollapsed ? "menu" : "close")</span>
        </button>
    </div>

    <nav class="sidebar-nav">
        <AuthorizeView>
            <Authorized>
                <div class="sidebar-section">
                    <NavLink class="sidebar-link" href="/dashboard">
                        <span class="material-symbols-outlined">insights</span>
                        <span class="sidebar-link-text">Dashboard</span>
                    </NavLink>

                    <NavLink class="sidebar-link" href="/spaces" Match="NavLinkMatch.All">
                        <span class="material-symbols-outlined">groups</span>
                        <span class="sidebar-link-text">My Spaces</span>
                    </NavLink>

                    @if (recentSpaces?.Any() == true)
                    {
                        <div class="sidebar-subsection">
                            <div class="sidebar-subtitle">Recent Spaces</div>
                            @foreach (var space in recentSpaces.Take(5))
                            {
                                <NavLink class="sidebar-sublink" href="@($"/spaces/{space.Id}")">
                                    <span class="material-symbols-outlined">coffee</span>
                                    <span class="sidebar-link-text">@space.Name</span>
                                </NavLink>
                            }
                        </div>
                    }
                </div>

                <div class="sidebar-section sidebar-section-bottom">
                    <div class="sidebar-subtitle">Account</div>
                    <NavLink class="sidebar-link" href="/profile">
                        <span class="material-symbols-outlined">person</span>
                        <span class="sidebar-link-text">Profile</span>
                    </NavLink>

                    <NavLink class="sidebar-link" href="/settings">
                        <span class="material-symbols-outlined">settings</span>
                        <span class="sidebar-link-text">Settings</span>
                    </NavLink>

                    <button class="sidebar-link" @onclick="Logout">
                        <span class="material-symbols-outlined">logout</span>
                        <span class="sidebar-link-text">Logout</span>
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="sidebar-section">
                    <NavLink class="sidebar-link" href="/login">
                        <span class="material-symbols-outlined">login</span>
                        <span class="sidebar-link-text">Login</span>
                    </NavLink>

                    <NavLink class="sidebar-link" href="/register">
                        <span class="material-symbols-outlined">person_add</span>
                        <span class="sidebar-link-text">Register</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    @if (!isCollapsed)
    {
        <div class="sidebar-footer">
            <div class="sidebar-user">
                <AuthorizeView>
                    <Authorized>
                        <div class="sidebar-user-avatar">
                            @if (!string.IsNullOrEmpty(userPictureUrl))
                            {
                                <img src="@userPictureUrl" alt="@userName" />
                            }
                            else
                            {
                                @GetInitials(userName)
                            }
                        </div>
                        <div class="sidebar-user-info">
                            <div class="sidebar-user-name">@userName</div>
                            <div class="sidebar-user-email">@userEmail</div>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    }
</aside>

<style>
    .sidebar {
        position: fixed;
        left: 0;
        top: 0;
        height: 100vh;
        width: 280px;
        background-color: var(--bs-background);
        border-right: 1px solid var(--bs-border);
        display: flex;
        flex-direction: column;
        transition: width 0.3s ease, transform 0.3s ease;
        z-index: 40;
        overflow: hidden;
    }

    .sidebar.collapsed {
        width: 72px;
    }

    .sidebar.mobile {
        transform: translateX(-100%);
    }

    .sidebar.mobile.open {
        transform: translateX(0);
    }

    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
        border-bottom: 1px solid var(--bs-border);
        min-height: 64px;
    }

    .sidebar-logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        color: var(--bs-primary);
        font-weight: 700;
        font-size: 1.25rem;
    }

    .sidebar-logo-img {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
    }

    .sidebar-brand {
        transition: opacity 0.3s ease;
    }

    .sidebar.collapsed .sidebar-brand {
        opacity: 0;
        width: 0;
        overflow: hidden;
    }

    .sidebar-toggle {
        display: none;
        background: transparent;
        border: none;
        color: var(--bs-text);
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 0.5rem;
        transition: background-color 0.2s;
    }

    .sidebar-toggle:hover {
        background-color: var(--bs-gray-100);
    }

    .sidebar-nav {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 0;
        display: flex;
        flex-direction: column;
    }

    .sidebar-section {
        padding: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .sidebar-section-bottom {
        margin-top: auto;
        border-top: 1px solid var(--bs-border);
        padding-top: 1rem;
    }

    .sidebar-subtitle {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--bs-text-subtle);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.5rem 1rem;
        margin: 0.5rem 0 0.25rem 0;
    }

    .sidebar.collapsed .sidebar-subtitle {
        display: none;
    }

    .sidebar-link, .sidebar-sublink {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        color: var(--bs-text);
        text-decoration: none;
        border-radius: 0.5rem;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: transparent;
        width: 100%;
        text-align: left;
        font-size: 0.9375rem;
    }

    .sidebar-sublink {
        padding-left: 2.5rem;
        font-size: 0.875rem;
    }

    .sidebar.collapsed .sidebar-sublink {
        display: none;
    }

    .sidebar-link:hover, .sidebar-sublink:hover {
        background-color: var(--bs-gray-100);
        color: var(--bs-primary);
    }

    .sidebar-link.active, .sidebar-sublink.active {
        background-color: var(--bs-primary-light);
        color: var(--bs-primary);
        font-weight: 600;
    }

    .sidebar-link-text {
        transition: opacity 0.3s ease;
        white-space: nowrap;
    }

    .sidebar.collapsed .sidebar-link-text {
        opacity: 0;
        width: 0;
        overflow: hidden;
    }

    .sidebar-subsection {
        margin-top: 0.5rem;
    }

    .sidebar.collapsed .sidebar-subsection {
        display: none;
    }

    .sidebar-footer {
        border-top: 1px solid var(--bs-border);
        padding: 1rem;
        margin-top: auto;
    }

    .sidebar-user {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .sidebar-user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: var(--bs-primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.875rem;
        flex-shrink: 0;
    }

    .sidebar-user-avatar img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .sidebar-user-info {
        flex: 1;
        min-width: 0;
    }

    .sidebar-user-name {
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--bs-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sidebar-user-email {
        font-size: 0.75rem;
        color: var(--bs-text-subtle);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (max-width: 768px) {
        .sidebar {
            width: 280px;
        }

        .sidebar.collapsed {
            width: 280px;
        }

        .sidebar-toggle {
            display: block;
        }

        .sidebar-brand,
        .sidebar-link-text,
        .sidebar-subsection,
        .sidebar-subtitle {
            opacity: 1 !important;
            width: auto !important;
        }
    }

    @@media (min-width: 769px) {
        .sidebar-toggle {
            display: block;
        }
    }

    .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 39;
    }

    @@media (max-width: 768px) {
        .sidebar.mobile.open ~ .sidebar-backdrop {
            display: block;
        }
    }
</style>

@code {
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public EventCallback OnCreateSpace { get; set; }
    [Parameter] public EventCallback OnJoinSpace { get; set; }

    private bool isCollapsed = false;
    private bool isMobileMenuOpen = false;
    private List<SpaceInfo> recentSpaces = new();
    private string userName = "";
    private string userEmail = "";
    private string? userPictureUrl = null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            userName = authState.User.Identity.Name ?? "User";
            userEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
            userPictureUrl = authState.User.FindFirst("picture")?.Value;

            // TODO: Load recent spaces from API
            // recentSpaces = await LoadRecentSpaces();
        }
    }

    private string GetSidebarClasses()
    {
        var classes = "sidebar";
        if (isCollapsed && !IsMobile) classes += " collapsed";
        if (IsMobile) classes += " mobile";
        if (IsMobile && isMobileMenuOpen) classes += " open";
        return classes;
    }

    private void ToggleSidebar()
    {
        if (IsMobile)
        {
            isMobileMenuOpen = !isMobileMenuOpen;
        }
        else
        {
            isCollapsed = !isCollapsed;
        }
    }

    private void NavigateHome()
    {
        Navigation.NavigateTo("/");
    }

    private async Task ShowCreateSpace()
    {
        if (OnCreateSpace.HasDelegate)
        {
            await OnCreateSpace.InvokeAsync();
        }
    }

    private async Task ShowJoinSpace()
    {
        if (OnJoinSpace.HasDelegate)
        {
            await OnJoinSpace.InvokeAsync();
        }
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", forceLoad: true);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name[0].ToString().ToUpper();
    }

    private class SpaceInfo
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
}