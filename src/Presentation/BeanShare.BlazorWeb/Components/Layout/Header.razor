@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<header class="app-header">
    <div class="header-left">
        <button class="header-menu-toggle" @onclick="OnToggleSidebar">
            <span class="material-symbols-outlined">menu</span>
        </button>

        @if (Breadcrumbs?.Any() == true)
        {
            <nav class="breadcrumb">
                @foreach (var (text, link, index) in Breadcrumbs.Select((item, i) => (item.Text, item.Link, i)))
                {
                    @if (index > 0)
                    {
                        <span class="breadcrumb-separator">/</span>
                    }
                    @if (!string.IsNullOrEmpty(link) && index < Breadcrumbs.Count - 1)
                    {
                        <a href="@link" class="breadcrumb-link">@text</a>
                    }
                    else
                    {
                        <span class="breadcrumb-current">@text</span>
                    }
                }
            </nav>
        }
    </div>

    <div class="header-center">
        <div class="header-search">
            <span class="material-symbols-outlined search-icon">search</span>
            <input type="text" class="search-input" placeholder="Search spaces, members, or coffee..." @bind="searchQuery" @onkeyup="@(async (e) => { if (e.Key == "Enter") await Search(); })" />
            <span class="search-shortcut">Ctrl+K</span>
        </div>
    </div>

    <div class="header-right">
        <AuthorizeView>
            <Authorized>
                <button class="header-icon-btn" title="Notifications">
                    <span class="material-symbols-outlined">notifications</span>
                    @if (unreadNotifications > 0)
                    {
                        <span class="notification-badge">@unreadNotifications</span>
                    }
                </button>

                <button class="header-icon-btn" title="Help" @onclick="ShowHelp">
                    <span class="material-symbols-outlined">help</span>
                </button>

                <div class="header-user-menu">
                    <button class="header-user-btn" @onclick="ToggleUserDropdown">
                        <div class="header-user-avatar">
                            @if (!string.IsNullOrEmpty(userPictureUrl))
                            {
                                <img src="@userPictureUrl" alt="@userName" />
                            }
                            else
                            {
                                @GetInitials(userName)
                            }
                        </div>
                        <span class="header-user-name">@userName</span>
                        <span class="material-symbols-outlined">@(isUserDropdownOpen ? "expand_less" : "expand_more")</span>
                    </button>

                    @if (isUserDropdownOpen)
                    {
                        <div class="user-dropdown">
                            <div class="dropdown-header">
                                <div class="dropdown-user-info">
                                    <div class="dropdown-user-name">@userName</div>
                                    <div class="dropdown-user-email">@userEmail</div>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item" @onclick='() => NavigateTo("/profile")'>
                                <span class="material-symbols-outlined">person</span>
                                <span>My Profile</span>
                            </button>
                            <button class="dropdown-item" @onclick='() => NavigateTo("/settings")'>
                                <span class="material-symbols-outlined">settings</span>
                                <span>Settings</span>
                            </button>
                            <button class="dropdown-item" @onclick='() => NavigateTo("/billing")'>
                                <span class="material-symbols-outlined">credit_card</span>
                                <span>Billing</span>
                            </button>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item" @onclick="ShowKeyboardShortcuts">
                                <span class="material-symbols-outlined">keyboard</span>
                                <span>Keyboard Shortcuts</span>
                            </button>
                            <button class="dropdown-item" @onclick='() => NavigateTo("/help")'>
                                <span class="material-symbols-outlined">help</span>
                                <span>Help & Support</span>
                            </button>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item dropdown-item-danger" @onclick="Logout">
                                <span class="material-symbols-outlined">logout</span>
                                <span>Logout</span>
                            </button>
                        </div>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="bs-btn bs-btn-primary bs-btn-sm">Login</a>
                <a href="/register" class="bs-btn bs-btn-secondary bs-btn-sm">Register</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@if (isUserDropdownOpen)
{
    <div class="dropdown-backdrop" @onclick="CloseDropdown"></div>
}

<style>
    .app-header {
        position: fixed;
        top: 0;
        right: 0;
        left: 280px;
        height: 64px;
        background-color: var(--bs-background);
        border-bottom: 1px solid var(--bs-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.5rem;
        z-index: 30;
        transition: left 0.3s ease;
    }

    .app-header.sidebar-collapsed {
        left: 72px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
    }

    .header-menu-toggle {
        display: none;
        background: transparent;
        border: none;
        color: var(--bs-text);
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 0.5rem;
        transition: background-color 0.2s;
    }

    .header-menu-toggle:hover {
        background-color: var(--bs-gray-100);
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
    }

    .breadcrumb-separator {
        color: var(--bs-text-subtle);
    }

    .breadcrumb-link {
        color: var(--bs-text-subtle);
        text-decoration: none;
        transition: color 0.2s;
    }

    .breadcrumb-link:hover {
        color: var(--bs-primary);
    }

    .breadcrumb-current {
        color: var(--bs-text);
        font-weight: 500;
    }

    .header-center {
        flex: 2;
        max-width: 480px;
        margin: 0 2rem;
    }

    .header-search {
        position: relative;
        width: 100%;
    }

    .search-input {
        width: 100%;
        padding: 0.5rem 2.5rem;
        border: 1px solid var(--bs-border);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        background-color: var(--bs-gray-100);
        transition: all 0.2s;
    }

    .search-input:focus {
        outline: none;
        border-color: var(--bs-primary);
        box-shadow: 0 0 0 3px var(--bs-primary-light);
        background-color: var(--bs-background);
    }

    .search-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--bs-text-subtle);
        font-size: 1.25rem;
    }

    .search-shortcut {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        padding: 0.125rem 0.375rem;
        background-color: var(--bs-gray-200);
        color: var(--bs-text-subtle);
        font-size: 0.75rem;
        border-radius: 0.25rem;
        font-weight: 500;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex: 1;
        justify-content: flex-end;
    }

    .header-icon-btn {
        position: relative;
        background: transparent;
        border: none;
        color: var(--bs-text);
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 0.5rem;
        transition: background-color 0.2s;
    }

    .header-icon-btn:hover {
        background-color: var(--bs-gray-100);
    }

    .notification-badge {
        position: absolute;
        top: 0.25rem;
        right: 0.25rem;
        background-color: var(--bs-error);
        color: white;
        font-size: 0.625rem;
        font-weight: 700;
        padding: 0.125rem 0.25rem;
        border-radius: 9999px;
        min-width: 1rem;
        text-align: center;
    }

    .header-user-menu {
        position: relative;
    }

    .header-user-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.375rem 0.75rem;
        background: transparent;
        border: 1px solid var(--bs-border);
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .header-user-btn:hover {
        background-color: var(--bs-gray-100);
    }

    .header-user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: var(--bs-primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.75rem;
    }

    .header-user-avatar img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .header-user-name {
        font-weight: 500;
        font-size: 0.875rem;
        color: var(--bs-text);
    }

    .user-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 0.5rem;
        min-width: 240px;
        background-color: var(--bs-background);
        border: 1px solid var(--bs-border);
        border-radius: 0.5rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        padding: 0.5rem;
        z-index: 50;
    }

    .dropdown-backdrop {
        position: fixed;
        inset: 0;
        z-index: 40;
    }

    .dropdown-header {
        padding: 0.75rem;
    }

    .dropdown-user-info {
        display: flex;
        flex-direction: column;
    }

    .dropdown-user-name {
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--bs-text);
    }

    .dropdown-user-email {
        font-size: 0.75rem;
        color: var(--bs-text-subtle);
    }

    .dropdown-divider {
        height: 1px;
        background-color: var(--bs-border);
        margin: 0.25rem 0;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        padding: 0.5rem 0.75rem;
        background: transparent;
        border: none;
        font-size: 0.875rem;
        color: var(--bs-text);
        border-radius: 0.375rem;
        cursor: pointer;
        transition: background-color 0.2s;
        text-align: left;
    }

    .dropdown-item:hover {
        background-color: var(--bs-gray-100);
    }

    .dropdown-item-danger {
        color: var(--bs-error);
    }

    /* Mobile styles */
    @@media (max-width: 768px) {
        .app-header {
            left: 0;
            padding: 0 1rem;
        }

        .header-menu-toggle {
            display: block;
        }

        .header-center {
            display: none;
        }

        .breadcrumb {
            display: none;
        }

        .header-user-name {
            display: none;
        }
    }

    @@media (max-width: 480px) {
        .header-icon-btn span {
            font-size: 1.25rem;
        }
    }
</style>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public List<BreadcrumbItem>? Breadcrumbs { get; set; }

    private bool isUserDropdownOpen = false;
    private string searchQuery = "";
    private int unreadNotifications = 3;
    private string userName = "";
    private string userEmail = "";
    private string? userPictureUrl = null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            userName = authState.User.Identity.Name ?? "User";
            userEmail = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
            userPictureUrl = authState.User.FindFirst("picture")?.Value;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await base.OnAfterRenderAsync(firstRender);
        }
    }

    private void ToggleUserDropdown()
    {
        isUserDropdownOpen = !isUserDropdownOpen;
    }

    private void CloseDropdown()
    {
        isUserDropdownOpen = false;
    }

    private async Task Search()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            Navigation.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}");
        }
    }

    private void NavigateTo(string url)
    {
        isUserDropdownOpen = false;
        Navigation.NavigateTo(url);
    }

    private void ShowHelp()
    {
        Navigation.NavigateTo("/help");
    }

    private void ShowKeyboardShortcuts()
    {
        isUserDropdownOpen = false;
        Navigation.NavigateTo("/shortcuts");
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", forceLoad: true);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name[0].ToString().ToUpper();
    }

    public class BreadcrumbItem
    {
        public string Text { get; set; } = "";
        public string? Link { get; set; }
    }
}