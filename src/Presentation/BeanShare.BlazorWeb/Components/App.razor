<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
    (function(){
        var s=localStorage.getItem('beanshare-theme')||'light';
        document.documentElement.setAttribute('data-theme',s);
        var applying=false;
        new MutationObserver(function(){
            if(applying)return;
            var c=document.documentElement.getAttribute('data-theme');
            var want=localStorage.getItem('beanshare-theme')||'light';
            if(c!==want){applying=true;document.documentElement.setAttribute('data-theme',want);applying=false;}
        }).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme','lang']});
    })();
    </script>
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BeanShare.BlazorWeb.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="alternate icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    <link rel="stylesheet" href="_content/BeanShare.SharedUi/css/beanshare.css" />
    <link rel="stylesheet" href="_content/BeanShare.SharedUi/css/components/dashboard.css" />
    <link rel="stylesheet" href="_content/BeanShare.SharedUi/css/components/layout.css" />
    <link rel="stylesheet" href="_content/BeanShare.SharedUi/css/components/pages.css" />
    <link rel="stylesheet" href="_content/BeanShare.SharedUi/css/components/admin.css" />
    <link rel="stylesheet" href="_content/BeanShare.SharedUi/css/components/consumption.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="_content/BeanShare.SharedUi/js/theme.js"></script>
    <script src="_content/BeanShare.SharedUi/js/qrcode.js"></script>
    <script src="_content/BeanShare.SharedUi/js/html5-qrcode.min.js"></script>
    <script src="_content/BeanShare.SharedUi/js/qrscanner.js"></script>
    <script src="js/app.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
