@page "/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MediatR
@using BeanShare.Application.Abstractions
@using BeanShare.Application.Features.Analytics.Queries.GetUserStatistics
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Domain.Common
@using BeanShare.Domain.ValueObjects
@using System.Linq
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IMediator Mediator
@inject IUserContext UserContext
@attribute [Authorize]

<PageTitle>Dashboard - BeanShare</PageTitle>

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h1>Your Coffee Dashboard</h1>
            <p class="subtitle">Track your consumption and insights</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading your dashboard...</p>
        </div>
    }
    else if (statistics == null)
    {
        <div class="empty-state">
            <span class="material-symbols-outlined">coffee</span>
            <h2>No Data Yet</h2>
            <p>Start tracking your coffee consumption to see analytics here!</p>
            <button class="btn-primary" @onclick="NavigateToSpaces">
                <span class="material-symbols-outlined">add</span>
                Join a Space
            </button>
        </div>
    }
    else
    {
        <!-- KPI Cards -->
        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <span class="material-symbols-outlined">local_cafe</span>
                </div>
                <div class="kpi-content">
                    <div class="kpi-label">Total Cups</div>
                    <div class="kpi-value">@statistics.TotalCups</div>
                    <div class="kpi-subtitle">All time</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <span class="material-symbols-outlined">calendar_month</span>
                </div>
                <div class="kpi-content">
                    <div class="kpi-label">This Month</div>
                    <div class="kpi-value">@statistics.CupsThisMonth</div>
                    <div class="kpi-subtitle">@GetMonthName()</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <span class="material-symbols-outlined">trending_up</span>
                </div>
                <div class="kpi-content">
                    <div class="kpi-label">Daily Average</div>
                    <div class="kpi-value">@statistics.AverageCupsPerDay.ToString("F1")</div>
                    <div class="kpi-subtitle">Cups per day</div>
                </div>
            </div>

            <div class="kpi-card">
                <div class="kpi-icon" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                    <span class="material-symbols-outlined">payments</span>
                </div>
                <div class="kpi-content">
                    <div class="kpi-label">Total Cost</div>
                    @if (statistics.TotalCost != null)
                    {
                        <div class="kpi-value">@statistics.TotalCost.Currency.FormatAmount(statistics.TotalCost.Amount)</div>
                        @if (!statistics.IsCostFullyConverted && statistics.CostBreakdown.Any())
                        {
                            <div class="kpi-subtitle kpi-warning" @onclick="ToggleCurrencyBreakdown" style="cursor: pointer;">
                                <span class="material-symbols-outlined" style="font-size: 0.875rem; vertical-align: middle;">info</span>
                                Partial conversion (click for details)
                            </div>
                        }
                        else
                        {
                            <div class="kpi-subtitle">All time spending</div>
                        }
                    }
                    else if (statistics.CostBreakdown.Any())
                    {
                        <div class="kpi-value kpi-multi-currency" @onclick="ToggleCurrencyBreakdown" style="cursor: pointer;">
                            Multiple currencies
                        </div>
                        <div class="kpi-subtitle">Click to view breakdown</div>
                    }
                    else
                    {
                        <div class="kpi-value">N/A</div>
                        <div class="kpi-subtitle">No costs recorded</div>
                    }
                </div>
            </div>
        </div>

        <!-- Currency Breakdown Modal -->
        @if (showCurrencyBreakdown && statistics.CostBreakdown.Any())
        {
            <div class="currency-breakdown-overlay" @onclick="ToggleCurrencyBreakdown">
                <div class="currency-breakdown-modal" @onclick:stopPropagation="true">
                    <div class="modal-header">
                        <h3>Cost Breakdown by Currency</h3>
                        <button class="close-btn" @onclick="ToggleCurrencyBreakdown">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        @if (!statistics.IsCostFullyConverted)
                        {
                            <div class="warning-banner">
                                <span class="material-symbols-outlined">warning</span>
                                <span>Some currencies could not be converted. Showing original amounts.</span>
                            </div>
                        }
                        <div class="breakdown-list">
                            @foreach (var breakdown in statistics.CostBreakdown)
                            {
                                <div class="breakdown-item">
                                    <div class="currency-code">@breakdown.CurrencyCode</div>
                                    <div class="amount-info">
                                        <div class="original-amount">@breakdown.OriginalAmount.ToString("N2") @breakdown.CurrencyCode</div>
                                        @if (breakdown.WasConverted && breakdown.ConvertedAmount != null)
                                        {
                                            <div class="converted-amount">
                                                <span class="material-symbols-outlined" style="font-size: 0.875rem;">arrow_forward</span>
                                                @breakdown.ConvertedAmount.Currency.FormatAmount(breakdown.ConvertedAmount.Amount)
                                            </div>
                                        }
                                        else if (!breakdown.WasConverted)
                                        {
                                            <div class="not-converted">
                                                <span class="material-symbols-outlined" style="font-size: 0.875rem;">error</span>
                                                Not converted
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        @if (statistics.TotalCost != null)
                        {
                            <div class="total-row">
                                <div class="total-label">Converted Total:</div>
                                <div class="total-value">@statistics.TotalCost.Currency.FormatAmount(statistics.TotalCost.Amount)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Charts Section -->
        <div class="charts-row">
            <!-- Consumption Trend -->
            <div class="chart-card">
                <div class="chart-header">
                    <h2>30-Day Consumption Trend</h2>
                    <span class="material-symbols-outlined">show_chart</span>
                </div>
                <div class="chart-content">
                    @if (statistics.DailyConsumptionTrend.Any())
                    {
                        <div class="bar-chart">
                            @{
                                var maxValue = statistics.DailyConsumptionTrend.Values.Max();
                                var last30Days = Enumerable.Range(0, 30)
                                    .Select(i => DateTime.UtcNow.Date.AddDays(-29 + i))
                                    .ToList();
                            }
                            @foreach (var day in last30Days)
                            {
                                var count = statistics.DailyConsumptionTrend.ContainsKey(day)
                                    ? statistics.DailyConsumptionTrend[day]
                                    : 0;
                                var height = maxValue > 0 ? (count * 100.0 / maxValue) : 0;
                                <div class="bar-container" title="@day.ToString("MMM dd"): @count cups">
                                    <div class="bar" style="height: @(height)%;">
                                        @if (count > 0)
                                        {
                                            <span class="bar-value">@count</span>
                                        }
                                    </div>
                                    <div class="bar-label">@day.Day</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="chart-empty">
                            <span class="material-symbols-outlined">insert_chart</span>
                            <p>No consumption data available</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Coffee Types -->
            <div class="chart-card">
                <div class="chart-header">
                    <h2>Favorite Coffee Types</h2>
                    <span class="material-symbols-outlined">coffee_maker</span>
                </div>
                <div class="chart-content">
                    @if (statistics.CoffeeTypeBreakdown.Any())
                    {
                        <div class="coffee-types-list">
                            @{
                                var totalCups = statistics.CoffeeTypeBreakdown.Values.Sum();
                                var topTypes = statistics.CoffeeTypeBreakdown.Take(5);
                            }
                            @foreach (var (coffeeName, count) in topTypes)
                            {
                                var percentage = totalCups > 0 ? (count * 100.0 / totalCups) : 0;
                                <div class="coffee-type-item">
                                    <div class="coffee-type-info">
                                        <div class="coffee-type-name">@coffeeName</div>
                                        <div class="coffee-type-count">@count cups (@percentage.ToString("F1")%)</div>
                                    </div>
                                    <div class="coffee-type-bar">
                                        <div class="coffee-type-fill" style="width: @(percentage)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="chart-empty">
                            <span class="material-symbols-outlined">coffee</span>
                            <p>No coffee types recorded yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Additional Stats -->
        <div class="stats-row">
            <div class="stat-card-large">
                <div class="stat-icon-large">
                    <span class="material-symbols-outlined">emoji_events</span>
                </div>
                <div class="stat-content-large">
                    <h3>Most Consumed</h3>
                    <p class="stat-value-large">@(statistics.MostConsumedCoffeeType ?? "None yet")</p>
                    <p class="stat-subtitle">Your go-to coffee</p>
                </div>
            </div>

            <div class="stat-card-large">
                <div class="stat-icon-large">
                    <span class="material-symbols-outlined">today</span>
                </div>
                <div class="stat-content-large">
                    <h3>Today's Count</h3>
                    <p class="stat-value-large">@statistics.CupsToday</p>
                    <p class="stat-subtitle">Cups consumed today</p>
                </div>
            </div>

            <div class="stat-card-large">
                <div class="stat-icon-large">
                    <span class="material-symbols-outlined">calendar_today</span>
                </div>
                <div class="stat-content-large">
                    <h3>This Week</h3>
                    <p class="stat-value-large">@statistics.CupsThisWeek</p>
                    <p class="stat-subtitle">Cups this week</p>
                </div>
            </div>

            <div class="stat-card-large">
                <div class="stat-icon-large">
                    <span class="material-symbols-outlined">groups</span>
                </div>
                <div class="stat-content-large">
                    <h3>Active Spaces</h3>
                    <p class="stat-value-large">@statistics.ActiveSpacesCount</p>
                    <p class="stat-subtitle">Spaces you're in</p>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="quick-actions">
            <h2>Quick Actions</h2>
            <div class="action-buttons">
                <button class="action-btn" @onclick="NavigateToSpaces">
                    <span class="material-symbols-outlined">groups</span>
                    <span>My Spaces</span>
                </button>
                <button class="action-btn" @onclick="NavigateToProfile">
                    <span class="material-symbols-outlined">person</span>
                    <span>View Profile</span>
                </button>
            </div>
        </div>
    }
</div>

@* Styles extracted to _content/BeanShare.SharedUi/css/components/dashboard.css *@

@code {
    private UserStatisticsDto? statistics;
    private bool isLoading = true;
    private bool showCurrencyBreakdown = false;

    private void ToggleCurrencyBreakdown()
    {
        showCurrencyBreakdown = !showCurrencyBreakdown;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        try
        {
            var currentUserId = UserContext.CurrentUserId;
            if (currentUserId.Value != Guid.Empty)
            {
                var query = new GetUserStatisticsQuery(currentUserId);
                statistics = await Mediator.Send(query);
            }
        }
        catch
        {
            statistics = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetMonthName()
    {
        return DateTime.Now.ToString("MMMM yyyy");
    }

    private void NavigateToSpaces()
    {
        Navigation.NavigateTo("/spaces");
    }

    private void NavigateToProfile()
    {
        Navigation.NavigateTo("/profile");
    }
}
