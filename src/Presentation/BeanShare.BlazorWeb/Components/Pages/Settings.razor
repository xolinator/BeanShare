@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BeanShare.SharedUi.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IThemeService ThemeService
@inject IConfiguration Configuration
@attribute [Authorize]

<PageTitle>Settings - BeanShare</PageTitle>

<div class="settings-container">
    <div class="settings-header">
        <h1>Settings</h1>
        <p>Manage your account preferences and application settings</p>
    </div>

    <div class="settings-content">
        <div class="settings-nav">
            <button class="@GetNavClass("appearance")" @onclick='() => SetActiveTab("appearance")'>
                <span class="material-symbols-outlined">palette</span>
                Appearance
            </button>
            <button class="@GetNavClass("privacy")" @onclick='() => SetActiveTab("privacy")'>
                <span class="material-symbols-outlined">lock</span>
                Privacy & Security
            </button>
        </div>

        <div class="settings-panel">
            @switch(activeTab)
            {
                case "appearance":
                    <div class="panel-content">
                        <h2>Appearance</h2>
                        <p class="panel-description">Customize how BeanShare looks and feels</p>

                        <div class="setting-group">
                            <h3>Theme</h3>
                            <div class="theme-selector">
                                <label class="theme-option @(theme == "light" ? "active" : "")">
                                    <input type="radio" name="theme" checked="@(theme == "light")"
                                           @onchange='() => SetTheme("light")' />
                                    <div class="theme-preview light-preview">
                                        <span class="material-symbols-outlined">light_mode</span>
                                    </div>
                                    <span>Light</span>
                                </label>
                                <label class="theme-option @(theme == "dark" ? "active" : "")">
                                    <input type="radio" name="theme" checked="@(theme == "dark")"
                                           @onchange='() => SetTheme("dark")' />
                                    <div class="theme-preview dark-preview">
                                        <span class="material-symbols-outlined">dark_mode</span>
                                    </div>
                                    <span>Dark</span>
                                </label>
                                <label class="theme-option @(theme == "auto" ? "active" : "")">
                                    <input type="radio" name="theme" checked="@(theme == "auto")"
                                           @onchange='() => SetTheme("auto")' />
                                    <div class="theme-preview auto-preview">
                                        <span class="material-symbols-outlined">brightness_auto</span>
                                    </div>
                                    <span>Auto</span>
                                </label>
                            </div>
                        </div>

                    </div>
                    break;

                case "privacy":
                    <div class="panel-content">
                        <h2>Privacy & Security</h2>
                        <p class="panel-description">Manage your privacy settings and account security</p>

                        <div class="setting-group">
                            <h3>Password</h3>
                            <button class="btn-secondary" @onclick="ChangePassword">
                                <span class="material-symbols-outlined">lock</span>
                                Change Password
                            </button>
                        </div>

                        <div class="setting-group">
                            <h3>Connected Accounts</h3>
                            <div class="connected-accounts">
                                <div class="account-item">
                                    <div class="account-info">
                                        <div style="width: 24px; height: 24px; border-radius: 50%; background: #4285f4; color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;">@_connectedAccountBadge</div>
                                        <span>@_connectedAccountName</span>
                                    </div>
                                    <span style="color: var(--bs-text-subtle); font-size: 0.875rem;">@_connectedAccountDescription</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    break;

            }

            <div class="panel-footer">
                <button class="btn-secondary" @onclick="Cancel">Cancel</button>
                <button class="btn-primary" @onclick="SaveSettings">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@if (showPasswordModal)
{
    <div class="modal-overlay" @onclick="ClosePasswordModal">
        <div class="modal" @onclick:stopPropagation="true" @ontouchend:stopPropagation="true">
            <div class="modal-header">
                <h2>Change Password</h2>
                <button class="modal-close" @onclick="ClosePasswordModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-content">
                <div class="form-group">
                    <label>Current Password</label>
                    <input type="password" @bind="currentPassword" placeholder="Enter current password" />
                </div>
                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" @bind="newPassword" placeholder="Enter new password" />
                </div>
                <div class="form-group">
                    <label>Confirm New Password</label>
                    <input type="password" @bind="confirmPassword" placeholder="Confirm new password" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="ClosePasswordModal">Cancel</button>
                <button class="btn-primary" @onclick="UpdatePassword">Update Password</button>
            </div>
        </div>
    </div>
}


@code {
    private string activeTab = "appearance";

    private string theme = "light";

    private bool notifyNewCoffee = true;
    private bool notifyLowStock = true;
    private bool notifyInvitations = true;
    private bool notifyWeeklySummary = false;

    private string language = "en";
    private string timeZone = "UTC";
    private string dateFormat = "MM/DD/YYYY";

    private bool showPasswordModal = false;
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private bool useOidc;
    private string oidcProviderDisplayName = "your identity provider";
    private string _connectedAccountName = "Email & password";
    private string _connectedAccountDescription = "Managed directly by BeanShare";
    private string _connectedAccountBadge = "B";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        useOidc = Configuration.GetValue<bool>("UseOidc", false);
        oidcProviderDisplayName = ResolveOidcProviderDisplayName();
        ConfigureConnectedAccountCard();
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        theme = await ThemeService.GetThemeAsync();
    }

    private string GetNavClass(string tab)
    {
        return tab == activeTab ? "active" : "";
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task SetTheme(string newTheme)
    {
        theme = newTheme;
        await ThemeService.SetThemeAsync(newTheme);
    }

    private void ChangePassword()
    {
        showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
    }

    private async Task UpdatePassword()
    {
        if (string.IsNullOrEmpty(currentPassword) || string.IsNullOrEmpty(newPassword))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please fill in all password fields.");
            return;
        }
        if (newPassword != confirmPassword)
        {
            await JSRuntime.InvokeVoidAsync("alert", "New password and confirmation do not match.");
            return;
        }
        // Password management is handled by the identity provider
        var passwordManagerName = useOidc ? oidcProviderDisplayName : "BeanShare";
        await JSRuntime.InvokeVoidAsync("alert", $"Password changes are managed through {passwordManagerName}.");
        ClosePasswordModal();
    }

    private void ConfigureConnectedAccountCard()
    {
        if (useOidc)
        {
            _connectedAccountName = oidcProviderDisplayName;
            _connectedAccountDescription = "Connected via OpenID Connect";
            _connectedAccountBadge = GetProviderBadge(oidcProviderDisplayName);
            return;
        }

        _connectedAccountName = "Email & password";
        _connectedAccountDescription = "Managed directly by BeanShare";
        _connectedAccountBadge = "B";
    }

    private string ResolveOidcProviderDisplayName()
    {
        var configuredDisplayName = Configuration["Oidc:ProviderDisplayName"];
        if (!string.IsNullOrWhiteSpace(configuredDisplayName))
        {
            return configuredDisplayName;
        }

        var authority = Configuration["Oidc:Authority"];
        if (Uri.TryCreate(authority, UriKind.Absolute, out var authorityUri))
        {
            return authorityUri.Host;
        }

        return "your identity provider";
    }

    private static string GetProviderBadge(string value)
    {
        var first = value.Trim().FirstOrDefault(char.IsLetterOrDigit);
        return first == default ? "I" : char.ToUpperInvariant(first).ToString();
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }

    private async Task SaveSettings()
    {
        // Theme is already saved via ThemeService.SetThemeAsync when selected.
        // Notification preferences, language, timezone, and date format are not yet persisted on backend.
        await ThemeService.SetThemeAsync(theme);
        Navigation.NavigateTo("/");
    }
}
