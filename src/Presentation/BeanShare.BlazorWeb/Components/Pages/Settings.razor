@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using BeanShare.SharedUi.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IThemeService ThemeService
@attribute [Authorize]

<PageTitle>Settings - BeanShare</PageTitle>

<div class="settings-container">
    <div class="settings-header">
        <h1>Settings</h1>
        <p>Manage your account preferences and application settings</p>
    </div>

    <div class="settings-content">
        <div class="settings-nav">
            <button class="@GetNavClass("appearance")" @onclick='() => SetActiveTab("appearance")'>
                <span class="material-symbols-outlined">palette</span>
                Appearance
            </button>
            <button class="@GetNavClass("notifications")" @onclick='() => SetActiveTab("notifications")'>
                <span class="material-symbols-outlined">notifications</span>
                Notifications
            </button>
            <button class="@GetNavClass("privacy")" @onclick='() => SetActiveTab("privacy")'>
                <span class="material-symbols-outlined">lock</span>
                Privacy & Security
            </button>
            <button class="@GetNavClass("advanced")" @onclick='() => SetActiveTab("advanced")'>
                <span class="material-symbols-outlined">settings</span>
                Advanced
            </button>
        </div>

        <div class="settings-panel">
            @switch(activeTab)
            {
                case "appearance":
                    <div class="panel-content">
                        <h2>Appearance</h2>
                        <p class="panel-description">Customize how BeanShare looks and feels</p>

                        <div class="setting-group">
                            <h3>Theme</h3>
                            <div class="theme-selector">
                                <label class="theme-option @(theme == "light" ? "active" : "")">
                                    <input type="radio" name="theme" checked="@(theme == "light")"
                                           @onchange='() => SetTheme("light")' />
                                    <div class="theme-preview light-preview">
                                        <span class="material-symbols-outlined">light_mode</span>
                                    </div>
                                    <span>Light</span>
                                </label>
                                <label class="theme-option @(theme == "dark" ? "active" : "")">
                                    <input type="radio" name="theme" checked="@(theme == "dark")"
                                           @onchange='() => SetTheme("dark")' />
                                    <div class="theme-preview dark-preview">
                                        <span class="material-symbols-outlined">dark_mode</span>
                                    </div>
                                    <span>Dark</span>
                                </label>
                                <label class="theme-option @(theme == "auto" ? "active" : "")">
                                    <input type="radio" name="theme" checked="@(theme == "auto")"
                                           @onchange='() => SetTheme("auto")' />
                                    <div class="theme-preview auto-preview">
                                        <span class="material-symbols-outlined">brightness_auto</span>
                                    </div>
                                    <span>Auto</span>
                                </label>
                            </div>
                        </div>

                    </div>
                    break;

                case "notifications":
                    <div class="panel-content">
                        <h2>Notifications</h2>
                        <p class="panel-description">Control when and how you receive notifications</p>

                        <div class="setting-group">
                            <h3>Email Notifications</h3>
                            <div class="toggle-list">
                                <div class="toggle-item">
                                    <div>
                                        <label>New Coffee Added</label>
                                        <p>When someone adds coffee to your space</p>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="notifyNewCoffee" />
                                        <span class="slider"></span>
                                    </label>
                                </div>
                                <div class="toggle-item">
                                    <div>
                                        <label>Low Stock Alert</label>
                                        <p>When coffee stock is running low</p>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="notifyLowStock" />
                                        <span class="slider"></span>
                                    </label>
                                </div>
                                <div class="toggle-item">
                                    <div>
                                        <label>Space Invitations</label>
                                        <p>When you're invited to join a space</p>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="notifyInvitations" />
                                        <span class="slider"></span>
                                    </label>
                                </div>
                                <div class="toggle-item">
                                    <div>
                                        <label>Weekly Summary</label>
                                        <p>Weekly coffee consumption report</p>
                                    </div>
                                    <label class="switch">
                                        <input type="checkbox" @bind="notifyWeeklySummary" />
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    break;

                case "privacy":
                    <div class="panel-content">
                        <h2>Privacy & Security</h2>
                        <p class="panel-description">Manage your privacy settings and account security</p>

                        <div class="setting-group">
                            <h3>Password</h3>
                            <button class="btn-secondary" @onclick="ChangePassword">
                                <span class="material-symbols-outlined">lock</span>
                                Change Password
                            </button>
                        </div>

                        <div class="setting-group">
                            <h3>Connected Accounts</h3>
                            <div class="connected-accounts">
                                <div class="account-item">
                                    <div class="account-info">
                                        <div style="width: 24px; height: 24px; border-radius: 50%; background: #4285f4; color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;">G</div>
                                        <span>Google</span>
                                    </div>
                                    <button class="btn-secondary" disabled title="OAuth integration coming soon">Connect</button>
                                </div>
                                <div class="account-item">
                                    <div class="account-info">
                                        <div style="width: 24px; height: 24px; border-radius: 50%; background: #1877f2; color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;">f</div>
                                        <span>Facebook</span>
                                    </div>
                                    <button class="btn-secondary" disabled title="OAuth integration coming soon">Connect</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    break;

                case "advanced":
                    <div class="panel-content">
                        <h2>Advanced Settings</h2>
                        <p class="panel-description">Advanced configuration options</p>

                        <div class="setting-group">
                            <h3>Language & Region</h3>
                            <div class="input-group">
                                <label>Language</label>
                                <select @bind="language">
                                    <option value="en">English</option>
                                    <option value="de">Deutsch</option>
                                    <option value="fr">Français</option>
                                    <option value="es">Español</option>
                                </select>
                            </div>
                            <div class="input-group">
                                <label>Time Zone</label>
                                <select @bind="timeZone">
                                    <option value="UTC">UTC</option>
                                    <option value="EST">Eastern Time</option>
                                    <option value="CST">Central Time</option>
                                    <option value="PST">Pacific Time</option>
                                    <option value="CET">Central European Time</option>
                                </select>
                            </div>
                            <div class="input-group">
                                <label>Date Format</label>
                                <select @bind="dateFormat">
                                    <option value="MM/DD/YYYY">MM/DD/YYYY</option>
                                    <option value="DD/MM/YYYY">DD/MM/YYYY</option>
                                    <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                                </select>
                            </div>
                        </div>

                        <div class="setting-group">
                            <h3>Data & Storage</h3>
                            <div class="storage-info">
                                <div class="storage-bar">
                                    <div class="storage-used" style="width: 35%"></div>
                                </div>
                                <p>350 MB of 1 GB used</p>
                            </div>
                            <button class="btn-secondary" disabled title="Feature coming soon">Clear Cache</button>
                        </div>

                        <div class="setting-group">
                            <h3>Export Data</h3>
                            <p>Download all your BeanShare data</p>
                            <button class="btn-secondary" disabled title="Feature coming soon">
                                <span class="material-symbols-outlined">download</span>
                                Export as JSON
                            </button>
                        </div>
                    </div>
                    break;
            }

            <div class="panel-footer">
                <button class="btn-secondary" @onclick="Cancel">Cancel</button>
                <button class="btn-primary" @onclick="SaveSettings">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@if (showPasswordModal)
{
    <div class="modal-overlay" @onclick="ClosePasswordModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Change Password</h2>
                <button class="modal-close" @onclick="ClosePasswordModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-content">
                <div class="form-group">
                    <label>Current Password</label>
                    <input type="password" @bind="currentPassword" placeholder="Enter current password" />
                </div>
                <div class="form-group">
                    <label>New Password</label>
                    <input type="password" @bind="newPassword" placeholder="Enter new password" />
                </div>
                <div class="form-group">
                    <label>Confirm New Password</label>
                    <input type="password" @bind="confirmPassword" placeholder="Confirm new password" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="ClosePasswordModal">Cancel</button>
                <button class="btn-primary" @onclick="UpdatePassword">Update Password</button>
            </div>
        </div>
    </div>
}


@code {
    private string activeTab = "appearance";

    private string theme = "light";

    private bool notifyNewCoffee = true;
    private bool notifyLowStock = true;
    private bool notifyInvitations = true;
    private bool notifyWeeklySummary = false;

    private string language = "en";
    private string timeZone = "UTC";
    private string dateFormat = "MM/DD/YYYY";

    private bool showPasswordModal = false;
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        theme = await ThemeService.GetThemeAsync();
    }

    private string GetNavClass(string tab)
    {
        return tab == activeTab ? "active" : "";
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task SetTheme(string newTheme)
    {
        theme = newTheme;
        await ThemeService.SetThemeAsync(newTheme);
    }

    private void ChangePassword()
    {
        showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
    }

    private async Task UpdatePassword()
    {
        if (string.IsNullOrEmpty(currentPassword) || string.IsNullOrEmpty(newPassword))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please fill in all password fields.");
            return;
        }
        if (newPassword != confirmPassword)
        {
            await JSRuntime.InvokeVoidAsync("alert", "New password and confirmation do not match.");
            return;
        }
        // Password management is handled by the identity provider (Keycloak)
        await JSRuntime.InvokeVoidAsync("alert", "Password changes are managed through your identity provider. Please use Keycloak to update your password.");
        ClosePasswordModal();
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }

    private async Task SaveSettings()
    {
        // Theme is already saved via ThemeService.SetThemeAsync when selected.
        // Notification preferences, language, timezone, and date format are not yet persisted on backend.
        await ThemeService.SetThemeAsync(theme);
        Navigation.NavigateTo("/");
    }
}