@page "/logout"
@attribute [StreamRendering(false)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components.Authorization
@using BeanShare.Application.Features.SemiAuthQr.Commands
@using MediatR
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject IMediator Mediator

<PageTitle>Logging out - BeanShare</PageTitle>

<div class="logout-container">
    <div class="logout-card">
        <div class="logout-spinner">
            <span class="material-symbols-outlined spinning">progress_activity</span>
        </div>
        <h2>Logging out...</h2>
        <p>You are being securely logged out of BeanShare</p>
    </div>
</div>

@* Hidden form that posts to the logout endpoint *@
<form id="logoutForm" method="post" action="/account/logout" style="display:none;">
</form>


@code {
    private bool _submitted = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_submitted)
        {
            _submitted = true;

            try
            {
                var credential = await JSRuntime.InvokeAsync<SemiAuthCredential?>("beanshareSemiAuth.getCredential");
                if (credential != null &&
                    !string.IsNullOrWhiteSpace(credential.DeviceId) &&
                    !string.IsNullOrWhiteSpace(credential.Token))
                {
                    await Mediator.Send(new RevokeSemiAuthQrDeviceTokenCommand(credential.DeviceId, credential.Token));
                }
            }
            catch { }

            try
            {
                await JSRuntime.InvokeVoidAsync("beanshareSemiAuth.clearAll");
                await JSRuntime.InvokeVoidAsync("localStorage.clear");
                await JSRuntime.InvokeVoidAsync("sessionStorage.clear");
            }
            catch { }

            try
            {
                var form = await JSRuntime.InvokeAsync<IJSObjectReference>("document.getElementById", "logoutForm");
                await form.InvokeVoidAsync("submit");
                await form.DisposeAsync();
            }
            catch
            {
                Navigation.NavigateTo("/account/logout", forceLoad: true);
            }
        }
    }

    private sealed class SemiAuthCredential
    {
        public string? DeviceId { get; set; }
        public string? Token { get; set; }
    }
}
