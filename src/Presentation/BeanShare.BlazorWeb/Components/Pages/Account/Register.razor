@page "/register"
@using BeanShare.Infrastructure.Identity
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject IServiceProvider ServiceProvider

<PageTitle>Create Account - BeanShare</PageTitle>

@if (_useOidc)
{
    <HeadContent>
        <meta http-equiv="refresh" content="0; url=@_oidcRegistrationUrl" />
    </HeadContent>
    <div class="bs-login-container">
        <div class="bs-login-card">
            <div class="bs-login-header">
                <h1 class="bs-login-title">Create Your Account</h1>
                <p class="bs-login-subtitle">Redirecting to @_oidcProviderDisplayName for secure registration...</p>
                <noscript>
                    <p><a href="@_oidcRegistrationUrl">Continue with @_oidcProviderDisplayName</a></p>
                </noscript>
            </div>
        </div>
    </div>
}
else
{
    <div class="bs-login-container">
        <div class="bs-login-card">
            <div class="bs-login-header">
                <h1 class="bs-login-title">Create Your Account</h1>
                <p class="bs-login-subtitle">Join BeanShare to manage your coffee spaces</p>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="bs-alert bs-alert-error">
                    @_errorMessage
                </div>
            }

            <EditForm Model="@_model" OnValidSubmit="@HandleRegister" FormName="RegisterForm">
                <DataAnnotationsValidator />

                <div class="bs-form-group">
                    <label class="bs-label" for="name">Full Name</label>
                    <InputText id="name" @bind-Value="_model!.Name" class="bs-input" placeholder="John Doe" />
                    <ValidationMessage For="@(() => _model!.Name)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="email">Email</label>
                    <InputText id="email" @bind-Value="_model!.Email" class="bs-input" placeholder="you@example.com" />
                    <ValidationMessage For="@(() => _model!.Email)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="password">Password</label>
                    <InputText id="password" type="password" @bind-Value="_model!.Password" class="bs-input" placeholder="At least 8 characters" />
                    <ValidationMessage For="@(() => _model!.Password)" class="bs-validation-message" />
                </div>

                <div class="bs-form-group">
                    <label class="bs-label" for="confirmPassword">Confirm Password</label>
                    <InputText id="confirmPassword" type="password" @bind-Value="_model!.ConfirmPassword" class="bs-input" placeholder="Re-enter your password" />
                    <ValidationMessage For="@(() => _model!.ConfirmPassword)" class="bs-validation-message" />
                </div>

                <button type="submit" class="bs-btn bs-btn-primary bs-w-full" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span>Creating account...</span>
                    }
                    else
                    {
                        <span>Create Account</span>
                    }
                </button>
            </EditForm>

            <div class="bs-divider">
                <span>OR</span>
            </div>

            <div class="bs-login-providers">
                <form action="/account/external-login" method="post">
                    <input type="hidden" name="provider" value="Google" />
                    <input type="hidden" name="returnUrl" value="@GetReturnUrl()" />
                    <button type="submit" class="bs-login-button bs-login-google">
                        <svg class="bs-login-icon" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,10.002,10c8.396,0,10.249-7.85,9.426-11.748L12.545,10.239z"/>
                        </svg>
                        Sign up with Google
                    </button>
                </form>

            </div>

            <div class="bs-login-footer">
                <p class="bs-login-register">
                    Already have an account? <a href="/login?returnUrl=@GetReturnUrl()" class="bs-link">Sign in</a>
                </p>
                <p class="bs-login-terms">
                    By continuing, you agree to BeanShare's Terms of Service and Privacy Policy
                </p>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromForm]
    private RegisterModel? _model { get; set; }

    private bool _isLoading;
    private string? _errorMessage;
    private bool _useOidc;
    private string _oidcRegistrationUrl = "";
    private string _oidcProviderDisplayName = "your identity provider";

    protected override void OnInitialized()
    {
        _model ??= new();
        _useOidc = Configuration.GetValue<bool>("UseOidc", false);
        _oidcProviderDisplayName = ResolveOidcProviderDisplayName();

        if (_useOidc)
        {
            var oidcAuthority = Configuration["Oidc:Authority"] ?? "http://localhost:8080/realms/beanshare";
            var clientId = Configuration["Oidc:ClientId"] ?? "beanshare-web";
            var registrationEndpoint = Configuration["Oidc:RegistrationEndpoint"];
            if (string.IsNullOrEmpty(registrationEndpoint))
                registrationEndpoint = $"{oidcAuthority}/protocol/openid-connect/registrations";
            var request = HttpContextAccessor.HttpContext?.Request;
            var baseUrl =
                request != null
                    ? $"{request.Scheme}://{request.Host}{request.PathBase}"
                    : Navigation.BaseUri.TrimEnd('/');
            _oidcRegistrationUrl = $"{registrationEndpoint}?client_id={clientId}&response_type=code&scope=openid&redirect_uri={Uri.EscapeDataString($"{baseUrl}/signin-oidc")}";
        }
    }

    private string ResolveOidcProviderDisplayName()
    {
        var configuredDisplayName = Configuration["Oidc:ProviderDisplayName"];
        if (!string.IsNullOrWhiteSpace(configuredDisplayName))
        {
            return configuredDisplayName;
        }

        var authority = Configuration["Oidc:Authority"];
        if (Uri.TryCreate(authority, UriKind.Absolute, out var authorityUri))
        {
            return authorityUri.Host;
        }

        return "your identity provider";
    }


    private string GetReturnUrl()
    {
        var returnUrl = HttpContextAccessor.HttpContext?.Request.Query["returnUrl"].ToString();
        return string.IsNullOrEmpty(returnUrl) ? "/spaces" : returnUrl;
    }

    private async Task HandleRegister()
    {
        var authService = ServiceProvider.GetService<IAuthenticationService>();

        if (_useOidc || authService == null)
        {
            _errorMessage = "Registration is handled by the identity provider";
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            if (_model is null) return;

            if (_model.Password != _model.ConfirmPassword)
            {
                _errorMessage = "Passwords do not match";
                _isLoading = false;
                return;
            }

            var result = await authService.RegisterAsync(_model.Email, _model.Name, _model.Password);

            if (result.Success && result.User != null)
            {
                var httpContext = HttpContextAccessor.HttpContext;
                if (httpContext != null)
                {
                    await authService.SignInAsync(httpContext, result.User);
                    Navigation.NavigateTo(GetReturnUrl(), forceLoad: true);
                }
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Registration failed";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred during registration. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class RegisterModel
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(100, ErrorMessage = "Name must be less than 100 characters")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
