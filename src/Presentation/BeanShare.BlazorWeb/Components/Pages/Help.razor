@page "/help"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Help & Support - BeanShare</PageTitle>

<div class="bs-container" style="max-width: 1000px; margin: 0 auto; padding: 2rem 1rem;">
    <h1 class="bs-font-bold" style="font-size: 2rem; margin-bottom: 2rem;">Help & Support</h1>

    <div class="bs-grid bs-gap-6">
        <!-- Getting Started -->
        <div class="bs-card">
            <h2 class="bs-font-bold" style="font-size: 1.5rem; margin-bottom: 1rem;">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 0.5rem;">rocket_launch</span>
                Getting Started
            </h2>
            <div class="bs-flex bs-flex-col bs-gap-4">
                <div>
                    <h3 class="bs-font-medium" style="margin-bottom: 0.5rem;">1. Join or Create a Space</h3>
                    <p class="bs-text-subtle">Start by creating a new coffee space for your team or joining an existing one using an invite code.</p>
                </div>
                <div>
                    <h3 class="bs-font-medium" style="margin-bottom: 0.5rem;">2. Track Stock Purchases</h3>
                    <p class="bs-text-subtle">Add coffee purchases to track inventory and costs across your team.</p>
                </div>
                <div>
                    <h3 class="bs-font-medium" style="margin-bottom: 0.5rem;">3. Log Consumption</h3>
                    <p class="bs-text-subtle">Record your coffee consumption to help with accurate billing and analytics.</p>
                </div>
            </div>
        </div>

        <!-- Key Features -->
        <div class="bs-card">
            <h2 class="bs-font-bold" style="font-size: 1.5rem; margin-bottom: 1rem;">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 0.5rem;">stars</span>
                Key Features
            </h2>
            <div class="bs-grid bs-grid-cols-1 md:bs-grid-cols-2 bs-gap-4">
                <div>
                    <h3 class="bs-font-medium bs-flex bs-items-center bs-gap-2">
                        <span class="material-symbols-outlined" style="color: var(--bs-primary);">groups</span>
                        Space Management
                    </h3>
                    <p class="bs-text-subtle">Create and manage coffee spaces with your team members.</p>
                </div>
                <div>
                    <h3 class="bs-font-medium bs-flex bs-items-center bs-gap-2">
                        <span class="material-symbols-outlined" style="color: var(--bs-primary);">inventory_2</span>
                        Stock Tracking
                    </h3>
                    <p class="bs-text-subtle">Monitor coffee inventory levels and purchase history.</p>
                </div>
                <div>
                    <h3 class="bs-font-medium bs-flex bs-items-center bs-gap-2">
                        <span class="material-symbols-outlined" style="color: var(--bs-primary);">coffee</span>
                        Consumption Logging
                    </h3>
                    <p class="bs-text-subtle">Track individual and team coffee consumption patterns.</p>
                </div>
                <div>
                    <h3 class="bs-font-medium bs-flex bs-items-center bs-gap-2">
                        <span class="material-symbols-outlined" style="color: var(--bs-primary);">receipt_long</span>
                        Billing & Settlement
                    </h3>
                    <p class="bs-text-subtle">Automatic cost calculation and fair billing distribution.</p>
                </div>
                <div>
                    <h3 class="bs-font-medium bs-flex bs-items-center bs-gap-2">
                        <span class="material-symbols-outlined" style="color: var(--bs-primary);">analytics</span>
                        Analytics Dashboard
                    </h3>
                    <p class="bs-text-subtle">Insights into consumption patterns and spending trends.</p>
                </div>
                <div>
                    <h3 class="bs-font-medium bs-flex bs-items-center bs-gap-2">
                        <span class="material-symbols-outlined" style="color: var(--bs-primary);">bookmark</span>
                        Preset Recipes
                    </h3>
                    <p class="bs-text-subtle" style="color: var(--bs-warning);">Coming soon - Save favorite coffee preparations.</p>
                </div>
            </div>
        </div>

        <!-- Keyboard Shortcuts -->
        <div class="bs-card">
            <h2 class="bs-font-bold" style="font-size: 1.5rem; margin-bottom: 1rem;">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 0.5rem;">keyboard</span>
                Keyboard Shortcuts
            </h2>
            <div class="bs-grid bs-grid-cols-1 md:bs-grid-cols-2 bs-gap-3">
                <div class="bs-flex bs-justify-between">
                    <span>Quick consumption log</span>
                    <kbd style="background: var(--bs-gray-200); padding: 0.25rem 0.5rem; border-radius: 0.25rem;">Ctrl + L</kbd>
                </div>
                <div class="bs-flex bs-justify-between">
                    <span>Navigate to spaces</span>
                    <kbd style="background: var(--bs-gray-200); padding: 0.25rem 0.5rem; border-radius: 0.25rem;">Ctrl + S</kbd>
                </div>
                <div class="bs-flex bs-justify-between">
                    <span>View profile</span>
                    <kbd style="background: var(--bs-gray-200); padding: 0.25rem 0.5rem; border-radius: 0.25rem;">Ctrl + P</kbd>
                </div>
                <div class="bs-flex bs-justify-between">
                    <span>Toggle theme</span>
                    <kbd style="background: var(--bs-gray-200); padding: 0.25rem 0.5rem; border-radius: 0.25rem;">Ctrl + T</kbd>
                </div>
            </div>
        </div>

        <!-- FAQs -->
        <div class="bs-card">
            <h2 class="bs-font-bold" style="font-size: 1.5rem; margin-bottom: 1rem;">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 0.5rem;">quiz</span>
                Frequently Asked Questions
            </h2>
            <div class="bs-flex bs-flex-col bs-gap-4">
                <details class="bs-faq-item">
                    <summary class="bs-font-medium" style="cursor: pointer; padding: 0.5rem 0;">How is the coffee cost calculated?</summary>
                    <p class="bs-text-subtle" style="margin-top: 0.5rem; padding-left: 1rem;">
                        Coffee costs are calculated using a weighted average method based on stock purchases. When you consume coffee,
                        the system automatically calculates your share based on the amount consumed and current stock prices.
                    </p>
                </details>
                <details class="bs-faq-item">
                    <summary class="bs-font-medium" style="cursor: pointer; padding: 0.5rem 0;">What happens during billing settlement?</summary>
                    <p class="bs-text-subtle" style="margin-top: 0.5rem; padding-left: 1rem;">
                        At the end of each billing period, the system calculates each member's consumption and their proportional
                        share of the total costs. Settlement reports show who owes what to maintain fair cost distribution.
                    </p>
                </details>
                <details class="bs-faq-item">
                    <summary class="bs-font-medium" style="cursor: pointer; padding: 0.5rem 0;">Can I track different coffee types?</summary>
                    <p class="bs-text-subtle" style="margin-top: 0.5rem; padding-left: 1rem;">
                        Yes! You can track multiple coffee types, brands, and preparations. The system maintains separate inventory
                        for each type and provides analytics on consumption preferences.
                    </p>
                </details>
                <details class="bs-faq-item">
                    <summary class="bs-font-medium" style="cursor: pointer; padding: 0.5rem 0;">How do I invite team members?</summary>
                    <p class="bs-text-subtle" style="margin-top: 0.5rem; padding-left: 1rem;">
                        Share the space's invite code with your team members. They can join by entering this code in the
                        "Join Space" section. Space admins can regenerate invite codes if needed.
                    </p>
                </details>
            </div>
        </div>

        <!-- Contact Support -->
        <div class="bs-card">
            <h2 class="bs-font-bold" style="font-size: 1.5rem; margin-bottom: 1rem;">
                <span class="material-symbols-outlined" style="vertical-align: middle; margin-right: 0.5rem;">support_agent</span>
                Need More Help?
            </h2>
            <p class="bs-text-subtle" style="margin-bottom: 1.5rem;">
                If you need additional assistance or have suggestions for improving BeanShare, we're here to help!
            </p>
            <div class="bs-flex bs-flex-col md:bs-flex-row bs-gap-4">
                <a href="mailto:support@beanshare.com" class="bs-btn bs-btn-primary" style="text-decoration: none;">
                    <span class="material-symbols-outlined" style="margin-right: 0.5rem;">mail</span>
                    Email Support
                </a>
                <button class="bs-btn bs-btn-outline">
                    <span class="material-symbols-outlined" style="margin-right: 0.5rem;">bug_report</span>
                    Report an Issue
                </button>
                <button class="bs-btn bs-btn-outline">
                    <span class="material-symbols-outlined" style="margin-right: 0.5rem;">lightbulb</span>
                    Suggest a Feature
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .bs-faq-item {
        border-bottom: 1px solid var(--bs-border);
        padding: 0.5rem 0;
    }

    .bs-faq-item:last-child {
        border-bottom: none;
    }

    details[open] summary {
        color: var(--bs-primary);
    }

    kbd {
        font-family: monospace;
        font-size: 0.875rem;
    }
</style>