@page "/admin/users/{UserId:guid}"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Features.Admin.Users.Queries
@using BeanShare.Application.Features.Admin.Users.Commands
@using BeanShare.Application.Features.Admin.Users.Dtos
@using BeanShare.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>User Details - Admin - BeanShare</PageTitle>

<div class="admin-page">
    <div class="admin-header">
        <button class="back-btn" @onclick="GoBack">
            <span class="material-symbols-outlined">arrow_back</span>
            Back to Users
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="loading-spinner"></div>
            <span>Loading user details...</span>
        </div>
    }
    else if (user == null)
    {
        <div class="empty-state">
            <span class="material-symbols-outlined">person_off</span>
            <h3>User not found</h3>
            <p>The requested user could not be found.</p>
            <button class="bs-btn bs-btn-primary" @onclick="GoBack">Go Back</button>
        </div>
    }
    else
    {
        <div class="user-detail-layout">
            <div class="user-profile-card">
                <div class="user-profile-header">
                    <div class="user-avatar-large">
                        @if (!string.IsNullOrEmpty(user.PictureUrl))
                        {
                            <img src="@user.PictureUrl" alt="@user.Name" />
                        }
                        else
                        {
                            @GetInitials(user.Name)
                        }
                    </div>
                    <h2>@user.Name</h2>
                    <p class="user-email">@user.Email</p>
                    <div class="badges">
                        <span class="role-badge @(user.SystemRole == SystemRole.SystemAdmin ? "role-admin" : "role-user")">
                            @(user.SystemRole == SystemRole.SystemAdmin ? "System Admin" : "User")
                        </span>
                        <span class="status-badge @(user.IsActive ? "status-active" : "status-inactive")">
                            @(user.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>

                <div class="user-actions">
                    @if (user.SystemRole != SystemRole.SystemAdmin)
                    {
                        <button class="action-btn-full promote" @onclick="PromoteUser">
                            <span class="material-symbols-outlined">arrow_upward</span>
                            Promote to Admin
                        </button>
                    }
                    else
                    {
                        <button class="action-btn-full demote" @onclick="DemoteUser">
                            <span class="material-symbols-outlined">arrow_downward</span>
                            Demote to User
                        </button>
                    }
                    @if (user.IsActive)
                    {
                        <button class="action-btn-full deactivate" @onclick="DeactivateUser">
                            <span class="material-symbols-outlined">block</span>
                            Deactivate Account
                        </button>
                    }
                    else
                    {
                        <button class="action-btn-full reactivate" @onclick="ReactivateUser">
                            <span class="material-symbols-outlined">check_circle</span>
                            Reactivate Account
                        </button>
                    }
                </div>
            </div>

            <div class="user-details-section">
                <div class="detail-card">
                    <h3>Account Information</h3>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label">User ID</span>
                            <span class="detail-value monospace">@user.Id</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Auth Provider</span>
                            <span class="detail-value">@user.Provider.ToString()</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Preferred Currency</span>
                            <span class="detail-value">@(user.PreferredCurrencyCode ?? "Not set")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Account Created</span>
                            <span class="detail-value">@user.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Last Login</span>
                            <span class="detail-value">@user.LastLoginAt.ToString("MMMM dd, yyyy 'at' HH:mm")</span>
                        </div>
                        @if (user.DeactivatedAt.HasValue)
                        {
                            <div class="detail-item">
                                <span class="detail-label">Deactivated At</span>
                                <span class="detail-value deactivated">@user.DeactivatedAt.Value.ToString("MMMM dd, yyyy 'at' HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="detail-card">
                    <h3>Space Memberships (@user.Memberships.Count)</h3>
                    @if (user.Memberships.Any())
                    {
                        <div class="memberships-list">
                            @foreach (var membership in user.Memberships)
                            {
                                <div class="membership-item">
                                    <div class="membership-info">
                                        <span class="membership-name">@membership.SpaceName</span>
                                        <span class="membership-role @(membership.Role.ToString() == "Admin" ? "admin" : "member")">
                                            @membership.Role
                                        </span>
                                    </div>
                                    <span class="membership-joined">Joined @membership.JoinedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="no-memberships">
                            <span class="material-symbols-outlined">group_off</span>
                            <p>This user is not a member of any spaces.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />


@code {
    [Parameter]
    public Guid UserId { get; set; }

    private AdminUserDetailDto? user;
    private bool isLoading = true;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async Task LoadUser()
    {
        isLoading = true;
        try
        {
            var result = await Mediator.Send(new GetUserDetailsQuery(UserId));
            if (result.IsSuccess)
            {
                user = result.Value;
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to load user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load user: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/users");
    }

    private async Task PromoteUser()
    {
        try
        {
            var result = await Mediator.Send(new SetUserRoleCommand(UserId, SystemRole.SystemAdmin));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User promoted to System Admin");
                await LoadUser();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to promote user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to promote user: {ex.Message}");
        }
    }

    private async Task DemoteUser()
    {
        try
        {
            var result = await Mediator.Send(new SetUserRoleCommand(UserId, SystemRole.User));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User demoted to regular user");
                await LoadUser();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to demote user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to demote user: {ex.Message}");
        }
    }

    private async Task DeactivateUser()
    {
        try
        {
            var result = await Mediator.Send(new DeactivateUserCommand(UserId));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User deactivated successfully");
                await LoadUser();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to deactivate user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to deactivate user: {ex.Message}");
        }
    }

    private async Task ReactivateUser()
    {
        try
        {
            var result = await Mediator.Send(new ReactivateUserCommand(UserId));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", "User reactivated successfully");
                await LoadUser();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to reactivate user");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to reactivate user: {ex.Message}");
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name[0].ToString().ToUpper();
    }
}
