@page "/admin/presets"
@rendermode InteractiveServer
@using MediatR
@using BeanShare.Application.Features.Admin.Presets.Queries
@using BeanShare.Application.Features.Admin.Presets.Commands
@using BeanShare.Application.Features.Admin.Presets.Dtos
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Global Presets - Admin - BeanShare</PageTitle>

<div class="admin-page">
    <div class="admin-header">
        <div class="header-content">
            <h1>Global Presets</h1>
            <p class="admin-subtitle">Manage default coffee presets available to all users</p>
        </div>
        <button class="bs-btn bs-btn-primary" @onclick="OpenCreateDialog">
            <span class="material-symbols-outlined">add</span>
            Add Preset
        </button>
    </div>

    <div class="admin-filters">
        <div class="filter-group">
            <label>Filter by Status</label>
            <select @bind="statusFilter" @bind:after="ApplyFilters">
                <option value="all">All Presets</option>
                <option value="active">Active Only</option>
                <option value="inactive">Inactive Only</option>
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="loading-spinner"></div>
            <span>Loading presets...</span>
        </div>
    }
    else if (filteredPresets == null || !filteredPresets.Any())
    {
        <div class="empty-state">
            <span class="material-symbols-outlined">coffee</span>
            <h3>No presets found</h3>
            <p>Create your first global preset to get started.</p>
            <button class="bs-btn bs-btn-primary" @onclick="OpenCreateDialog">
                <span class="material-symbols-outlined">add</span>
                Create Preset
            </button>
        </div>
    }
    else
    {
        <div class="presets-grid">
            @foreach (var preset in filteredPresets.OrderBy(p => p.DisplayOrder))
            {
                <div class="preset-card @(preset.IsActive ? "" : "inactive")">
                    <div class="preset-header">
                        <div class="preset-order">#@preset.DisplayOrder</div>
                        <span class="preset-status @(preset.IsActive ? "active" : "inactive")">
                            @(preset.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                    <h3 class="preset-name">@preset.Name</h3>
                    @if (!string.IsNullOrEmpty(preset.Description))
                    {
                        <p class="preset-description">@preset.Description</p>
                    }
                    <div class="preset-details">
                        <div class="detail">
                            <span class="material-symbols-outlined">coffee</span>
                            @preset.DefaultCoffeeType
                        </div>
                        <div class="detail">
                            <span class="material-symbols-outlined">local_cafe</span>
                            @preset.DefaultPreparation
                        </div>
                        <div class="detail">
                            <span class="material-symbols-outlined">scale</span>
                            @preset.DefaultGrams g
                        </div>
                    </div>
                    <div class="preset-footer">
                        <span class="preset-date">Created @preset.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="preset-actions">
                        <button class="action-btn" title="Edit" @onclick="() => OpenEditDialog(preset)">
                            <span class="material-symbols-outlined">edit</span>
                        </button>
                        @if (preset.IsActive)
                        {
                            <button class="action-btn deactivate" title="Deactivate" @onclick="() => TogglePreset(preset.Id, false)">
                                <span class="material-symbols-outlined">visibility_off</span>
                            </button>
                        }
                        else
                        {
                            <button class="action-btn activate" title="Activate" @onclick="() => TogglePreset(preset.Id, true)">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showDialog)
{
    <div class="dialog-backdrop" @onclick="CloseDialog"></div>
    <div class="dialog">
        <div class="dialog-header">
            <h2>@(isEditing ? "Edit Preset" : "Create Preset")</h2>
            <button class="dialog-close" @onclick="CloseDialog">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <EditForm Model="formModel" OnValidSubmit="SavePreset">
            <div class="dialog-content">
                <div class="form-group">
                    <label>Name *</label>
                    <InputText @bind-Value="formModel.Name" class="form-input" placeholder="e.g. Morning Espresso" />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <InputTextArea @bind-Value="formModel.Description" class="form-input" rows="2" placeholder="Optional description" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Coffee Type *</label>
                        <InputText @bind-Value="formModel.DefaultCoffeeType" class="form-input" placeholder="e.g. Espresso" />
                    </div>
                    <div class="form-group">
                        <label>Preparation *</label>
                        <InputText @bind-Value="formModel.DefaultPreparation" class="form-input" placeholder="e.g. Single Shot" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Default Grams *</label>
                        <InputNumber @bind-Value="formModel.DefaultGrams" class="form-input" min="1" max="100" />
                    </div>
                    <div class="form-group">
                        <label>Display Order *</label>
                        <InputNumber @bind-Value="formModel.DisplayOrder" class="form-input" min="1" />
                    </div>
                </div>
            </div>
            <div class="dialog-footer">
                <button type="button" class="bs-btn bs-btn-secondary" @onclick="CloseDialog">Cancel</button>
                <button type="submit" class="bs-btn bs-btn-primary" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="loading-spinner-small"></span>
                    }
                    @(isEditing ? "Save Changes" : "Create Preset")
                </button>
            </div>
        </EditForm>
    </div>
}

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />


@code {
    private List<GlobalPresetDto>? presets;
    private List<GlobalPresetDto>? filteredPresets;
    private bool isLoading = true;
    private string statusFilter = "all";

    private bool showDialog;
    private bool isEditing;
    private bool isSaving;
    private PresetFormModel formModel = new();
    private Guid? editingPresetId;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPresets();
    }

    private async Task LoadPresets()
    {
        isLoading = true;
        try
        {
            var result = await Mediator.Send(new GetAllGlobalPresetsQuery(IncludeInactive: true));
            if (result.IsSuccess)
            {
                presets = result.Value.ToList();
                ApplyFilters();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to load presets");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load presets: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        if (presets == null)
        {
            filteredPresets = null;
            return;
        }

        filteredPresets = statusFilter switch
        {
            "active" => presets.Where(p => p.IsActive).ToList(),
            "inactive" => presets.Where(p => !p.IsActive).ToList(),
            _ => presets.ToList()
        };
    }

    private void OpenCreateDialog()
    {
        isEditing = false;
        editingPresetId = null;
        formModel = new PresetFormModel
        {
            DisplayOrder = (presets?.Count ?? 0) + 1
        };
        showDialog = true;
    }

    private void OpenEditDialog(GlobalPresetDto preset)
    {
        isEditing = true;
        editingPresetId = preset.Id;
        formModel = new PresetFormModel
        {
            Name = preset.Name,
            Description = preset.Description,
            DefaultCoffeeType = preset.DefaultCoffeeType,
            DefaultPreparation = preset.DefaultPreparation,
            DefaultGrams = preset.DefaultGrams,
            DisplayOrder = preset.DisplayOrder
        };
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        formModel = new();
    }

    private async Task SavePreset()
    {
        if (string.IsNullOrWhiteSpace(formModel.Name) ||
            string.IsNullOrWhiteSpace(formModel.DefaultCoffeeType) ||
            string.IsNullOrWhiteSpace(formModel.DefaultPreparation) ||
            formModel.DefaultGrams <= 0)
        {
            ShowToast(true, "Validation Error", "Please fill in all required fields");
            return;
        }

        isSaving = true;
        try
        {
            if (isEditing && editingPresetId.HasValue)
            {
                var result = await Mediator.Send(new UpdateGlobalPresetCommand(
                    editingPresetId.Value,
                    formModel.Name!,
                    formModel.DefaultCoffeeType!,
                    formModel.DefaultPreparation!,
                    formModel.DefaultGrams,
                    formModel.Description,
                    formModel.DisplayOrder));

                if (result.IsSuccess)
                {
                    ShowToast(false, "Success", "Preset updated successfully");
                    CloseDialog();
                    await LoadPresets();
                }
                else
                {
                    ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to update preset");
                }
            }
            else
            {
                var result = await Mediator.Send(new CreateGlobalPresetCommand(
                    formModel.Name!,
                    formModel.DefaultCoffeeType!,
                    formModel.DefaultPreparation!,
                    formModel.DefaultGrams,
                    formModel.Description,
                    formModel.DisplayOrder));

                if (result.IsSuccess)
                {
                    ShowToast(false, "Success", "Preset created successfully");
                    CloseDialog();
                    await LoadPresets();
                }
                else
                {
                    ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to create preset");
                }
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to save preset: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task TogglePreset(Guid presetId, bool activate)
    {
        try
        {
            var result = await Mediator.Send(new ToggleGlobalPresetCommand(presetId, activate));
            if (result.IsSuccess)
            {
                ShowToast(false, "Success", activate ? "Preset activated" : "Preset deactivated");
                await LoadPresets();
            }
            else
            {
                ShowToast(true, "Error", result.Errors.FirstOrDefault().Message ?? "Failed to toggle preset");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to toggle preset: {ex.Message}");
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }

    private class PresetFormModel
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? DefaultCoffeeType { get; set; }
        public string? DefaultPreparation { get; set; }
        public decimal DefaultGrams { get; set; } = 18;
        public int DisplayOrder { get; set; } = 1;
    }
}
