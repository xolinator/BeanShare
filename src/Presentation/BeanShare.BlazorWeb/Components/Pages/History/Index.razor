@page "/history"
@rendermode InteractiveServer
@using BeanShare.Application.Features.Consumption.Dtos
@using BeanShare.Application.Features.Consumption.Queries.GetUserConsumptionHistory
@using BeanShare.Application.Features.Consumption.Commands
@using BeanShare.Application.Features.Spaces.Dtos
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Application.Features.Admin.Users.Queries
@using BeanShare.Application.Features.Admin.Users.Dtos
@using BeanShare.Application.Abstractions
@using MediatR
@inject IMediator Mediator
@inject ILogger<Index> Logger
@inject IUserContext UserContext

<PageTitle>Consumption History</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3">
                <i class="bi bi-clock-history"></i> Consumption History
            </h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Filters</h5>
                    <form @onsubmit="@ApplyFilters" @onsubmit:preventDefault="true">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Space</label>
                                <select class="form-select" @bind="selectedSpaceId" @bind:after="OnSpaceChanged">
                                    <option value="">All Spaces</option>
                                    @if (userSpaces != null)
                                    {
                                        @foreach (var space in userSpaces)
                                        {
                                            <option value="@space.Id">@space.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            @if (!string.IsNullOrEmpty(selectedSpaceId) && spaceMembers != null && spaceMembers.Any())
                            {
                                <div class="col-md-2">
                                    <label class="form-label">Member</label>
                                    <select class="form-select" @bind="selectedMemberUserId">
                                        <option value="">All Members</option>
                                        @foreach (var member in spaceMembers)
                                        {
                                            <option value="@member.UserId">@member.UserName</option>
                                        }
                                    </select>
                                </div>
                            }

                            @if (string.IsNullOrEmpty(selectedSpaceId) && isSystemAdmin && allUsers != null && allUsers.Any())
                            {
                                <div class="col-md-2">
                                    <label class="form-label">User</label>
                                    <select class="form-select" @bind="selectedMemberUserId">
                                        <option value="">All Users</option>
                                        @foreach (var user in allUsers)
                                        {
                                            <option value="@user.Id">@user.Name</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="col-md-2">
                                <label class="form-label">Start Date</label>
                                <input type="date" class="form-control" @bind="startDate" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">End Date</label>
                                <input type="date" class="form-control" @bind="endDate" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-funnel"></i> Apply
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">
                                        <i class="bi bi-x-circle"></i> Clear
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <LoadingSpinner />
    }
    else if (history != null)
    {
        <div class="row mb-4">
            <div class="col">
                <ConsumptionHistorySummary Summary="history.Summary" />
            </div>
        </div>

        <div class="row">
            <div class="col">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Consumption Timeline</h5>
                            <span class="badge bg-secondary">
                                @history.TotalCount total entries
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <ConsumptionHistoryList History="history"
                                                OnPageChange="OnPageChange"
                                                OnEdit="HandleEditConsumption"
                                                OnDelete="HandleDeleteConsumption" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private ConsumptionHistoryDto? history;
    private IReadOnlyList<SpaceSummaryDto>? userSpaces;
    private IReadOnlyList<MembershipDto>? spaceMembers;
    private IReadOnlyList<AdminUserDto>? allUsers;
    private bool isSystemAdmin;
    private string? errorMessage;
    private string? successMessage;

    private string? selectedSpaceId;
    private string? selectedMemberUserId;
    private DateTime? startDate;
    private DateTime? endDate;
    private int currentPage = 1;
    private const int pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        isSystemAdmin = UserContext.Roles.Contains("admin");
        await Task.WhenAll(
            LoadSpaces(),
            isSystemAdmin ? LoadAllUsers() : Task.CompletedTask
        );
        await LoadHistory();
    }

    private async Task LoadSpaces()
    {
        try
        {
            var result = await Mediator.Send(new GetUserSpacesQuery());
            if (result.IsSuccess)
            {
                userSpaces = result.Value.Spaces;
                errorMessage = null;
            }
            else
            {
                errorMessage = "Unable to load spaces. Please refresh the page.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load spaces");
            errorMessage = "Unable to load spaces. Please refresh the page.";
        }
    }

    private async Task LoadAllUsers()
    {
        try
        {
            var result = await Mediator.Send(new GetAllUsersQuery(PageSize: 1000));
            if (result.IsSuccess)
            {
                allUsers = result.Value.Users;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load users");
        }
    }

    private async Task OnSpaceChanged()
    {
        selectedMemberUserId = null;
        spaceMembers = null;

        if (!string.IsNullOrEmpty(selectedSpaceId) && Guid.TryParse(selectedSpaceId, out var spaceGuid))
        {
            try
            {
                var result = await Mediator.Send(new GetSpaceByIdQuery(spaceGuid));
                if (result.IsSuccess && result.Value.Members != null)
                {
                    spaceMembers = result.Value.Members;
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load space members");
            }
        }
    }

    private async Task LoadHistory()
    {
        isLoading = true;

        try
        {
            Guid? spaceId = !string.IsNullOrEmpty(selectedSpaceId) ? Guid.Parse(selectedSpaceId) : null;
            Guid? memberUserId = !string.IsNullOrEmpty(selectedMemberUserId) ? Guid.Parse(selectedMemberUserId) : null;

            var query = new GetUserConsumptionHistoryQuery(
                SpaceId: spaceId,
                StartDate: startDate,
                EndDate: endDate,
                PageNumber: currentPage,
                PageSize: pageSize,
                MemberUserId: memberUserId
            );

            var result = await Mediator.Send(query);
            if (result.IsSuccess)
            {
                history = result.Value;
                errorMessage = null;
            }
            else
            {
                errorMessage = "Unable to load consumption history. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load consumption history");
            errorMessage = "Unable to load consumption history. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadHistory();
    }

    private async Task ClearFilters()
    {
        selectedSpaceId = null;
        selectedMemberUserId = null;
        spaceMembers = null;
        startDate = null;
        endDate = null;
        currentPage = 1;
        await LoadHistory();
    }

    private async Task OnPageChange(int pageNumber)
    {
        currentPage = pageNumber;
        await LoadHistory();
    }

    private async Task HandleEditConsumption(ConsumptionHistoryItemDto updated)
    {
        try
        {
            var result = await Mediator.Send(new UpdateConsumptionCommand(
                updated.Id,
                updated.SpaceId,
                updated.ProductName,
                updated.ProductBrand,
                updated.ProductType,
                updated.QuantityGrams,
                updated.ConsumedAt));

            if (result.IsSuccess)
            {
                successMessage = "Consumption updated successfully!";
                errorMessage = null;
                await LoadHistory();
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Message));
                successMessage = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update consumption");
            errorMessage = $"Failed to update consumption: {ex.Message}";
            successMessage = null;
        }
    }

    private async Task HandleDeleteConsumption(Guid consumptionId)
    {
        try
        {
            // Need the spaceId — find it from the history items
            var item = history?.Items.FirstOrDefault(i => i.Id == consumptionId);
            if (item == null) return;

            var result = await Mediator.Send(new DeleteConsumptionCommand(consumptionId, item.SpaceId));

            if (result.IsSuccess)
            {
                successMessage = "Consumption deleted successfully!";
                errorMessage = null;
                await LoadHistory();
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Message));
                successMessage = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete consumption");
            errorMessage = $"Failed to delete consumption: {ex.Message}";
            successMessage = null;
        }
    }
}
