@page "/history"
@using BeanShare.Application.Features.Consumption.Dtos
@using BeanShare.Application.Features.Spaces.Dtos
@using System.Net.Http.Json
@inject HttpClient Http
@inject ILogger<Index> Logger

<PageTitle>Consumption History</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3">
                <i class="bi bi-clock-history"></i> My Consumption History
            </h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Filters</h5>
                    <form @onsubmit="@ApplyFilters" @onsubmit:preventDefault="true">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Space</label>
                                <select class="form-select" @bind="selectedSpaceId">
                                    <option value="">All Spaces</option>
                                    @if (userSpaces != null)
                                    {
                                        @foreach (var space in userSpaces)
                                        {
                                            <option value="@space.Id">@space.Name</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Start Date</label>
                                <input type="date" class="form-control" @bind="startDate" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">End Date</label>
                                <input type="date" class="form-control" @bind="endDate" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-funnel"></i> Apply
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">
                                        <i class="bi bi-x-circle"></i> Clear
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
        </div>
    }

    @if (isLoading)
    {
        <LoadingSpinner />
    }
    else if (history != null)
    {
        <div class="row mb-4">
            <div class="col">
                <ConsumptionHistorySummary Summary="history.Summary" />
            </div>
        </div>

        <div class="row">
            <div class="col">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Consumption Timeline</h5>
                            <span class="badge bg-secondary">
                                @history.TotalCount total entries
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <ConsumptionHistoryList History="history" OnPageChange="OnPageChange" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private ConsumptionHistoryDto? history;
    private List<SpaceDto>? userSpaces;
    private string? errorMessage;

    private string? selectedSpaceId;
    private DateTime? startDate;
    private DateTime? endDate;
    private int currentPage = 1;
    private const int pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        await LoadSpaces();
        await LoadHistory();
    }

    private async Task LoadSpaces()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<SpaceDto>>("/api/spaces");
            userSpaces = response;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load spaces");
            errorMessage = "Unable to load spaces. Please refresh the page.";
        }
    }

    private async Task LoadHistory()
    {
        isLoading = true;

        try
        {
            var queryParams = new List<string>
            {
                $"pageNumber={currentPage}",
                $"pageSize={pageSize}"
            };

            if (!string.IsNullOrEmpty(selectedSpaceId))
            {
                queryParams.Add($"spaceId={selectedSpaceId}");
            }

            if (startDate.HasValue)
            {
                queryParams.Add($"startDate={startDate.Value:yyyy-MM-dd}");
            }

            if (endDate.HasValue)
            {
                queryParams.Add($"endDate={endDate.Value:yyyy-MM-dd}");
            }

            var queryString = string.Join("&", queryParams);
            var response = await Http.GetFromJsonAsync<ConsumptionHistoryDto>($"/api/me/consumption/history?{queryString}");
            history = response;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load consumption history");
            errorMessage = "Unable to load consumption history. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadHistory();
    }

    private async Task ClearFilters()
    {
        selectedSpaceId = null;
        startDate = null;
        endDate = null;
        currentPage = 1;
        await LoadHistory();
    }

    private async Task OnPageChange(int pageNumber)
    {
        currentPage = pageNumber;
        await LoadHistory();
    }
}