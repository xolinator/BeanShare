@page "/profile"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MediatR
@using BeanShare.Application.Abstractions
@using BeanShare.Application.Features.Spaces.Queries
@using BeanShare.Application.Features.Analytics.Queries.GetUserStatistics
@using BeanShare.Application.Features.Users.Commands.UpdateProfile
@using BeanShare.Application.Services
@using BeanShare.Infrastructure.Services
@using BeanShare.Domain.Common
@using System.Linq
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IMediator Mediator
@inject IUserContext UserContext
@inject IUserService UserService
@inject AvatarStorageService AvatarStorageService
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>My Profile - BeanShare</PageTitle>

<div class="profile-container">
    <div class="profile-header">
        <div class="profile-header-content">
            <div class="profile-avatar-section">
                <div class="avatar-container">
                    @if (!string.IsNullOrEmpty(userProfile?.PictureUrl))
                    {
                        <img src="@GetAvatarUrl()" alt="@userProfile.Name" class="profile-avatar" />
                    }
                    else
                    {
                        <div class="profile-avatar-placeholder">
                            <span class="material-symbols-outlined">account_circle</span>
                        </div>
                    }
                    <button type="button" class="avatar-upload-btn" @onclick="TriggerFileUpload">
                        <span class="material-symbols-outlined">photo_camera</span>
                    </button>
                    <InputFile id="avatarInput" OnChange="HandleAvatarUpload" accept="image/png,image/jpeg,image/gif,image/webp" style="display: none; position: absolute; width: 0; height: 0; overflow: hidden;" />
                </div>
                @if (isUploadingAvatar)
                {
                    <div class="avatar-upload-status">Uploading...</div>
                }
                @if (!string.IsNullOrEmpty(avatarUploadError))
                {
                    <div class="avatar-upload-error">@avatarUploadError</div>
                }
            </div>
            <div class="profile-info">
                <h1>@(userProfile?.Name ?? "Loading...")</h1>
                <p class="profile-email">@(userProfile?.Email ?? "")</p>
                <p class="profile-joined">Member since @(userProfile?.JoinedDate.ToString("MMMM yyyy") ?? "")</p>
            </div>
        </div>
    </div>

    <div class="profile-content">
        <div class="profile-section">
            <h2>Coffee Statistics</h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-icon material-symbols-outlined">local_cafe</span>
                    <div class="stat-content">
                        <div class="stat-value">@(statistics?.TotalCups ?? 0)</div>
                        <div class="stat-label">Total Cups</div>
                    </div>
                </div>
                <div class="stat-card">
                    <span class="stat-icon material-symbols-outlined">calendar_month</span>
                    <div class="stat-content">
                        <div class="stat-value">@(statistics?.CupsThisMonth ?? 0)</div>
                        <div class="stat-label">This Month</div>
                    </div>
                </div>
                <div class="stat-card">
                    <span class="stat-icon material-symbols-outlined">groups</span>
                    <div class="stat-content">
                        <div class="stat-value">@(statistics?.ActiveSpacesCount ?? 0)</div>
                        <div class="stat-label">Active Spaces</div>
                    </div>
                </div>
                <div class="stat-card">
                    <span class="stat-icon material-symbols-outlined">trending_up</span>
                    <div class="stat-content">
                        <div class="stat-value">@(statistics?.AverageCupsPerDay.ToString("F1") ?? "0.0")</div>
                        <div class="stat-label">Daily Average</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="profile-section">
            <div class="section-header">
                <h2>My Spaces</h2>
                <button class="btn-action" @onclick="NavigateToCreateSpace">
                    <span class="material-symbols-outlined">add</span>
                    Create New Space
                </button>
            </div>
            <div class="spaces-list">
                @if (userSpaces != null && userSpaces.Any())
                {
                    @foreach (var space in userSpaces)
                    {
                        <div class="space-card" @onclick="() => NavigateToSpace(space.Id)">
                            <div class="space-card-icon">
                                <span class="material-symbols-outlined">
                                    @(space.Role == "Admin" ? "admin_panel_settings" : "groups")
                                </span>
                            </div>
                            <div class="space-card-content">
                                <h3>@space.Name</h3>
                                <div class="space-meta">
                                    <span class="badge badge-@(space.Role.ToLower())">@space.Role</span>
                                    <span class="space-members">@space.MemberCount members</span>
                                </div>
                            </div>
                            <div class="space-card-action">
                                <span class="material-symbols-outlined">chevron_right</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <span class="material-symbols-outlined">coffee</span>
                        <p>You haven't joined any spaces yet</p>
                        <button class="btn-primary" @onclick="NavigateToSpaces">Browse Spaces</button>
                    </div>
                }
            </div>
        </div>

        <div class="profile-section">
            <h2>Account Information</h2>
            <div class="info-grid">
                <div class="info-item">
                    <label>Full Name</label>
                    <div class="info-value">
                        <input type="text" @bind="editName" disabled="@(!isEditing)" />
                    </div>
                </div>
                <div class="info-item">
                    <label>Email Address</label>
                    <div class="info-value">
                        <input type="email" value="@userProfile?.Email" disabled />
                        <span class="verified-badge" title="Verified">
                            <span class="material-symbols-outlined">verified</span>
                        </span>
                    </div>
                </div>
                <div class="info-item">
                    <label>Phone Number</label>
                    <div class="info-value">
                        <input type="tel" @bind="editPhone" disabled="@(!isEditing)" placeholder="Not set" />
                    </div>
                </div>
                <div class="info-item">
                    <label>Time Zone</label>
                    <div class="info-value">
                        <select @bind="editTimeZone" disabled="@(!isEditing)">
                            <option value="UTC">UTC</option>
                            <option value="EST">Eastern Time</option>
                            <option value="CST">Central Time</option>
                            <option value="PST">Pacific Time</option>
                            <option value="CET">Central European Time</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="profile-actions">
                @if (isEditing)
                {
                    <button class="btn-secondary" @onclick="CancelEdit">Cancel</button>
                    <button class="btn-primary" @onclick="SaveProfile">Save Changes</button>
                }
                else
                {
                    <button class="btn-secondary" @onclick="StartEdit">
                        <span class="material-symbols-outlined">edit</span>
                        Edit Profile
                    </button>
                }
            </div>
        </div>

    </div>
</div>


@code {
    private UserProfile? userProfile;
    private List<UserSpace>? userSpaces;
    private UserStatisticsDto? statistics;

    private bool isEditing = false;
    private string editName = "";
    private string editPhone = "";
    private string editTimeZone = "UTC";

    private bool isUploadingAvatar = false;
    private string? avatarUploadError;
    private int avatarCacheBuster = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfile();
        await LoadUserSpaces();
        await LoadStatistics();
    }

    private async Task LoadUserProfile()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // Get Name, PictureUrl, and CreatedAt from database (most up-to-date) instead of claims
            string? pictureUrl = authState.User.FindFirst("picture")?.Value;
            string displayName = authState.User.Identity.Name ?? "User";
            DateTime joinedDate = DateTime.Now;
            var userId = UserContext.CurrentUserId;
            if (userId.Value != Guid.Empty)
            {
                try
                {
                    var user = await UserService.GetByIdAsync(userId);
                    if (user is not null)
                    {
                        if (!string.IsNullOrEmpty(user.Name))
                            displayName = user.Name;
                        if (user.PictureUrl is not null)
                            pictureUrl = user.PictureUrl;
                        joinedDate = user.CreatedAt;
                    }
                }
                catch
                {
                    // Fall back to claims if database lookup fails
                }
            }

            userProfile = new UserProfile
            {
                Name = displayName,
                Email = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "",
                PictureUrl = pictureUrl,
                JoinedDate = joinedDate
            };

            editName = userProfile.Name;
        }
    }

    private async Task LoadUserSpaces()
    {
        try
        {
            var result = await Mediator.Send(new GetUserSpacesQuery());
            if (result.IsSuccess)
            {
                userSpaces = result.Value.Spaces.Select(s => new UserSpace
                {
                    Id = s.Id,
                    Name = s.Name,
                    Role = s.Role,
                    MemberCount = s.MemberCount
                }).ToList();
            }
        }
        catch
        {
            userSpaces = new List<UserSpace>();
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            var currentUserId = UserContext.CurrentUserId;
            if (currentUserId.Value != Guid.Empty)
            {
                var query = new GetUserStatisticsQuery(currentUserId);
                statistics = await Mediator.Send(query);
            }
        }
        catch
        {
            // If query fails, statistics will remain null and UI will show 0 values
            statistics = null;
        }
    }

    private void StartEdit()
    {
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        editName = userProfile?.Name ?? "";
        editPhone = "";
        editTimeZone = "UTC";
    }

    private async Task SaveProfile()
    {
        if (userProfile != null)
        {
            var command = new UpdateProfileCommand(editName, userProfile.PictureUrl);
            var result = await Mediator.Send(command);
            if (result.IsSuccess)
            {
                userProfile.Name = editName;
            }
        }
        isEditing = false;
        StateHasChanged();
    }

    private void NavigateToSpace(Guid spaceId)
    {
        Navigation.NavigateTo($"/spaces/{spaceId}");
    }

    private void NavigateToSpaces()
    {
        Navigation.NavigateTo("/spaces");
    }

    private void NavigateToCreateSpace()
    {
        Navigation.NavigateTo("/spaces?action=create");
    }

    private string GetAvatarUrl()
    {
        if (string.IsNullOrEmpty(userProfile?.PictureUrl))
            return "";

        if (userProfile.PictureUrl.StartsWith("/uploads/"))
        {
            return $"{userProfile.PictureUrl}?v={avatarCacheBuster}";
        }

        return userProfile.PictureUrl;
    }

    private async Task TriggerFileUpload()
    {
        await JSRuntime.InvokeVoidAsync("beanshare.clickElement", "avatarInput");
    }

    private async Task HandleAvatarUpload(InputFileChangeEventArgs e)
    {
        avatarUploadError = null;
        isUploadingAvatar = true;
        StateHasChanged();

        try
        {
            var file = e.File;

            if (file.Size > 5 * 1024 * 1024)
            {
                avatarUploadError = "File size exceeds 5MB limit";
                return;
            }

            var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
            if (!allowedTypes.Contains(file.ContentType.ToLowerInvariant()))
            {
                avatarUploadError = "Invalid file type. Allowed: jpg, png, gif, webp";
                return;
            }

            using var fileStream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var result = await AvatarStorageService.SaveAvatarAsync(
                UserContext.CurrentUserId.Value,
                file.Name,
                file.ContentType,
                file.Size,
                fileStream);

            if (result.Success)
            {
                if (!string.IsNullOrEmpty(result.AvatarUrl))
                {
                    if (userProfile != null)
                    {
                        userProfile.PictureUrl = result.AvatarUrl;
                    }

                    var updateCommand = new UpdateProfileCommand(userProfile?.Name ?? "", result.AvatarUrl);
                    await Mediator.Send(updateCommand);

                    avatarCacheBuster++;
                }
                else
                {
                    avatarUploadError = "Upload failed";
                }
            }
            else
            {
                avatarUploadError = result.Error ?? "Upload failed";
            }
        }
        catch (Exception ex)
        {
            avatarUploadError = $"Error: {ex.Message}";
        }
        finally
        {
            isUploadingAvatar = false;
            StateHasChanged();
        }
    }

    private async Task HandleExportData()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Data export is not yet available. This feature is coming soon.");
    }

    private async Task HandleDeleteAccount()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Account deletion requires contacting support. This feature is coming soon.");
    }
    private class UserProfile
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string? PictureUrl { get; set; }
        public DateTime JoinedDate { get; set; }
    }

    private class UserSpace
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Role { get; set; } = "";
        public int MemberCount { get; set; }
    }
}
