@page "/spaces/{SpaceId:guid}/settlements"
@using BeanShare.Contracts.Settlement
@inject ISettlementService SettlementService
@inject NavigationManager Navigation

<div class="container mt-4">
    <h3 class="mb-4">Settlements</h3>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!settlements.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No settlements yet. Generate a settlement from a closed billing period.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var settlement in settlements)
            {
                <div class="col-md-6">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@settlement.BillingPeriodName</h5>
                                <span class="badge bg-success">Settled</span>
                            </div>

                            <div class="text-muted small mb-3">
                                Generated @settlement.GeneratedAt.ToString("MMM dd, yyyy")
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="p-2 bg-light rounded text-center">
                                        <div class="fw-bold">@settlement.ParticipantCount</div>
                                        <small class="text-muted">Participants</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 bg-light rounded text-center">
                                        <div class="fw-bold text-primary">@settlement.TotalAmount.ToString("C2")</div>
                                        <small class="text-muted">Total Cost</small>
                                    </div>
                                </div>
                            </div>

                            @if (settlement.UserShare.HasValue)
                            {
                                <div class="alert alert-warning py-2 small mb-2">
                                    <i class="bi bi-wallet me-1"></i>
                                    Your share: <strong>@settlement.UserShare.Value.ToString("C2")</strong>
                                </div>
                            }

                            <button class="btn btn-primary w-100" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/settlements/{settlement.Id}"))'>
                                <i class="bi bi-eye me-1"></i> View Details
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid SpaceId { get; set; }

    private bool isLoading = true;
    private List<SettlementSummaryDto> settlements = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadSettlements();
    }

    private async Task LoadSettlements()
    {
        isLoading = true;
        try
        {
            settlements = await SettlementService.GetSpaceSettlementsAsync(SpaceId);
        }
        finally
        {
            isLoading = false;
        }
    }
}
