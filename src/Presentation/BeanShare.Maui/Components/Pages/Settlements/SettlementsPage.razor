@page "/spaces/{SpaceId:guid}/settlements"
@using BeanShare.Contracts.Settlement
@inject ISettlementService SettlementService

<div class="container mt-4">
    <h3 class="mb-4">Settlements</h3>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (selectedSettlement != null)
    {
        <div class="mb-3">
            <button class="btn btn-secondary" @onclick="BackToList">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </button>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-receipt me-2"></i>
                    Settlement Details
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6>Billing Period</h6>
                        <p class="text-muted mb-2">@selectedSettlement.BillingPeriodName</p>
                        <small class="text-muted">
                            @selectedSettlement.BillingPeriodStartDate.ToString("MMM dd, yyyy") -
                            @selectedSettlement.BillingPeriodEndDate.ToString("MMM dd, yyyy")
                        </small>
                    </div>
                    <div class="col-md-6">
                        <h6>Generated</h6>
                        <p class="text-muted">@selectedSettlement.GeneratedAt.ToString("MMM dd, yyyy HH:mm")</p>
                    </div>
                </div>

                <div class="alert alert-info mb-4">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <h4>@selectedSettlement.Lines.Count</h4>
                            <small>Participants</small>
                        </div>
                        <div class="col-md-4">
                            <h4>@selectedSettlement.TotalAmount.ToString("C2")</h4>
                            <small>Total Amount</small>
                        </div>
                        <div class="col-md-4">
                            <h4>@selectedSettlement.Currency</h4>
                            <small>Currency</small>
                        </div>
                    </div>
                </div>

                <h6 class="mb-3">Cost Breakdown</h6>
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Coffee Consumed</th>
                                <th>Percentage</th>
                                <th class="text-end">Amount Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in selectedSettlement.Lines.OrderByDescending(l => l.AmountDue))
                            {
                                <tr>
                                    <td>
                                        <div>@line.UserName</div>
                                        <small class="text-muted">@line.UserEmail</small>
                                    </td>
                                    <td>
                                        <strong>@line.TotalCoffeeGrams g</strong>
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar bg-success"
                                                 role="progressbar"
                                                 style="width: @line.ConsumptionPercentage%"
                                                 aria-valuenow="@line.ConsumptionPercentage"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                                @line.ConsumptionPercentage.ToString("F1")%
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <strong class="text-primary">@line.AmountDue.ToString("C2")</strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td>TOTAL</td>
                                <td>@selectedSettlement.Lines.Sum(l => l.TotalCoffeeGrams) g</td>
                                <td>100%</td>
                                <td class="text-end text-primary">@selectedSettlement.TotalAmount.ToString("C2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (!settlements.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No settlements yet. Generate a settlement from a closed billing period.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var settlement in settlements)
            {
                <div class="col-md-6">
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">@settlement.BillingPeriodName</h5>
                                <span class="badge bg-success">Settled</span>
                            </div>

                            <div class="text-muted small mb-3">
                                Generated @settlement.GeneratedAt.ToString("MMM dd, yyyy")
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="p-2 bg-light rounded text-center">
                                        <div class="fw-bold">@settlement.ParticipantCount</div>
                                        <small class="text-muted">Participants</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-2 bg-light rounded text-center">
                                        <div class="fw-bold text-primary">@settlement.TotalAmount.ToString("C2")</div>
                                        <small class="text-muted">Total Cost</small>
                                    </div>
                                </div>
                            </div>

                            @if (settlement.UserShare.HasValue)
                            {
                                <div class="alert alert-warning py-2 small mb-2">
                                    <i class="bi bi-wallet me-1"></i>
                                    Your share: <strong>@settlement.UserShare.Value.ToString("C2")</strong>
                                </div>
                            }

                            <button class="btn btn-primary w-100" @onclick="() => ViewSettlementDetails(settlement.Id)">
                                <i class="bi bi-eye me-1"></i> View Details
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid SpaceId { get; set; }

    private bool isLoading = true;
    private List<SettlementSummaryDto> settlements = new();
    private SettlementDto? selectedSettlement;

    protected override async Task OnParametersSetAsync()
    {
        await LoadSettlements();
    }

    private async Task LoadSettlements()
    {
        isLoading = true;
        try
        {
            settlements = await SettlementService.GetSpaceSettlementsAsync(SpaceId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ViewSettlementDetails(Guid settlementId)
    {
        isLoading = true;
        try
        {
            selectedSettlement = await SettlementService.GetSettlementByIdAsync(settlementId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BackToList()
    {
        selectedSettlement = null;
    }
}
