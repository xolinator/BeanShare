@page "/spaces/{SpaceId:guid}/settlements"
@using BeanShare.Contracts.Settlement
@inject ISettlementService SettlementService
@inject NavigationManager Navigation
@inject IAlertService AlertService

<div class="bs-container" style="padding: 1rem 0;">
    <h2 class="bs-font-bold" style="margin: 0 0 1.5rem; font-size: 1.25rem;">Settlements</h2>

    @if (isLoading)
    {
        <BeanShare.SharedUi.Components.Common.LoadingSpinner Message="Loading settlements..." />
    }
    else if (!settlements.Any())
    {
        <div class="bs-card" style="text-align: center; padding: 2rem;">
            <span class="material-symbols-outlined" style="font-size: 3rem; color: var(--bs-text-subtle); display: block; margin-bottom: 0.75rem;">account_balance</span>
            <p style="margin: 0; color: var(--bs-text-subtle);">No settlements yet. Generate a settlement from a closed billing period.</p>
        </div>
    }
    else
    {
        <div class="bs-flex bs-flex-col bs-gap-3">
            @foreach (var settlement in settlements)
            {
                var isCompleted = settlement.Status == "Completed";
                var statusColor = isCompleted ? "var(--bs-success)" : "var(--bs-warning, #f59e0b)";
                var progressPct = settlement.TotalLinesCount > 0
                    ? (int)((double)settlement.ConfirmedLinesCount / settlement.TotalLinesCount * 100)
                    : 0;

                <div class="bs-card" style="border-left: 3px solid @statusColor;">
                    <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 0.5rem;">
                        <h3 class="bs-font-bold" style="margin: 0; font-size: 1rem;">@settlement.BillingPeriodName</h3>
                        <span style="font-size: 0.75rem; font-weight: 600; padding: 0.125rem 0.5rem; border-radius: 999px; background: color-mix(in srgb, @statusColor 15%, transparent); color: @statusColor;">
                            @(isCompleted ? "Completed" : "Awaiting")
                        </span>
                    </div>

                    <p class="bs-text-subtle" style="margin: 0 0 0.75rem; font-size: 0.8125rem;">
                        Generated @settlement.GeneratedAt.ToString("MMM dd, yyyy")
                    </p>

                    <div style="margin-bottom: 0.75rem;">
                        <div class="bs-flex bs-justify-between" style="font-size: 0.75rem; margin-bottom: 0.25rem;">
                            <span class="bs-text-subtle">Confirmations</span>
                            <span>@settlement.ConfirmedLinesCount / @settlement.TotalLinesCount</span>
                        </div>
                        <div style="height: 6px; background: var(--bs-gray-200); border-radius: 3px; overflow: hidden;">
                            <div style="width: @(progressPct)%; height: 100%; background: @statusColor; border-radius: 3px; transition: width 0.3s;"></div>
                        </div>
                    </div>

                    <div class="bs-flex bs-gap-3" style="margin-bottom: 0.75rem;">
                        <div style="flex: 1; text-align: center; padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem;">
                            <div class="bs-font-bold">@settlement.UserCount</div>
                            <div style="font-size: 0.6875rem; color: var(--bs-text-subtle);">Participants</div>
                        </div>
                        <div style="flex: 1; text-align: center; padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem;">
                            <div class="bs-font-bold" style="color: var(--bs-primary);">@settlement.TotalAmount.ToString("N2") @settlement.Currency</div>
                            <div style="font-size: 0.6875rem; color: var(--bs-text-subtle);">Total Cost</div>
                        </div>
                    </div>

                    @if (settlement.YourShare != 0)
                    {
                        <div style="padding: 0.5rem 0.75rem; background: color-mix(in srgb, var(--bs-warning, #f59e0b) 10%, transparent); border-radius: 0.5rem; margin-bottom: 0.75rem;">
                            <span style="font-size: 0.8125rem;">
                                <span class="material-symbols-outlined" style="font-size: 1rem; vertical-align: middle;">wallet</span>
                                Your share: <strong>@settlement.YourShare.ToString("N2") @settlement.Currency</strong>
                            </span>
                        </div>
                    }

                    <button class="bs-btn bs-btn-sm" style="width: 100%; background: var(--bs-primary-light); color: var(--bs-primary);"
                            @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/settlements/{settlement.Id}"))'>
                        View Details
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid SpaceId { get; set; }

    private bool isLoading = true;
    private List<SettlementSummaryDto> settlements = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadSettlements();
    }

    private async Task LoadSettlements()
    {
        isLoading = true;
        try
        {
            settlements = await SettlementService.GetSpaceSettlementsAsync(SpaceId);
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to load settlements: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
