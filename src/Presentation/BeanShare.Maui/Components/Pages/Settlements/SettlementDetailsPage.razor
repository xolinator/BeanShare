@page "/spaces/{SpaceId}/settlements/{SettlementId}"
@using MediatR
@using BeanShare.Application.Features.Settlement.Queries.GetSettlementById
@using BeanShare.Application.Features.Settlement.Dtos
@using BeanShare.Domain.ValueObjects
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Settlement Details - BeanShare</PageTitle>

<div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <button class="bs-btn-sm" style="background: transparent; border: none; cursor: pointer;" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/settlements"))'>
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Settlement</h1>
            <div style="width: 2rem;"></div>
        </div>
    </div>
</div>

<div class="bs-container" style="padding: 2rem 0;">
    @if (isLoading)
    {
        <div style="text-align: center; padding: 2rem;">
            <div class="bs-skeleton" style="width: 100%; height: 10rem; margin-bottom: 1rem;"></div>
            <div class="bs-skeleton" style="width: 100%; height: 15rem;"></div>
        </div>
    }
    else if (settlement == null)
    {
        <div style="text-align: center; padding: 4rem 2rem;">
            <span class="material-symbols-outlined" style="font-size: 4rem; color: var(--bs-text-subtle); margin-bottom: 1rem;">error</span>
            <h2 style="margin: 0 0 0.5rem 0; font-size: 1.25rem; font-weight: 600;">Settlement Not Found</h2>
            <p class="bs-text-subtle">The settlement you're looking for doesn't exist.</p>
        </div>
    }
    else
    {
        <!-- Settlement Header -->
        <div class="bs-card" style="padding: 2rem; margin-bottom: 1.5rem;">
            <h2 style="margin: 0 0 0.5rem 0; font-size: 1.5rem; font-weight: 700;">@settlement.BillingPeriodName</h2>
            <p class="bs-text-subtle" style="margin: 0 0 1.5rem 0;">
                Period: @settlement.PeriodStart.ToString("MMM dd") - @settlement.PeriodEnd.ToString("MMM dd, yyyy")
            </p>

            <div class="bs-flex bs-gap-4" style="flex-wrap: wrap;">
                <div class="bs-flex-1" style="min-width: 200px;">
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 0.5rem 0;">Total Amount</p>
                    <p style="font-size: 2rem; font-weight: 700; margin: 0; color: var(--bs-primary);">
                        @settlement.Currency @settlement.TotalAmount.ToString("F2")
                    </p>
                </div>
                <div class="bs-flex-1" style="min-width: 200px;">
                    <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0 0 0.5rem 0;">Generated</p>
                    <p style="font-size: 1.25rem; font-weight: 600; margin: 0;">
                        @settlement.GeneratedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                    </p>
                </div>
            </div>
        </div>

        <!-- Settlement Lines -->
        <div class="bs-card" style="padding: 2rem;">
            <h3 style="margin: 0 0 1.5rem 0; font-size: 1.25rem; font-weight: 600;">Cost Breakdown</h3>

            <div class="bs-flex bs-flex-col bs-gap-3">
                @foreach (var line in settlement.Lines.OrderByDescending(l => l.TotalCoffeeGrams))
                {
                    <div class="bs-card" style="padding: 1.5rem; background: var(--bs-gray-50); border: 1px solid var(--bs-border);">
                        <div class="bs-flex bs-items-start bs-justify-between" style="margin-bottom: 1rem;">
                            <div>
                                <h4 style="margin: 0 0 0.25rem 0; font-size: 1.125rem; font-weight: 600;">@line.UserName</h4>
                                <p class="bs-text-subtle" style="font-size: 0.875rem; margin: 0;">@line.UserEmail</p>
                            </div>
                            <div style="text-align: right;">
                                <p style="font-size: 1.5rem; font-weight: 700; margin: 0; color: var(--bs-warning);">
                                    @line.Currency @line.AmountDue.ToString("F2")
                                </p>
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0;">
                                    @line.ConsumptionPercentage.ToString("F1")% of total
                                </p>
                            </div>
                        </div>

                        <div class="bs-flex bs-gap-4">
                            <div>
                                <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Coffee Consumed</p>
                                <p style="font-size: 1.125rem; font-weight: 600; margin: 0;">@line.TotalCoffeeGrams.ToString("F0")g</p>
                            </div>
                            @if (line.TotalMilkMl.HasValue && line.TotalMilkMl.Value > 0)
                            {
                                <div>
                                    <p class="bs-text-subtle" style="font-size: 0.75rem; margin: 0 0 0.25rem 0;">Milk Used</p>
                                    <p style="font-size: 1.125rem; font-weight: 600; margin: 0;">@line.TotalMilkMl.Value.ToString("F0")ml</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Actions -->
        <div style="margin-top: 1.5rem; text-align: center;">
            <button class="bs-btn bs-btn-secondary" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}/billing/{settlement.BillingPeriodId}"))'>
                <span class="material-symbols-outlined">calendar_month</span>
                View Billing Period
            </button>
        </div>
    }
</div>

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    [Parameter]
    public string SettlementId { get; set; } = "";

    private SettlementDto? settlement;
    private bool isLoading = true;
    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettlement();
    }

    private async Task LoadSettlement()
    {
        isLoading = true;
        try
        {
            var query = new GetSettlementByIdQuery(new SettlementId(Guid.Parse(SettlementId)));
            var result = await Mediator.Send(query);

            if (result.IsSuccess)
            {
                settlement = result.Value;
            }
            else
            {
                ShowToast(true, "Error", string.Join(", ", result.Errors.Select(e => e.Message)));
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load settlement: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}
