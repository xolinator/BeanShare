@page "/history"
@using BeanShare.Application.Features.Consumption.Dtos
@using BeanShare.Application.Features.Spaces.Dtos
@inject IConsumptionService ConsumptionService
@inject ISpacesService SpacesService
@inject IAlertService AlertService

<div class="bs-container" style="padding: 1rem 0;">
    <h2 class="bs-font-bold" style="margin: 0 0 1rem; font-size: 1.25rem;">Consumption History</h2>

    @if (isLoading)
    {
        <BeanShare.SharedUi.Components.Common.LoadingSpinner Message="Loading history..." />
    }
    else
    {
        <div class="bs-card" style="margin-bottom: 1rem;">
            <div class="bs-flex bs-flex-col bs-gap-3">
                <div>
                    <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.25rem; color: var(--bs-text-subtle);">Space</label>
                    <select class="bs-input" @bind="selectedSpaceId" @bind:after="OnSpaceChanged">
                        <option value="">All Spaces</option>
                        @foreach (var space in spaces)
                        {
                            <option value="@space.Id">@space.Name</option>
                        }
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(selectedSpaceId) && spaceMembers != null && spaceMembers.Any())
                {
                    <div>
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.25rem; color: var(--bs-text-subtle);">Member</label>
                        <select class="bs-input" @bind="selectedMemberUserId">
                            <option value="">All Members</option>
                            @foreach (var member in spaceMembers)
                            {
                                <option value="@member.UserId">@member.UserName</option>
                            }
                        </select>
                    </div>
                }
                <div class="bs-flex bs-gap-2">
                    <div style="flex: 1;">
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.25rem; color: var(--bs-text-subtle);">From</label>
                        <input type="date" class="bs-input" @bind="startDate" />
                    </div>
                    <div style="flex: 1;">
                        <label style="display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 0.25rem; color: var(--bs-text-subtle);">To</label>
                        <input type="date" class="bs-input" @bind="endDate" />
                    </div>
                </div>
                <button class="bs-btn bs-btn-primary" @onclick="ApplyFilters">Apply Filters</button>
            </div>
        </div>

        @if (history != null && history.Items.Any())
        {
            <div class="bs-flex bs-gap-2" style="margin-bottom: 1rem; flex-wrap: wrap;">
                <div style="flex: 1; min-width: 5rem; text-align: center; padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem;">
                    <div class="bs-font-bold" style="color: var(--bs-primary);">@history.Summary.TotalEntries</div>
                    <div style="font-size: 0.6875rem; color: var(--bs-text-subtle);">Entries</div>
                </div>
                <div style="flex: 1; min-width: 5rem; text-align: center; padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem;">
                    <div class="bs-font-bold" style="color: var(--bs-success);">@history.Summary.TotalGrams g</div>
                    <div style="font-size: 0.6875rem; color: var(--bs-text-subtle);">Coffee</div>
                </div>
                <div style="flex: 1; min-width: 5rem; text-align: center; padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem;">
                    <div class="bs-font-bold">@history.Summary.UniqueDays</div>
                    <div style="font-size: 0.6875rem; color: var(--bs-text-subtle);">Days</div>
                </div>
                <div style="flex: 1; min-width: 5rem; text-align: center; padding: 0.5rem; background: var(--bs-gray-100); border-radius: 0.5rem;">
                    <div class="bs-font-bold">@history.Summary.AverageGramsPerDay.ToString("F1") g</div>
                    <div style="font-size: 0.6875rem; color: var(--bs-text-subtle);">Avg/Day</div>
                </div>
            </div>

            <div class="bs-flex bs-flex-col bs-gap-2">
                @foreach (var item in history.Items)
                {
                    <div class="bs-card" style="border-left: 3px solid var(--bs-primary); padding: 0.75rem;">
                        <div class="bs-flex bs-justify-between bs-items-start">
                            <div style="min-width: 0; flex: 1;">
                                <div class="bs-font-bold" style="font-size: 0.9rem;">@item.ProductName</div>
                                <div style="font-size: 0.75rem; color: var(--bs-text-subtle);">@item.ProductBrand &middot; @item.ProductType</div>
                            </div>
                            <div style="text-align: right; white-space: nowrap; margin-left: 0.5rem;">
                                <div class="bs-font-bold">@item.QuantityGrams g</div>
                                @if (item.EstimatedCost.HasValue)
                                {
                                    <div style="font-size: 0.8125rem; color: var(--bs-success);">@item.EstimatedCost.Value.ToString("N2") @item.Currency</div>
                                }
                            </div>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--bs-text-subtle); margin-top: 0.25rem;">
                            @item.ConsumedAt.ToLocalTime().ToString("MMM dd, HH:mm") &middot; @item.UserName &middot; @item.SpaceName
                        </div>
                    </div>
                }
            </div>

            @if (history.TotalCount > history.PageSize)
            {
                <div class="bs-flex bs-justify-between bs-items-center" style="margin-top: 1rem;">
                    <span style="font-size: 0.75rem; color: var(--bs-text-subtle);">
                        @((history.PageNumber - 1) * history.PageSize + 1)–@Math.Min(history.PageNumber * history.PageSize, history.TotalCount) of @history.TotalCount
                    </span>
                    <div class="bs-flex bs-gap-2">
                        <button class="bs-btn bs-btn-sm bs-btn-secondary" disabled="@(history.PageNumber == 1)" @onclick="() => ChangePage(history.PageNumber - 1)">Prev</button>
                        <button class="bs-btn bs-btn-sm bs-btn-secondary" disabled="@(history.PageNumber * history.PageSize >= history.TotalCount)" @onclick="() => ChangePage(history.PageNumber + 1)">Next</button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bs-card" style="text-align: center; padding: 2rem;">
                <span class="material-symbols-outlined" style="font-size: 3rem; color: var(--bs-text-subtle); display: block; margin-bottom: 0.75rem;">history</span>
                <p style="margin: 0; color: var(--bs-text-subtle);">No consumption history found. Start logging your coffee!</p>
            </div>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private ConsumptionHistoryDto? history;
    private List<SpaceSummaryDto> spaces = new();
    private IReadOnlyList<MembershipDto>? spaceMembers;
    private string? selectedSpaceId;
    private string? selectedMemberUserId;
    private DateTime? startDate;
    private DateTime? endDate;
    private int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadSpaces();
        await LoadHistory();
    }

    private async Task LoadSpaces()
    {
        try
        {
            var result = await SpacesService.GetUserSpacesAsync();
            spaces = result?.ToList() ?? new List<SpaceSummaryDto>();
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to load spaces: {ex.Message}");
        }
    }

    private async Task OnSpaceChanged()
    {
        selectedMemberUserId = null;
        spaceMembers = null;

        if (!string.IsNullOrEmpty(selectedSpaceId) && Guid.TryParse(selectedSpaceId, out var spaceGuid))
        {
            try
            {
                var spaceDetail = await SpacesService.GetSpaceByIdAsync(spaceGuid);
                spaceMembers = spaceDetail?.Members;
            }
            catch { }
        }
    }

    private async Task LoadHistory()
    {
        isLoading = true;
        try
        {
            Guid? spaceId = !string.IsNullOrEmpty(selectedSpaceId) && Guid.TryParse(selectedSpaceId, out var sid) ? sid : null;
            Guid? memberUserId = !string.IsNullOrEmpty(selectedMemberUserId) && Guid.TryParse(selectedMemberUserId, out var mid) ? mid : null;

            history = await ConsumptionService.GetUserHistoryAsync(
                spaceId: spaceId,
                startDate: startDate,
                endDate: endDate,
                pageNumber: currentPage,
                pageSize: 20,
                memberUserId: memberUserId);
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to load history: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadHistory();
    }

    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadHistory();
    }
}
