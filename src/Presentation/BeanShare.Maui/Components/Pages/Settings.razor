@page "/settings"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="settings-page">
    <div class="settings-tabs">
        <button class="@GetTabClass("appearance")" @onclick='() => SetActiveTab("appearance")'>
            <span class="material-symbols-outlined">palette</span>
            <span>Appearance</span>
        </button>
        <button class="@GetTabClass("notifications")" @onclick='() => SetActiveTab("notifications")'>
            <span class="material-symbols-outlined">notifications</span>
            <span>Notifications</span>
        </button>
        <button class="@GetTabClass("privacy")" @onclick='() => SetActiveTab("privacy")'>
            <span class="material-symbols-outlined">lock</span>
            <span>Privacy</span>
        </button>
        <button class="@GetTabClass("advanced")" @onclick='() => SetActiveTab("advanced")'>
            <span class="material-symbols-outlined">settings</span>
            <span>Advanced</span>
        </button>
    </div>

    <div class="settings-content">
        @switch(activeTab)
        {
            case "appearance":
                <div class="settings-section">
                    <h2>Appearance</h2>
                    <p class="section-description">Customize how BeanShare looks and feels</p>

                    <div class="setting-group">
                        <h3>Theme</h3>
                        <div class="theme-options">
                            <label class="theme-card @(theme == "light" ? "active" : "")" @onclick='() => SetTheme("light")'>
                                <div class="theme-icon light-icon">
                                    <span class="material-symbols-outlined">light_mode</span>
                                </div>
                                <span>Light</span>
                                @if (theme == "light")
                                {
                                    <span class="material-symbols-outlined check-icon">check_circle</span>
                                }
                            </label>
                            <label class="theme-card @(theme == "dark" ? "active" : "")" @onclick='() => SetTheme("dark")'>
                                <div class="theme-icon dark-icon">
                                    <span class="material-symbols-outlined">dark_mode</span>
                                </div>
                                <span>Dark</span>
                                @if (theme == "dark")
                                {
                                    <span class="material-symbols-outlined check-icon">check_circle</span>
                                }
                            </label>
                            <label class="theme-card @(theme == "auto" ? "active" : "")" @onclick='() => SetTheme("auto")'>
                                <div class="theme-icon auto-icon">
                                    <span class="material-symbols-outlined">brightness_auto</span>
                                </div>
                                <span>Auto</span>
                                @if (theme == "auto")
                                {
                                    <span class="material-symbols-outlined check-icon">check_circle</span>
                                }
                            </label>
                        </div>
                    </div>
                </div>
                break;

            case "notifications":
                <div class="settings-section">
                    <h2>Notifications</h2>
                    <p class="section-description">Control when and how you receive notifications</p>

                    <div class="setting-group">
                        <h3>Email Notifications</h3>
                        <div class="toggle-list">
                            <div class="toggle-item">
                                <div class="toggle-info">
                                    <label>New Coffee Added</label>
                                    <p>When someone adds coffee to your space</p>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" @bind="notifyNewCoffee" />
                                    <span class="slider"></span>
                                </label>
                            </div>
                            <div class="toggle-item">
                                <div class="toggle-info">
                                    <label>Low Stock Alert</label>
                                    <p>When coffee stock is running low</p>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" @bind="notifyLowStock" />
                                    <span class="slider"></span>
                                </label>
                            </div>
                            <div class="toggle-item">
                                <div class="toggle-info">
                                    <label>Space Invitations</label>
                                    <p>When you're invited to join a space</p>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" @bind="notifyInvitations" />
                                    <span class="slider"></span>
                                </label>
                            </div>
                            <div class="toggle-item">
                                <div class="toggle-info">
                                    <label>Weekly Summary</label>
                                    <p>Weekly coffee consumption report</p>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" @bind="notifyWeeklySummary" />
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case "privacy":
                <div class="settings-section">
                    <h2>Privacy & Security</h2>
                    <p class="section-description">Manage your privacy settings and account security</p>

                    <div class="setting-group">
                        <h3>Password</h3>
                        <button class="action-button" @onclick="ChangePassword">
                            <span class="material-symbols-outlined">lock</span>
                            <span>Change Password</span>
                        </button>
                    </div>

                    <div class="setting-group">
                        <h3>Connected Accounts</h3>
                        <div class="account-list">
                            <div class="account-item">
                                <div class="account-info">
                                    <div class="account-icon">G</div>
                                    <span>Google</span>
                                </div>
                                <button class="connect-btn">Connect</button>
                            </div>
                            <div class="account-item">
                                <div class="account-info">
                                    <div class="account-icon">F</div>
                                    <span>Facebook</span>
                                </div>
                                <button class="connect-btn">Connect</button>
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case "advanced":
                <div class="settings-section">
                    <h2>Advanced Settings</h2>
                    <p class="section-description">Advanced configuration options</p>

                    <div class="setting-group">
                        <h3>Language & Region</h3>
                        <div class="form-field">
                            <label>Language</label>
                            <select @bind="language">
                                <option value="en">English</option>
                                <option value="de">Deutsch</option>
                                <option value="fr">Français</option>
                                <option value="es">Español</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Time Zone</label>
                            <select @bind="timeZone">
                                <option value="UTC">UTC</option>
                                <option value="EST">Eastern Time</option>
                                <option value="CST">Central Time</option>
                                <option value="PST">Pacific Time</option>
                                <option value="CET">Central European Time</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label>Date Format</label>
                            <select @bind="dateFormat">
                                <option value="MM/DD/YYYY">MM/DD/YYYY</option>
                                <option value="DD/MM/YYYY">DD/MM/YYYY</option>
                                <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                            </select>
                        </div>
                    </div>

                    <div class="setting-group">
                        <h3>Data & Storage</h3>
                        <div class="storage-card">
                            <div class="storage-bar">
                                <div class="storage-used" style="width: 35%"></div>
                            </div>
                            <p>350 MB of 1 GB used</p>
                        </div>
                        <button class="action-button">
                            <span class="material-symbols-outlined">delete</span>
                            <span>Clear Cache</span>
                        </button>
                    </div>

                    <div class="setting-group">
                        <h3>Export Data</h3>
                        <p>Download all your BeanShare data</p>
                        <button class="action-button">
                            <span class="material-symbols-outlined">download</span>
                            <span>Export as JSON</span>
                        </button>
                    </div>
                </div>
                break;
        }
    </div>

    <div class="settings-footer">
        <button class="footer-btn cancel-btn" @onclick="Cancel">Cancel</button>
        <button class="footer-btn save-btn" @onclick="SaveSettings">Save Changes</button>
    </div>
</div>

@if (showPasswordModal)
{
    <div class="modal-overlay" @onclick="ClosePasswordModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Change Password</h2>
                <button class="modal-close" @onclick="ClosePasswordModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-field">
                    <label>Current Password</label>
                    <input type="password" @bind="currentPassword" placeholder="Enter current password" />
                </div>
                <div class="form-field">
                    <label>New Password</label>
                    <input type="password" @bind="newPassword" placeholder="Enter new password" />
                </div>
                <div class="form-field">
                    <label>Confirm New Password</label>
                    <input type="password" @bind="confirmPassword" placeholder="Confirm new password" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="footer-btn cancel-btn" @onclick="ClosePasswordModal">Cancel</button>
                <button class="footer-btn save-btn" @onclick="UpdatePassword">Update Password</button>
            </div>
        </div>
    </div>
}

<style>
    .settings-page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: var(--bs-background);
    }

    .settings-tabs {
        display: flex;
        background-color: var(--bs-surface);
        border-bottom: 1px solid var(--bs-border);
        overflow-x: auto;
        flex-shrink: 0;
    }

    .settings-tabs button {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        padding: 0.75rem 1rem;
        min-width: 80px;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: var(--bs-text-subtle);
        cursor: pointer;
        transition: all 0.2s;
    }

    .settings-tabs button.active {
        color: var(--bs-primary);
        border-bottom-color: var(--bs-primary);
    }

    .settings-tabs button .material-symbols-outlined {
        font-size: 1.25rem;
    }

    .settings-tabs button span:last-child {
        font-size: 0.75rem;
        font-weight: 500;
    }

    .settings-content {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        padding-bottom: 5rem;
    }

    .settings-section {
        max-width: 600px;
        margin: 0 auto;
    }

    .settings-section h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--bs-text);
        margin: 0 0 0.5rem 0;
    }

    .section-description {
        color: var(--bs-text-subtle);
        font-size: 0.875rem;
        margin: 0 0 1.5rem 0;
    }

    .setting-group {
        margin-bottom: 2rem;
    }

    .setting-group h3 {
        font-size: 1rem;
        font-weight: 600;
        color: var(--bs-text);
        margin: 0 0 0.75rem 0;
    }

    .setting-group p {
        font-size: 0.875rem;
        color: var(--bs-text-subtle);
        margin: 0 0 0.75rem 0;
    }

    .theme-options {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
    }

    .theme-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem;
        background-color: var(--bs-surface);
        border: 2px solid var(--bs-border);
        border-radius: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
    }

    .theme-card.active {
        border-color: var(--bs-primary);
        background-color: var(--bs-primary-subtle);
    }

    .theme-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
    }

    .light-icon {
        background-color: #f8fafc;
        color: #1e293b;
    }

    .dark-icon {
        background-color: #1e293b;
        color: #f8fafc;
    }

    .auto-icon {
        background: linear-gradient(90deg, #f8fafc 50%, #1e293b 50%);
        color: var(--bs-primary);
    }

    .check-icon {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        color: var(--bs-primary);
        font-size: 1rem;
    }

    .toggle-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .toggle-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        background-color: var(--bs-surface);
        border-radius: 0.75rem;
        gap: 1rem;
    }

    .toggle-info {
        flex: 1;
    }

    .toggle-info label {
        display: block;
        font-weight: 500;
        color: var(--bs-text);
        margin-bottom: 0.25rem;
    }

    .toggle-info p {
        font-size: 0.8125rem;
        color: var(--bs-text-subtle);
        margin: 0;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 48px;
        height: 28px;
        flex-shrink: 0;
    }

    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--bs-gray-300);
        transition: .3s;
        border-radius: 28px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 20px;
        width: 20px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .3s;
        border-radius: 50%;
    }

    input:checked + .slider {
        background-color: var(--bs-primary);
    }

    input:checked + .slider:before {
        transform: translateX(20px);
    }

    .action-button {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        padding: 1rem;
        background-color: var(--bs-surface);
        border: 1px solid var(--bs-border);
        border-radius: 0.75rem;
        color: var(--bs-text);
        font-size: 0.9375rem;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .action-button:active {
        background-color: var(--bs-gray-100);
    }

    .account-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .account-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        background-color: var(--bs-surface);
        border-radius: 0.75rem;
    }

    .account-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .account-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bs-primary);
        color: white;
        border-radius: 50%;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .connect-btn {
        padding: 0.5rem 1rem;
        background-color: var(--bs-primary);
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
    }

    .form-field {
        margin-bottom: 1rem;
    }

    .form-field label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--bs-text-subtle);
        margin-bottom: 0.5rem;
    }

    .form-field select,
    .form-field input {
        width: 100%;
        padding: 0.75rem;
        background-color: var(--bs-surface);
        border: 1px solid var(--bs-border);
        border-radius: 0.5rem;
        font-size: 0.9375rem;
        color: var(--bs-text);
    }

    .storage-card {
        padding: 1rem;
        background-color: var(--bs-surface);
        border-radius: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .storage-bar {
        width: 100%;
        height: 6px;
        background-color: var(--bs-gray-200);
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 0.5rem;
    }

    .storage-used {
        height: 100%;
        background-color: var(--bs-primary);
    }

    .storage-card p {
        font-size: 0.8125rem;
        color: var(--bs-text-subtle);
        margin: 0;
    }

    .settings-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1rem;
        background-color: var(--bs-surface);
        border-top: 1px solid var(--bs-border);
        display: flex;
        gap: 0.75rem;
        z-index: 10;
    }

    .footer-btn {
        flex: 1;
        padding: 0.875rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.9375rem;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
    }

    .cancel-btn {
        background-color: var(--bs-surface);
        color: var(--bs-text);
        border: 1px solid var(--bs-border);
    }

    .cancel-btn:active {
        background-color: var(--bs-gray-100);
    }

    .save-btn {
        background-color: var(--bs-primary);
        color: white;
    }

    .save-btn:active {
        opacity: 0.8;
    }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
    }

    .modal {
        background-color: var(--bs-background);
        border-radius: 1rem;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
    }

    .modal-header {
        padding: 1.25rem;
        border-bottom: 1px solid var(--bs-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h2 {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--bs-text);
        margin: 0;
    }

    .modal-close {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        color: var(--bs-text-subtle);
        cursor: pointer;
        border-radius: 0.5rem;
    }

    .modal-close:active {
        background-color: var(--bs-gray-100);
    }

    .modal-body {
        padding: 1.25rem;
    }

    .modal-footer {
        padding: 1.25rem;
        border-top: 1px solid var(--bs-border);
        display: flex;
        gap: 0.75rem;
    }

    @@supports (padding-bottom: env(safe-area-inset-bottom)) {
        .settings-content {
            padding-bottom: calc(5rem + env(safe-area-inset-bottom));
        }

        .settings-footer {
            padding-bottom: calc(1rem + env(safe-area-inset-bottom));
        }
    }

    @@media (min-width: 768px) {
        .settings-tabs button {
            flex-direction: row;
            gap: 0.5rem;
            padding: 1rem 1.5rem;
        }

        .settings-tabs button span:last-child {
            font-size: 0.9375rem;
        }

        .theme-options {
            grid-template-columns: repeat(3, 1fr);
            max-width: 400px;
        }
    }
</style>

@code {
    private string activeTab = "appearance";

    private string theme = "light";

    private bool notifyNewCoffee = true;
    private bool notifyLowStock = true;
    private bool notifyInvitations = true;
    private bool notifyWeeklySummary = false;

    private string language = "en";
    private string timeZone = "UTC";
    private string dateFormat = "MM/DD/YYYY";

    private bool showPasswordModal = false;
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
    }

    private string GetTabClass(string tab)
    {
        return tab == activeTab ? "active" : "";
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private void SetTheme(string newTheme)
    {
        theme = newTheme;
    }

    private void ChangePassword()
    {
        showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
    }

    private async Task UpdatePassword()
    {
        if (newPassword == confirmPassword && !string.IsNullOrEmpty(newPassword))
        {
            ClosePasswordModal();
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }

    private async Task SaveSettings()
    {
        Navigation.NavigateTo("/");
    }
}
