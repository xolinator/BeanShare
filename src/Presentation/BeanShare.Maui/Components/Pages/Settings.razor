@page "/settings"
@using Microsoft.AspNetCore.Components.Authorization
@using BeanShare.SharedUi.Services
@using BeanShare.Maui.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IThemeService ThemeService
@inject IAlertService AlertService

<div class="settings-page">
    <div class="settings-tabs">
        <button class="@GetTabClass("appearance")" @onclick='() => SetActiveTab("appearance")'>
            <span class="material-symbols-outlined">palette</span>
            <span>Appearance</span>
        </button>
        <button class="@GetTabClass("privacy")" @onclick='() => SetActiveTab("privacy")'>
            <span class="material-symbols-outlined">lock</span>
            <span>Privacy</span>
        </button>
    </div>

    <div class="settings-content">
        @switch(activeTab)
        {
            case "appearance":
                <div class="settings-section">
                    <h2>Appearance</h2>
                    <p class="section-description">Customize how BeanShare looks and feels</p>

                    <div class="setting-group">
                        <h3>Theme</h3>
                        <div class="theme-options">
                            <label class="theme-card @(theme == "light" ? "active" : "")" @onclick='() => SetTheme("light")'>
                                <div class="theme-icon light-icon">
                                    <span class="material-symbols-outlined">light_mode</span>
                                </div>
                                <span>Light</span>
                                @if (theme == "light")
                                {
                                    <span class="material-symbols-outlined check-icon">check_circle</span>
                                }
                            </label>
                            <label class="theme-card @(theme == "dark" ? "active" : "")" @onclick='() => SetTheme("dark")'>
                                <div class="theme-icon dark-icon">
                                    <span class="material-symbols-outlined">dark_mode</span>
                                </div>
                                <span>Dark</span>
                                @if (theme == "dark")
                                {
                                    <span class="material-symbols-outlined check-icon">check_circle</span>
                                }
                            </label>
                            <label class="theme-card @(theme == "auto" ? "active" : "")" @onclick='() => SetTheme("auto")'>
                                <div class="theme-icon auto-icon">
                                    <span class="material-symbols-outlined">brightness_auto</span>
                                </div>
                                <span>Auto</span>
                                @if (theme == "auto")
                                {
                                    <span class="material-symbols-outlined check-icon">check_circle</span>
                                }
                            </label>
                        </div>
                    </div>
                </div>
                break;

            case "privacy":
                <div class="settings-section">
                    <h2>Privacy & Security</h2>
                    <p class="section-description">Manage your privacy settings and account security</p>

                    <div class="setting-group">
                        <h3>Password</h3>
                        <button class="action-button" @onclick="ChangePassword">
                            <span class="material-symbols-outlined">lock</span>
                            <span>Change Password</span>
                        </button>
                    </div>

                    <div class="setting-group">
                        <h3>Connected Accounts</h3>
                        <div class="account-list">
                            <div class="account-item">
                                <div class="account-info">
                                    <div class="account-icon" style="background: #4285f4;">G</div>
                                    <span>Google</span>
                                </div>
                                <span style="color: var(--bs-text-subtle); font-size: 0.8125rem;">Via Keycloak</span>
                            </div>
                        </div>
                    </div>
                </div>
                break;

        }
    </div>

    <div class="settings-footer">
        <button class="footer-btn cancel-btn" @onclick="Cancel">Cancel</button>
        <button class="footer-btn save-btn" @onclick="SaveSettings">Save Changes</button>
    </div>
</div>

@if (showPasswordModal)
{
    <div class="modal-overlay" @onclick="ClosePasswordModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Change Password</h2>
                <button class="modal-close" @onclick="ClosePasswordModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-field">
                    <label>Current Password</label>
                    <input type="password" @bind="currentPassword" placeholder="Enter current password" />
                </div>
                <div class="form-field">
                    <label>New Password</label>
                    <input type="password" @bind="newPassword" placeholder="Enter new password" />
                </div>
                <div class="form-field">
                    <label>Confirm New Password</label>
                    <input type="password" @bind="confirmPassword" placeholder="Confirm new password" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="footer-btn cancel-btn" @onclick="ClosePasswordModal">Cancel</button>
                <button class="footer-btn save-btn" @onclick="UpdatePassword">Update Password</button>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "appearance";

    private string theme = "light";

    private bool notifyNewCoffee = true;
    private bool notifyLowStock = true;
    private bool notifyInvitations = true;
    private bool notifyWeeklySummary = false;

    private string language = "en";
    private string timeZone = "UTC";
    private string dateFormat = "MM/DD/YYYY";

    private bool showPasswordModal = false;
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        theme = await ThemeService.GetThemeAsync();
    }

    private string GetTabClass(string tab)
    {
        return tab == activeTab ? "active" : "";
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task SetTheme(string newTheme)
    {
        theme = newTheme;
        await ThemeService.SetThemeAsync(newTheme);
    }

    private void ChangePassword()
    {
        showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
    }

    private async Task UpdatePassword()
    {
        if (string.IsNullOrEmpty(currentPassword) || string.IsNullOrEmpty(newPassword))
        {
            await AlertService.ShowAlertAsync("Error", "Please fill in all password fields.");
            return;
        }
        if (newPassword != confirmPassword)
        {
            await AlertService.ShowAlertAsync("Error", "New password and confirmation do not match.");
            return;
        }
        // Password management is handled by the identity provider
        await AlertService.ShowAlertAsync("Info", "Password changes are managed through your identity provider.");
        ClosePasswordModal();
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/");
    }

    private async Task SaveSettings()
    {
        // Theme is already saved via ThemeService.SetThemeAsync when selected.
        await ThemeService.SetThemeAsync(theme);
        Navigation.NavigateTo("/");
    }
}
