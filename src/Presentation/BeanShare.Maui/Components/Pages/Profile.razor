@code {
    private UserProfileDto? userProfile;
    private UserStatisticsDto? statistics;
    private List<SpaceSummaryDto> userSpaces = new();
#pragma warning disable CS0414 // Field is assigned but its value is never used
    private bool isLoading = true;
#pragma warning restore CS0414
    private bool isUploadingAvatar = false;
    private string? avatarUploadError;
    private string avatarCacheBuster = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        try
        {
            isLoading = true;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated == true)
            {
                userProfile = new UserProfileDto
                {
                    Name = user.Identity.Name ?? "Unknown User",
                    Email = user.FindFirst("email")?.Value ?? "",
                    JoinedDate = DateTime.UtcNow.AddMonths(-6), // Mock data
                    PictureUrl = null
                };

                var userId = UserContext.CurrentUserId;
                var query = new GetUserStatisticsQuery(userId);
                statistics = await Mediator.Send(query);

                var spacesQuery = new GetUserSpacesQuery();
                var spacesResult = await Mediator.Send(spacesQuery);
                if (spacesResult.IsSuccess)
                {
                    userSpaces = spacesResult.Value.Spaces.ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading profile");
            await AlertService.ShowAlertAsync("Error", "Failed to load profile data. Please try again.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToSpace(Guid spaceId)
    {
        Navigation.NavigateTo($"/spaces/{spaceId}");
    }

    private void NavigateToSpaces()
    {
        Navigation.NavigateTo("/spaces");
    }

    private string GetAvatarUrl()
    {
        if (string.IsNullOrEmpty(userProfile?.PictureUrl))
            return "";

        var baseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5247";
        var url = userProfile.PictureUrl.StartsWith("http")
            ? userProfile.PictureUrl
            : $"{baseUrl}{userProfile.PictureUrl}";

        if (!string.IsNullOrEmpty(avatarCacheBuster))
            url += $"?v={avatarCacheBuster}";

        return url;
    }

    private async Task HandleAvatarUpload()
    {
        try
        {
            avatarUploadError = null;
            isUploadingAvatar = true;
            StateHasChanged();

            // Use MAUI MediaPicker to select a photo
            var result = await MediaPicker.Default.PickPhotoAsync(new MediaPickerOptions
            {
                Title = "Select Avatar"
            });

            if (result == null)
            {
                isUploadingAvatar = false;
                StateHasChanged();
                return;
            }

            var extension = Path.GetExtension(result.FileName).ToLowerInvariant();
            var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
            if (!allowedExtensions.Contains(extension))
            {
                avatarUploadError = "Invalid format. Use jpg, png, gif, or webp.";
                isUploadingAvatar = false;
                StateHasChanged();
                return;
            }

            using var stream = await result.OpenReadAsync();
            if (stream.Length > 5 * 1024 * 1024)
            {
                avatarUploadError = "File size exceeds 5MB limit.";
                isUploadingAvatar = false;
                StateHasChanged();
                return;
            }

            using var content = new MultipartFormDataContent();
            var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var fileContent = new StreamContent(memoryStream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(GetContentType(extension));
            content.Add(fileContent, "file", result.FileName);

            var baseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5247";
            var response = await HttpClient.PostAsync($"{baseUrl}/api/me/avatar", content);

            if (response.IsSuccessStatusCode)
            {
                var uploadResponse = await response.Content.ReadFromJsonAsync<AvatarUploadResponse>();
                if (uploadResponse?.Success == true && uploadResponse.AvatarUrl != null)
                {
                    userProfile!.PictureUrl = uploadResponse.AvatarUrl;
                    avatarCacheBuster = DateTime.UtcNow.Ticks.ToString();

                    var updateCommand = new UpdateProfileCommand(userProfile.Name, uploadResponse.AvatarUrl);
                    await Mediator.Send(updateCommand);

                    await AlertService.ShowAlertAsync("Success", "Avatar updated successfully!");
                }
                else
                {
                    avatarUploadError = uploadResponse?.Error ?? "Upload failed";
                }
            }
            else
            {
                var errorResponse = await response.Content.ReadFromJsonAsync<AvatarUploadResponse>();
                avatarUploadError = errorResponse?.Error ?? "Failed to upload avatar";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading avatar");
            avatarUploadError = "Failed to upload avatar. Please try again.";
        }
        finally
        {
            isUploadingAvatar = false;
            StateHasChanged();
        }
    }

    private static string GetContentType(string extension) => extension switch
    {
        ".jpg" or ".jpeg" => "image/jpeg",
        ".png" => "image/png",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        _ => "application/octet-stream"
    };

    private sealed record AvatarUploadResponse(bool Success, string? AvatarUrl, string? Error);

    private class UserProfileDto
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public DateTime JoinedDate { get; set; }
        public string? PictureUrl { get; set; }
    }
}