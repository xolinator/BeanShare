@page "/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using BeanShare.Application.Features.Spaces.Dtos
@using BeanShare.Application.Features.Analytics.Queries.GetUserStatistics
@using System.Linq
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.Extensions.Logging
@using BeanShare.Maui.Services
@using Microsoft.Extensions.Configuration
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IAnalyticsService AnalyticsService
@inject ISpacesService SpacesService
@inject ILogger<Profile> Logger
@inject IAlertService AlertService
@inject HttpClient HttpClient
@inject IConfiguration Configuration

<div class="mobile-profile">
    @if (isLoading)
    {
        <div style="text-align: center; padding: 4rem 2rem;">
            <div class="spinner"></div>
            <p style="margin-top: 1rem;">Loading profile...</p>
        </div>
    }
    else
    {
    <div class="mobile-profile-header">
        <div class="profile-avatar-container">
            @if (!string.IsNullOrEmpty(userProfile?.PictureUrl))
            {
                <img src="@GetAvatarUrl()" alt="@userProfile.Name" class="profile-avatar" />
            }
            else
            {
                <div class="profile-avatar-placeholder">
                    <span class="material-symbols-outlined">account_circle</span>
                </div>
            }
            <button class="avatar-upload-btn" @onclick="HandleAvatarUpload" disabled="@isUploadingAvatar">
                <span class="material-symbols-outlined">@(isUploadingAvatar ? "sync" : "photo_camera")</span>
            </button>
        </div>
        @if (!string.IsNullOrEmpty(avatarUploadError))
        {
            <div class="avatar-upload-error">@avatarUploadError</div>
        }
        <h1 class="profile-name">@(userProfile?.Name ?? "Loading...")</h1>
        <p class="profile-email">@(userProfile?.Email ?? "")</p>
        <p class="profile-joined">Member since @(userProfile?.JoinedDate.ToString("MMMM yyyy") ?? "")</p>
    </div>

    <div class="mobile-stats-section">
        <h2>Coffee Statistics</h2>
        <div class="mobile-stats-grid">
            <div class="mobile-stat-card">
                <span class="material-symbols-outlined">local_cafe</span>
                <div class="stat-value">@(statistics?.TotalCups ?? 0)</div>
                <div class="stat-label">Total Cups</div>
            </div>
            <div class="mobile-stat-card">
                <span class="material-symbols-outlined">calendar_month</span>
                <div class="stat-value">@(statistics?.CupsThisMonth ?? 0)</div>
                <div class="stat-label">This Month</div>
            </div>
            <div class="mobile-stat-card">
                <span class="material-symbols-outlined">groups</span>
                <div class="stat-value">@(statistics?.ActiveSpacesCount ?? 0)</div>
                <div class="stat-label">Active Spaces</div>
            </div>
            <div class="mobile-stat-card">
                <span class="material-symbols-outlined">trending_up</span>
                <div class="stat-value">@(statistics?.AverageCupsPerDay.ToString("F1") ?? "0.0")</div>
                <div class="stat-label">Daily Average</div>
            </div>
        </div>

        @if (statistics?.CoffeeTypeBreakdown != null && statistics.CoffeeTypeBreakdown.Any())
        {
            <div class="coffee-types-section">
                <h3>Favorite Coffee Types</h3>
                <div class="coffee-types-list">
                    @foreach (var type in statistics.CoffeeTypeBreakdown.Take(5))
                    {
                        <div class="coffee-type-item">
                            <span class="coffee-type-name">@type.Key</span>
                            <span class="coffee-type-count">@type.Value cups</span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (statistics?.TotalCost != null)
        {
            <div class="cost-section">
                <h3>Total Cost</h3>
                <div class="total-cost-value">
                    @statistics.TotalCost.Currency.Symbol@statistics.TotalCost.Amount.ToString("F2")
                </div>
            </div>
        }
    </div>

    <div class="mobile-spaces-section">
        <div class="section-header">
            <h2>My Spaces</h2>
            <span class="badge">@userSpaces.Count</span>
        </div>
        @if (userSpaces.Any())
        {
            <div class="mobile-spaces-list">
                @foreach (var space in userSpaces)
                {
                    <div class="mobile-space-card" @onclick="() => NavigateToSpace(space.Id)">
                        <div class="space-info">
                            <h3>@space.Name</h3>
                            <p>@space.MemberCount members</p>
                        </div>
                        <span class="material-symbols-outlined">chevron_right</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>You haven't joined any spaces yet.</p>
                <button class="btn-primary" @onclick="NavigateToSpaces">
                    Browse Spaces
                </button>
            </div>
        }
    </div>
    }
</div>

@code {
    private UserProfileDto? userProfile;
    private UserStatisticsDto? statistics;
    private List<SpaceSummaryDto> userSpaces = new();
    private bool isLoading = true;
    private bool isUploadingAvatar = false;
    private string? avatarUploadError;
    private string avatarCacheBuster = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        try
        {
            isLoading = true;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated == true)
            {
                // Load statistics via API service (not MediatorStub)
                statistics = await AnalyticsService.GetMyStatisticsAsync();

                // Load spaces via API service
                userSpaces = await SpacesService.GetUserSpacesAsync() ?? new List<SpaceSummaryDto>();

                userProfile = new UserProfileDto
                {
                    Name = user.Identity.Name ?? "Unknown User",
                    Email = user.FindFirst("email")?.Value ?? "",
                    JoinedDate = statistics?.FirstConsumptionDate ?? DateTime.UtcNow,
                    PictureUrl = null
                };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading profile");
            await AlertService.ShowAlertAsync("Error", "Failed to load profile data. Please try again.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToSpace(Guid spaceId)
    {
        Navigation.NavigateTo($"/spaces/{spaceId}");
    }

    private void NavigateToSpaces()
    {
        Navigation.NavigateTo("/spaces");
    }

    private string GetAvatarUrl()
    {
        if (string.IsNullOrEmpty(userProfile?.PictureUrl))
            return "";

        var baseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5247";
        var url = userProfile.PictureUrl.StartsWith("http")
            ? userProfile.PictureUrl
            : $"{baseUrl}{userProfile.PictureUrl}";

        if (!string.IsNullOrEmpty(avatarCacheBuster))
            url += $"?v={avatarCacheBuster}";

        return url;
    }

    private async Task HandleAvatarUpload()
    {
        try
        {
            avatarUploadError = null;
            isUploadingAvatar = true;
            StateHasChanged();

            // Use MAUI MediaPicker to select a photo
            var results = await MediaPicker.Default.PickPhotosAsync(new MediaPickerOptions
            {
                Title = "Select Avatar"
            });
            var result = results.FirstOrDefault();

            if (result == null)
            {
                isUploadingAvatar = false;
                StateHasChanged();
                return;
            }

            var extension = Path.GetExtension(result.FileName).ToLowerInvariant();
            var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
            if (!allowedExtensions.Contains(extension))
            {
                avatarUploadError = "Invalid format. Use jpg, png, gif, or webp.";
                isUploadingAvatar = false;
                StateHasChanged();
                return;
            }

            using var stream = await result.OpenReadAsync();
            if (stream.Length > 5 * 1024 * 1024)
            {
                avatarUploadError = "File size exceeds 5MB limit.";
                isUploadingAvatar = false;
                StateHasChanged();
                return;
            }

            using var content = new MultipartFormDataContent();
            var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var fileContent = new StreamContent(memoryStream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(GetContentType(extension));
            content.Add(fileContent, "file", result.FileName);

            var baseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5247";
            var response = await HttpClient.PostAsync($"{baseUrl}/api/me/avatar", content);

            if (response.IsSuccessStatusCode)
            {
                var uploadResponse = await response.Content.ReadFromJsonAsync<AvatarUploadResponse>();
                if (uploadResponse?.Success == true && uploadResponse.AvatarUrl != null)
                {
                    userProfile!.PictureUrl = uploadResponse.AvatarUrl;
                    avatarCacheBuster = DateTime.UtcNow.Ticks.ToString();

                    // Update profile via API (not MediatorStub)
                    await HttpClient.PutAsJsonAsync($"{baseUrl}/api/me/profile",
                        new { Name = userProfile.Name, PictureUrl = uploadResponse.AvatarUrl });

                    await AlertService.ShowAlertAsync("Success", "Avatar updated successfully!");
                }
                else
                {
                    avatarUploadError = uploadResponse?.Error ?? "Upload failed";
                }
            }
            else
            {
                var errorResponse = await response.Content.ReadFromJsonAsync<AvatarUploadResponse>();
                avatarUploadError = errorResponse?.Error ?? "Failed to upload avatar";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error uploading avatar");
            avatarUploadError = "Failed to upload avatar. Please try again.";
        }
        finally
        {
            isUploadingAvatar = false;
            StateHasChanged();
        }
    }

    private static string GetContentType(string extension) => extension switch
    {
        ".jpg" or ".jpeg" => "image/jpeg",
        ".png" => "image/png",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        _ => "application/octet-stream"
    };

    private sealed record AvatarUploadResponse(bool Success, string? AvatarUrl, string? Error);

    private class UserProfileDto
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public DateTime JoinedDate { get; set; }
        public string? PictureUrl { get; set; }
    }
}