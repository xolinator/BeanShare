@page "/logout"
@inject NavigationManager Navigation
@inject IAuthenticationService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="logout-container">
    <div class="logout-content">
        <div class="logout-spinner"></div>
        <h2>Logging out...</h2>
        <p>Please wait while we securely log you out.</p>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await PerformLogout();
    }

    private async Task PerformLogout()
    {
        try
        {
            System.Diagnostics.Debug.WriteLine("[Logout] Starting logout process");

            var tcs = new TaskCompletionSource<bool>();
            MainThread.BeginInvokeOnMainThread(() =>
            {
                try
                {
                    SecureStorage.Default.RemoveAll();
                    System.Diagnostics.Debug.WriteLine("[Logout] SecureStorage cleared");
                    tcs.SetResult(true);
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"[Logout] Error clearing storage: {ex.Message}");
                    tcs.SetException(ex);
                }
            });
            await tcs.Task;

            await AuthService.LogoutAsync();
            System.Diagnostics.Debug.WriteLine("[Logout] Auth service logout completed");

            if (AuthStateProvider is MauiAuthenticationStateProvider mauiAuthProvider)
            {
                mauiAuthProvider.NotifyAuthenticationStateChanged();
                System.Diagnostics.Debug.WriteLine("[Logout] Auth state notified");
            }

            await Task.Delay(500);

            System.Diagnostics.Debug.WriteLine("[Logout] Navigating to login");
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Logout] Error during logout: {ex.Message}");
            Navigation.NavigateTo("/login");
        }
    }

    public void Dispose()
    {
        // Nothing to dispose
    }
}