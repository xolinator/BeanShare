@page "/dashboard"
@using BeanShare.Application.Features.Analytics.Queries.GetUserStatistics
@using System.Linq
@inject NavigationManager Navigation
@inject IAnalyticsService AnalyticsService

<div class="mobile-dashboard">
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading your dashboard...</p>
        </div>
    }
    else if (statistics == null)
    {
        <div class="empty-state">
            <span class="material-symbols-outlined">coffee</span>
            <h2>No Data Yet</h2>
            <p>Start tracking your coffee consumption!</p>
            <button class="btn-primary" @onclick="NavigateToSpaces">
                Join a Space
            </button>
        </div>
    }
    else
    {
        <!-- Mobile Header -->
        <div class="mobile-header">
            <h1>Dashboard</h1>
            <p class="subtitle">Your coffee insights</p>
        </div>

        <!-- KPI Cards - Mobile Optimized -->
        <div class="kpi-grid-mobile">
            <div class="kpi-card-mobile" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="kpi-content-mobile">
                    <span class="material-symbols-outlined">local_cafe</span>
                    <div class="kpi-value-mobile">@statistics.TotalCups</div>
                    <div class="kpi-label-mobile">Total Cups</div>
                </div>
            </div>

            <div class="kpi-card-mobile" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="kpi-content-mobile">
                    <span class="material-symbols-outlined">calendar_month</span>
                    <div class="kpi-value-mobile">@statistics.CupsThisMonth</div>
                    <div class="kpi-label-mobile">This Month</div>
                </div>
            </div>

            <div class="kpi-card-mobile" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="kpi-content-mobile">
                    <span class="material-symbols-outlined">trending_up</span>
                    <div class="kpi-value-mobile">@statistics.AverageCupsPerDay.ToString("F1")</div>
                    <div class="kpi-label-mobile">Daily Avg</div>
                </div>
            </div>

            <div class="kpi-card-mobile" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);" @onclick="ToggleCurrencyBreakdown">
                <div class="kpi-content-mobile">
                    <span class="material-symbols-outlined">payments</span>
                    <div class="kpi-value-mobile">@GetShortCost()</div>
                    <div class="kpi-label-mobile">
                        @if (!statistics.IsCostFullyConverted && statistics.CostBreakdown.Any())
                        {
                            <span style="font-size: 0.625rem;">Tap for details</span>
                        }
                        else
                        {
                            <span>Total Cost</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Currency Breakdown Modal -->
        @if (showCurrencyBreakdown && statistics.CostBreakdown.Any())
        {
            <div class="currency-overlay" @onclick="ToggleCurrencyBreakdown">
                <div class="currency-modal" @onclick:stopPropagation="true">
                    <div class="modal-header-mobile">
                        <h3>Cost Breakdown</h3>
                        <button class="close-btn-mobile" @onclick="ToggleCurrencyBreakdown">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                    <div class="modal-body-mobile">
                        @if (!statistics.IsCostFullyConverted)
                        {
                            <div class="warning-box">
                                <span class="material-symbols-outlined">warning</span>
                                <span>Some currencies could not be converted</span>
                            </div>
                        }
                        @foreach (var breakdown in statistics.CostBreakdown)
                        {
                            <div class="breakdown-row">
                                <div class="currency-badge">@breakdown.CurrencyCode</div>
                                <div class="amount-col">
                                    <div class="amount-original">@breakdown.OriginalAmount.ToString("N2")</div>
                                    @if (breakdown.WasConverted && breakdown.ConvertedAmount != null)
                                    {
                                        <div class="amount-converted">
                                            @breakdown.ConvertedAmount.Currency.FormatAmount(breakdown.ConvertedAmount.Amount)
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        @if (statistics.TotalCost != null)
                        {
                            <div class="total-box">
                                <span>Total:</span>
                                <span class="total-amount">@statistics.TotalCost.Currency.FormatAmount(statistics.TotalCost.Amount)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Today's Stats -->
        <div class="section-card">
            <h2>Today</h2>
            <div class="today-stats">
                <div class="today-stat-item">
                    <span class="material-symbols-outlined">today</span>
                    <div>
                        <div class="stat-value">@statistics.CupsToday</div>
                        <div class="stat-label">Cups Today</div>
                    </div>
                </div>
                <div class="today-stat-item">
                    <span class="material-symbols-outlined">calendar_today</span>
                    <div>
                        <div class="stat-value">@statistics.CupsThisWeek</div>
                        <div class="stat-label">This Week</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Favorite Coffee -->
        <div class="section-card">
            <h2>Favorite Coffee</h2>
            <div class="favorite-coffee">
                <div class="coffee-icon">
                    <span class="material-symbols-outlined">emoji_events</span>
                </div>
                <div class="coffee-info">
                    <div class="coffee-name">@(statistics.MostConsumedCoffeeType ?? "None yet")</div>
                    <div class="coffee-subtitle">Your most consumed</div>
                </div>
            </div>
        </div>

        <!-- Coffee Types Breakdown -->
        @if (statistics.CoffeeTypeBreakdown.Any())
        {
            <div class="section-card">
                <h2>Top Coffee Types</h2>
                <div class="coffee-types-mobile">
                    @{
                        var totalCups = statistics.CoffeeTypeBreakdown.Values.Sum();
                        var topTypes = statistics.CoffeeTypeBreakdown.Take(5);
                    }
                    @foreach (var (coffeeName, count) in topTypes)
                    {
                        var percentage = totalCups > 0 ? (count * 100.0 / totalCups) : 0;
                        <div class="coffee-type-mobile">
                            <div class="coffee-type-header">
                                <span class="coffee-name">@coffeeName</span>
                                <span class="coffee-count">@count</span>
                            </div>
                            <div class="coffee-bar">
                                <div class="coffee-fill" style="width: @(percentage)%"></div>
                            </div>
                            <div class="coffee-percentage">@percentage.ToString("F0")%</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Consumption Trend - Simplified for Mobile -->
        @if (statistics.DailyConsumptionTrend.Any())
        {
            <div class="section-card">
                <h2>Last 7 Days</h2>
                <div class="mini-chart">
                    @{
                        var last7Days = Enumerable.Range(0, 7)
                            .Select(i => DateTime.UtcNow.Date.AddDays(-6 + i))
                            .ToList();
                        var maxValue = last7Days
                            .Select(day => statistics.DailyConsumptionTrend.ContainsKey(day)
                                ? statistics.DailyConsumptionTrend[day]
                                : 0)
                            .Max();
                        maxValue = maxValue > 0 ? maxValue : 1;
                    }
                    @foreach (var day in last7Days)
                    {
                        var count = statistics.DailyConsumptionTrend.ContainsKey(day)
                            ? statistics.DailyConsumptionTrend[day]
                            : 0;
                        var height = (count * 100.0 / maxValue);
                        <div class="mini-bar-container">
                            <div class="mini-bar" style="height: @(height)%;">
                                @if (count > 0)
                                {
                                    <span class="mini-bar-value">@count</span>
                                }
                            </div>
                            <div class="mini-bar-label">@day.ToString("ddd")</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Quick Actions -->
        <div class="section-card">
            <h2>Quick Actions</h2>
            <div class="action-buttons-mobile">
                <button class="action-btn-mobile" @onclick="NavigateToSpaces">
                    <span class="material-symbols-outlined">groups</span>
                    <span>My Spaces</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private UserStatisticsDto? statistics;
    private bool isLoading = true;
    private bool showCurrencyBreakdown = false;

    private void ToggleCurrencyBreakdown()
    {
        if (statistics?.CostBreakdown.Any() == true)
        {
            showCurrencyBreakdown = !showCurrencyBreakdown;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        try
        {
            statistics = await AnalyticsService.GetMyStatisticsAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Dashboard] Error loading statistics: {ex.Message}");
            statistics = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetShortCost()
    {
        if (statistics?.TotalCost == null)
            return "N/A";

        var amount = statistics.TotalCost.Amount;
        var symbol = statistics.TotalCost.Currency.Symbol;

        if (amount >= 1000)
            return $"{symbol}{(amount / 1000):F1}k";

        return $"{symbol}{amount:F0}";
    }

    private void NavigateToSpaces()
    {
        Navigation.NavigateTo("/spaces");
    }
}
