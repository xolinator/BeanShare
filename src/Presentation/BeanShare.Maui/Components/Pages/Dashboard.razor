        flex: 1;
    }

    .coffee-name {
        font-size: 1.125rem;
        font-weight: 600;
        color: #78350f;
    }

    .coffee-subtitle {
        font-size: 0.75rem;
        color: #92400e;
        margin-top: 0.125rem;
    }

    .coffee-types-mobile {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .coffee-type-mobile {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .coffee-type-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .coffee-name {
        font-weight: 600;
        color: #1e293b;
        font-size: 0.875rem;
    }

    .coffee-count {
        font-weight: 600;
        color: #4169E1;
        font-size: 0.875rem;
    }

    .coffee-bar {
        height: 6px;
        background: #f1f5f9;
        border-radius: 3px;
