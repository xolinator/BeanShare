        height: 120px;
        gap: 4px;
        padding: 0.5rem 0;
    }

    .mini-bar-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
    }

    .mini-bar {
        width: 100%;
        background: linear-gradient(180deg, #4169E1 0%, #667eea 100%);
        border-radius: 4px 4px 0 0;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 2px;
        min-height: 4px;
    }

    .mini-bar-value {
        font-size: 0.625rem;
        font-weight: 600;
        color: white;
    }

    .mini-bar-label {
        font-size: 0.625rem;
        color: #64748b;
        margin-top: 4px;
        font-weight: 500;
    }

    .action-buttons-mobile {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .action-btn-mobile {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem;
        background: #4169E1;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .action-btn-mobile:active {
        background: #3058c7;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: #4169E1;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
    }

    .btn-primary:active {
        background: #3058c7;
    }
</style>

@code {
    private UserStatisticsDto? statistics;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        try
        {
            statistics = await AnalyticsService.GetMyStatisticsAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[Dashboard] Error loading statistics: {ex.Message}");
            statistics = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetShortCost()
    {
        if (statistics?.TotalCost == null)
            return "N/A";

        var amount = statistics.TotalCost.Amount;
        var symbol = statistics.TotalCost.Currency.Symbol;

        if (amount >= 1000)
            return $"{symbol}{(amount / 1000):F1}k";

        return $"{symbol}{amount:F0}";
    }

    private void NavigateToSpaces()
    {
        Navigation.NavigateTo("/spaces");
    }
}
