@page "/spaces/{SpaceId}/consumption"
@using BeanShare.SharedUi.Components.Consumption.Models
@using BeanShare.Application.Features.CoffeeStock.Dtos
@using BeanShare.Application.Features.Presets.Queries
@using BeanShare.Application.Abstractions
@using BeanShare.Maui.Services
@inject ISpacesService SpacesService
@inject IConsumptionService ConsumptionService
@inject IStockService StockService
@inject IPresetService PresetService
@inject IUserContext UserContext
@inject NavigationManager Navigation
@inject IAlertService AlertService

<PageTitle>Consumption - @spaceName - BeanShare</PageTitle>

@if (!hasSpace || space == null)
{
    <div class="bs-container" style="padding-top: 4rem; text-align: center;">
        <div class="bs-skeleton" style="width: 12rem; height: 2rem; margin: 0 auto 1rem;"></div>
        <div class="bs-skeleton" style="width: 20rem; height: 1rem; margin: 0 auto;"></div>
    </div>
}
else
{
    <div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
        <div class="bs-container">
            <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
                <button class="bs-btn-sm" style="background: transparent; border: none; cursor: pointer;" @onclick='@(() => Navigation.NavigateTo("/spaces"))'>
                    <span class="material-symbols-outlined">arrow_back</span>
                </button>
                <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">@space.Name</h1>
                <div style="width: 2rem;"></div>
            </div>

            <div style="background: var(--bs-gray-100); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 1rem;">
                <div class="bs-flex bs-items-center bs-justify-between">
                    <span class="bs-text-subtle" style="font-size: 0.75rem; font-weight: 600;">INVITE CODE</span>
                    <div class="bs-flex bs-items-center bs-gap-2">
                        <span style="font-family: monospace; font-size: 0.875rem; font-weight: 700;">@space.InviteCode</span>
                        <button class="bs-btn-sm" style="background: var(--bs-primary-light); color: var(--bs-primary); border: none; padding: 0.25rem 0.5rem;" title="Copy invite code" @onclick="CopyInviteCode">
                            <span class="material-symbols-outlined" style="font-size: 1rem;">content_copy</span>
                        </button>
                    </div>
                </div>
            </div>

            <SpaceTabs SpaceId="@SpaceId"
                      ActiveTab="consumption"
                      OnTabChange="HandleTabChange"
                      PreventNavigation="false" />
        </div>
    </div>

    <div class="bs-container" style="padding: 2rem 0;">
        <div class="bs-flex bs-flex-col bs-gap-6">
            <ConsumptionKpis MyCupsToday="@myCupsToday"
                            MyTotalCost="@myTotalCost"
                            RemainingStockGrams="@remainingStock"
                            CurrencyCode="@(space?.CurrencyCode ?? "USD")" />

            <ConsumptionForm OnSubmit="HandleLogConsumption"
                           StockProducts="@stockProducts"
                           PresetData="@presetData"
                           QuickPresets="@quickPresets"
                           SpaceMembers="@space?.Members?.ToList()"
                           CurrentUserId="@UserContext.CurrentUserId.Value" />

            <RecentConsumptionList RecentLogs="@recentConsumptions"
                                  IsLoading="@isLoadingConsumption" />
        </div>
    </div>
}

<Toast IsVisible="@showToast"
       IsError="@isToastError"
       Title="@toastTitle"
       Message="@toastMessage"
       OnClose="@(() => showToast = false)" />

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private SpaceDto? space;
    private string spaceName => space?.Name ?? "Loading...";
    private bool hasSpace => !string.IsNullOrEmpty(SpaceId) && space != null;
    private bool isLoadingConsumption;

    private List<ConsumptionEntryDto> recentConsumptions = new();
    private List<StockLevelDto> stockProducts = new();
    private List<PresetOption> quickPresets = new();
    private int myCupsToday = 0;
    private decimal myTotalCost = 0m;
    private int remainingStock = 0;
    private PresetDto? presetData;

    private bool showToast;
    private bool isToastError;
    private string toastTitle = "";
    private string toastMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(SpaceId))
        {
            if (!Guid.TryParse(SpaceId, out var spaceGuid))
            {
                Navigation.NavigateTo("/spaces");
                return;
            }
            await LoadSpace();
            await LoadStock();
            await LoadConsumption();
            await LoadQuickPresets();
            await LoadPresetIfProvided();
        }
    }

    private async Task LoadPresetIfProvided()
    {
        var uri = Navigation.Uri;
        if (uri.Contains("presetId="))
        {
            var index = uri.IndexOf("presetId=") + 9;
            var endIndex = uri.IndexOf('&', index);
            var presetIdString = endIndex == -1 ? uri.Substring(index) : uri.Substring(index, endIndex - index);

            if (Guid.TryParse(presetIdString, out var presetGuid))
            {
                try
                {
                    var contractsPreset = await PresetService.GetPresetByIdAsync(presetGuid);
                    if (contractsPreset != null)
                    {
                        presetData = new PresetDto(
                            contractsPreset.Id,
                            contractsPreset.UserId,
                            contractsPreset.UserName,
                            contractsPreset.Name,
                            contractsPreset.CoffeeType,
                            contractsPreset.Preparation,
                            contractsPreset.DefaultGrams,
                            contractsPreset.Notes,
                            contractsPreset.IsShared,
                            contractsPreset.IsOwner,
                            contractsPreset.CreatedAt,
                            contractsPreset.LastUsedAt,
                            contractsPreset.UsageCount);
                    }
                }
                catch (Exception ex)
                {
                    ShowToast(true, "Error", $"Failed to load preset: {ex.Message}");
                }
            }
        }
    }

    private async Task LoadSpace()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        try
        {
            space = await SpacesService.GetSpaceByIdAsync(spaceGuid);
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load space: {ex.Message}");
        }
    }

    private async Task LoadConsumption()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        isLoadingConsumption = true;
        StateHasChanged();

        try
        {
            var consumptionData = await ConsumptionService.GetRecentConsumptionsAsync(spaceGuid);
            if (consumptionData != null)
            {
                recentConsumptions = consumptionData.Entries.ToList();
                myCupsToday = consumptionData.MyCupsToday;
                myTotalCost = consumptionData.MyTotalCost;
                remainingStock = consumptionData.RemainingStockGrams;
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load consumption: {ex.Message}");
        }
        finally
        {
            isLoadingConsumption = false;
            StateHasChanged();
        }
    }

    private async Task LoadStock()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            Navigation.NavigateTo("/spaces");
            return;
        }

        try
        {
            var stockData = await StockService.GetSpaceStockAsync(spaceGuid);
            if (stockData != null && stockData.StockLevels != null)
            {
                stockProducts = stockData.StockLevels.ToList();
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load stock: {ex.Message}");
        }
    }

    private async Task LoadQuickPresets()
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            return;
        }

        try
        {
            quickPresets = await PresetService.GetQuickPresetsAsync(spaceGuid);
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to load presets: {ex.Message}");
        }
    }

    private async Task HandleTabChange(string newTab)
    {
        if (newTab == "members")
        {
            Navigation.NavigateTo($"/spaces/{SpaceId}");
        }
        else if (newTab == "stock")
        {
            Navigation.NavigateTo($"/spaces/{SpaceId}/stock");
        }
    }

    private async Task HandleLogConsumption(ConsumptionFormModel model)
    {
        if (!Guid.TryParse(SpaceId, out var spaceGuid))
        {
            ShowToast(true, "Error", "Invalid space ID");
            return;
        }

        try
        {
            var consumedAtUtc = model.ConsumedAt.ToUniversalTime();

            var targetUserIds = new List<Guid?>();
            if (model.ForUserIds != null && model.ForUserIds.Count > 0)
            {
                targetUserIds.AddRange(model.ForUserIds.Select(id => (Guid?)id));
            }
            else
            {
                targetUserIds.Add(null); // null = myself
            }

            var successCount = 0;
            foreach (var targetUserId in targetUserIds)
            {
                var success = await ConsumptionService.RecordConsumptionAsync(
                    spaceGuid,
                    model.ProductName ?? "Coffee",
                    model.ProductBrand ?? "Generic",
                    model.ProductType ?? "Ground",
                    model.Grams,
                    consumedAtUtc,
                    model.PresetName,
                    targetUserId
                );
                if (success) successCount++;
            }

            if (successCount > 0)
            {
                var msg = successCount == 1
                    ? "Consumption logged successfully!"
                    : $"Logged consumption for {successCount} members!";
                ShowToast(false, "Success", msg);
                await LoadConsumption();
                await LoadStock();
                StateHasChanged();
            }
            else
            {
                ShowToast(true, "Error", "Failed to log consumption. Please try again.");
            }
        }
        catch (Exception ex)
        {
            ShowToast(true, "Error", $"Failed to log consumption: {ex.Message}");
        }
    }

    private async Task CopyInviteCode()
    {
        if (space?.InviteCode != null)
        {
            await Clipboard.Default.SetTextAsync(space.InviteCode);
            await AlertService.ShowAlertAsync("Copied", "Invite code copied to clipboard!");
        }
    }

    private void ShowToast(bool isError, string title, string message)
    {
        isToastError = isError;
        toastTitle = title;
        toastMessage = message;
        showToast = true;
    }
}