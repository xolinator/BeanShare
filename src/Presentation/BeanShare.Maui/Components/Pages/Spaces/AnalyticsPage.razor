@page "/spaces/{SpaceId}/analytics"
@using BeanShare.Application.Features.Analytics.Queries.GetSpaceAnalytics
@using BeanShare.SharedUi.Components.Analytics
@using BeanShare.Maui.Services
@inject IAnalyticsService AnalyticsService
@inject NavigationManager Navigation
@inject IAlertService AlertService

<PageTitle>Analytics - BeanShare</PageTitle>

<div style="position: sticky; top: 0; z-index: 10; background: var(--bs-background-light); border-bottom: 1px solid var(--bs-border); padding: 1rem 0;">
    <div class="bs-container">
        <div class="bs-flex bs-items-center bs-justify-between" style="margin-bottom: 1rem;">
            <button class="bs-btn-sm" style="background: transparent; border: none; cursor: pointer;" @onclick='@(() => Navigation.NavigateTo($"/spaces/{SpaceId}"))'>
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <h1 class="bs-font-bold" style="margin: 0; font-size: 1.25rem;">Analytics</h1>
            <div style="width: 2rem;"></div>
        </div>
    </div>
</div>

<div class="bs-container" style="padding: 2rem 0;">
    <SpaceAnalytics Analytics="@spaceAnalytics"
                   IsLoading="@isLoading" />
</div>

@code {
    [Parameter]
    public string SpaceId { get; set; } = "";

    private SpaceAnalyticsDto? spaceAnalytics;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(SpaceId))
        {
            await LoadAnalytics();
        }
    }

    private async Task LoadAnalytics()
    {
        isLoading = true;
        try
        {
            spaceAnalytics = await AnalyticsService.GetSpaceAnalyticsAsync(
                Guid.Parse(SpaceId),
                DateTime.UtcNow.AddDays(-30),
                DateTime.UtcNow
            );
        }
        catch (Exception ex)
        {
            await AlertService.ShowAlertAsync("Error", $"Failed to load analytics: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
