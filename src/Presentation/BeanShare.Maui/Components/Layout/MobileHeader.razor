@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<header class="mobile-header">
    <div class="header-content">
        @if (ShowBackButton)
        {
            <button class="header-back-btn" @onclick="NavigateBack">
                <span class="material-symbols-outlined">arrow_back</span>
            </button>
        }
        else
        {
            <div class="header-logo">
                <img src="_content/BeanShare.SharedUi/images/logo.svg" alt="BeanShare" class="header-logo-img" />
            </div>
        }

        <div class="header-title-section">
            <h1 class="header-title">@Title</h1>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="header-subtitle">@Subtitle</p>
            }
        </div>

        <div class="header-actions">
            @if (ShowSearch)
            {
                <button class="header-action-btn" @onclick="ToggleSearch">
                    <span class="material-symbols-outlined">search</span>
                </button>
            }

            @if (ShowNotifications)
            {
                <button class="header-action-btn" @onclick="ShowNotificationPanel">
                    <span class="material-symbols-outlined">notifications</span>
                    @if (unreadCount > 0)
                    {
                        <span class="notification-dot"></span>
                    }
                </button>
            }

            @if (ShowMenu)
            {
                <button class="header-action-btn" @onclick="ToggleMenu">
                    <span class="material-symbols-outlined">more_vert</span>
                </button>
            }
        </div>
    </div>

    @if (isSearchOpen)
    {
        <div class="header-search-bar">
            <div class="search-container">
                <span class="material-symbols-outlined search-icon">search</span>
                <input type="text"
                       class="search-input"
                       placeholder="Search..."
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeyup="@(async (e) => { if (e.Key == "Enter") await PerformSearch(); })"
                       autofocus />
                <button class="search-close-btn" @onclick="CloseSearch">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
        </div>
    }
</header>

@if (isMenuOpen)
{
    <div class="menu-backdrop" @onclick="CloseMenu">
        <div class="menu-dropdown" @onclick:stopPropagation="true">
            @if (MenuItems != null)
            {
                @foreach (var item in MenuItems)
                {
                    <button class="menu-item" @onclick="() => OnMenuItemClick(item)">
                        @if (!string.IsNullOrEmpty(item.Icon))
                        {
                            <span class="material-symbols-outlined">@item.Icon</span>
                        }
                        <span>@item.Text</span>
                    </button>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "BeanShare";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool ShowBackButton { get; set; }
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public bool ShowNotifications { get; set; } = true;
    [Parameter] public bool ShowMenu { get; set; } = true;
    [Parameter] public List<MenuItem>? MenuItems { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private bool isSearchOpen = false;
    private bool isMenuOpen = false;
    private string searchQuery = "";
    private int unreadCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            unreadCount = 3;
        }

        if (MenuItems == null)
        {
            MenuItems = new List<MenuItem>
            {
                new MenuItem { Icon = "settings", Text = "Settings", Action = "settings" },
                new MenuItem { Icon = "help", Text = "Help", Action = "help" },
                new MenuItem { Icon = "logout", Text = "Logout", Action = "logout" }
            };
        }
    }

    private void ToggleSearch()
    {
        isSearchOpen = !isSearchOpen;
        if (!isSearchOpen)
        {
            searchQuery = "";
        }
    }

    private void CloseSearch()
    {
        isSearchOpen = false;
        searchQuery = "";
    }

    private async Task PerformSearch()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            if (OnSearch.HasDelegate)
            {
                await OnSearch.InvokeAsync(searchQuery);
            }
            CloseSearch();
        }
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void CloseMenu()
    {
        isMenuOpen = false;
    }

    private void ShowNotificationPanel()
    {
        Navigation.NavigateTo("/notifications");
    }

    private async Task NavigateBack()
    {
        if (OnBack.HasDelegate)
        {
            await OnBack.InvokeAsync();
        }
    }

    private void OnMenuItemClick(MenuItem item)
    {
        isMenuOpen = false;

        switch (item.Action?.ToLower())
        {
            case "settings":
                Navigation.NavigateTo("/settings");
                break;
            case "help":
                Navigation.NavigateTo("/help");
                break;
            case "logout":
                Navigation.NavigateTo("/logout");
                break;
            default:
                if (!string.IsNullOrEmpty(item.Url))
                {
                    Navigation.NavigateTo(item.Url);
                }
                break;
        }
    }

    public class MenuItem
    {
        public string? Icon { get; set; }
        public string Text { get; set; } = "";
        public string? Action { get; set; }
        public string? Url { get; set; }
    }
}