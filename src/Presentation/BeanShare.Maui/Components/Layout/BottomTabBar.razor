@inject NavigationManager Navigation
@implements IDisposable

<div class="bottom-tab-bar">
    <button class="@GetTabClass("dashboard")" @onclick='() => NavigateToTab("/dashboard")'>
        <span class="material-symbols-outlined">dashboard</span>
        <span class="tab-label">Dashboard</span>
    </button>

    <button class="@GetTabClass("spaces")" @onclick='() => NavigateToTab("/spaces")'>
        <span class="material-symbols-outlined">groups</span>
        <span class="tab-label">Spaces</span>
    </button>

    <button class="tab-fab" @onclick="ShowActionMenu">
        <span class="material-symbols-outlined">add</span>
    </button>

    <button class="@GetTabClass("history")" @onclick='() => NavigateToTab("/history")'>
        <span class="material-symbols-outlined">history</span>
        <span class="tab-label">History</span>
    </button>

    <button class="@GetTabClass("profile")" @onclick='() => NavigateToTab("/profile")'>
        <span class="material-symbols-outlined">person</span>
        <span class="tab-label">Profile</span>
    </button>
</div>

@if (showActionMenu)
{
    <div class="action-menu-backdrop" @onclick="CloseActionMenu">
        <div class="action-menu" @onclick:stopPropagation="true">
            <button class="action-menu-item" @onclick="CreateSpace">
                <span class="material-symbols-outlined">add_circle</span>
                <span>Create Space</span>
            </button>
            <button class="action-menu-item" @onclick="JoinSpace">
                <span class="material-symbols-outlined">group_add</span>
                <span>Join Space</span>
            </button>
            @if (!string.IsNullOrEmpty(CurrentSpaceId))
            {
                <button class="action-menu-item" @onclick="LogConsumption">
                    <span class="material-symbols-outlined">coffee</span>
                    <span>Log Coffee</span>
                </button>
                <button class="action-menu-item" @onclick="AddStock">
                    <span class="material-symbols-outlined">add_shopping_cart</span>
                    <span>Add Stock</span>
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string? CurrentSpaceId { get; set; }
    [Parameter] public EventCallback OnCreateSpace { get; set; }
    [Parameter] public EventCallback OnJoinSpace { get; set; }
    [Parameter] public EventCallback OnLogConsumption { get; set; }
    [Parameter] public EventCallback OnAddStock { get; set; }

    private bool showActionMenu = false;
    private string currentPath = "";

    protected override void OnInitialized()
    {
        currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        StateHasChanged();
    }

    private string GetTabClass(string tabName)
    {
        var isActive = tabName switch
        {
            "dashboard" => currentPath == "dashboard" || currentPath == "",
            "spaces" => currentPath == "spaces",
            "stock" => currentPath.Contains("/stock"),
            "consumption" => currentPath.Contains("/consumption"),
            "history" => currentPath.StartsWith("history"),
            "profile" => currentPath.StartsWith("profile"),
            _ => false
        };

        return isActive ? "active" : "";
    }

    private void NavigateToTab(string path)
    {
        Navigation.NavigateTo(path);
        showActionMenu = false;
    }

    private void ShowActionMenu()
    {
        showActionMenu = !showActionMenu;
    }

    private void CloseActionMenu()
    {
        showActionMenu = false;
    }

    private async Task CreateSpace()
    {
        showActionMenu = false;
        if (OnCreateSpace.HasDelegate)
        {
            await OnCreateSpace.InvokeAsync();
        }
    }

    private async Task JoinSpace()
    {
        showActionMenu = false;
        if (OnJoinSpace.HasDelegate)
        {
            await OnJoinSpace.InvokeAsync();
        }
    }

    private async Task LogConsumption()
    {
        showActionMenu = false;
        if (OnLogConsumption.HasDelegate)
        {
            await OnLogConsumption.InvokeAsync();
        }
        else
        {
            if (!string.IsNullOrEmpty(CurrentSpaceId))
            {
                Navigation.NavigateTo($"/spaces/{CurrentSpaceId}/consumption");
            }
            else
            {
                Navigation.NavigateTo("/spaces");
            }
        }
    }

    private async Task AddStock()
    {
        showActionMenu = false;
        if (OnAddStock.HasDelegate)
        {
            await OnAddStock.InvokeAsync();
        }
        else
        {
            if (!string.IsNullOrEmpty(CurrentSpaceId))
            {
                Navigation.NavigateTo($"/spaces/{CurrentSpaceId}/stock");
            }
            else
            {
                Navigation.NavigateTo("/spaces");
            }
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}