# BeanShare Production Environment Variables Template
# Copy this file to .env and fill in the values
# NEVER commit .env file to version control

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
CONNECTIONSTRINGS__DEFAULTCONNECTION="Host=your-db-host;Port=5432;Database=beanshare_prod;Username=beanshare;Password=your-secure-password"

# ===========================================
# KEYCLOAK CONFIGURATION (REQUIRED)
# ===========================================
KEYCLOAK__AUTHORITY="https://auth.beanshare.app/realms/beanshare"
KEYCLOAK__CLIENTSECRET="your-keycloak-client-secret-here"

# ===========================================
# JWT CONFIGURATION (REQUIRED)
# ===========================================
# Generate a secure random secret (at least 32 characters)
JWT__SECRET="your-very-long-and-secure-jwt-secret-key-here-at-least-32-characters"

# ===========================================
# OPEN EXCHANGE RATES (REQUIRED FOR CURRENCY CONVERSION)
# ===========================================
# Get your free API key from: https://openexchangerates.org/signup/free
# Free tier: 1,000 requests/month, 170+ currencies
OPENEXCHANGERATES__APPID="your-openexchangerates-api-key-here"

# ===========================================
# EMAIL SERVICE (OPTIONAL)
# ===========================================
# Required for settlement notifications and user communications
# Leave empty to disable email functionality
EMAIL__SMTPUSERNAME="your-email@gmail.com"
EMAIL__SMTPPASSWORD="your-app-specific-password"

# ===========================================
# OAUTH PROVIDERS (OPTIONAL)
# ===========================================
# Google OAuth
AUTHENTICATION__GOOGLE__CLIENTID="your-google-client-id.apps.googleusercontent.com"
AUTHENTICATION__GOOGLE__CLIENTSECRET="your-google-client-secret"

# Facebook OAuth
AUTHENTICATION__FACEBOOK__APPID="your-facebook-app-id"
AUTHENTICATION__FACEBOOK__APPSECRET="your-facebook-app-secret"

# ===========================================
# MAUI MOBILE APP CONFIGURATION
# ===========================================
APIBASEURL="https://api.beanshare.app"

# ===========================================
# ALLOWED HOSTS (SECURITY)
# ===========================================
# Comma-separated list of allowed host headers
ALLOWEDHOSTS="beanshare.app,*.beanshare.app"

# ===========================================
# NOTES
# ===========================================
# Required Settings:
# - ConnectionStrings__DefaultConnection
# - Keycloak__Authority
# - Keycloak__ClientSecret
# - JWT__Secret
# - OpenExchangeRates__AppId
#
# Optional Settings (app will work without these, but features disabled):
# - Email__SmtpUsername / Email__SmtpPassword
# - OAuth provider credentials
